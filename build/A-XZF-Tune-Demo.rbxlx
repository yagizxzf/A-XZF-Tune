      <Item class="ModuleScript" referent="AXZF64">
        <Properties>
          <string name="Name">Rig_Test</string>
          <ProtectedString name="Source">--!strict
return function(t)
	local Doctor=require(game.ServerScriptService.AXZFServer.Doctor)
	local Car=require(game.ServerStorage.AXZFExamples.PrototypeCar) local e=t.expect
	local function withCar(fn) local m=Car.create() local ok,err=pcall(fn,m) m:Destroy() if not ok then error(err) end end
	-- Doctor must explain structural errors before any binding mutation.
	t.test("part-built reference rig accepted",function() withCar(function(m) e.truthy(Doctor.inspect(m).ok) end) end)
	t.test("missing mount rejected",function() withCar(function(m) m.Chassis.FL:Destroy() e.falsy(Doctor.inspect(m).ok) end) end)
	t.test("old chassis script rejected",function() withCar(function(m) Instance.new("Script",m) e.falsy(Doctor.inspect(m).ok) end) end)
	t.test("old constraints rejected",function() withCar(function(m) Instance.new("WeldConstraint",m.Chassis) e.falsy(Doctor.inspect(m).ok) end) end)
	t.test("wheel without hub rejected",function() withCar(function(m) m.Wheels.FL.PrimaryPart=nil e.falsy(Doctor.inspect(m).ok) end) end)
	t.test("swapped left/right layout rejected",function() withCar(function(m) m.Chassis.FL.Position=m.Chassis.FR.Position e.falsy(Doctor.inspect(m).ok) end) end)
	t.test("inspection does not mutate anchored state",function() withCar(function(m) Doctor.inspect(m) e.truthy(m.Chassis.Anchored) end) end)
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF65">
        <Properties>
          <string name="Name">RollTest</string>
          <ProtectedString name="Source">--!strict
-- Identical occupied-mass, 55 stud/s left/right turn trials before/after changes.
return function(source: Model, overrides: any): any
	local Run=game:GetService("RunService")
	assert(Run:IsStudio() and Run:IsServer(),"Studio server only")
	local floor=Instance.new("Part") floor.Name="__AXZF_RollFloor" floor.Anchored=true
	floor.Size=Vector3.new(1000,1,1000) floor.Position=Vector3.new(1200,0,-500) floor.Parent=workspace
	local m=source:Clone() game:GetService("CollectionService"):RemoveTag(m,"AXZFVehicle")
	m.Name="__AXZF_RollTest" m.DriveSeat.Disabled=true m:PivotTo(CFrame.new(1200,6,-300)) m.Parent=workspace
	local v=nil local connection=nil local result={trials={}}
	local ok,err=xpcall(function()
		v=require(game.ServerScriptService.AXZFServer.Vehicle).new(m,overrides)
		-- Deterministic seated-rider surrogate; same 24 mass and seat position in both versions.
		local rider=Instance.new("Part") rider.Name="RiderMass" rider.Size=Vector3.new(2,3,2)
		rider.Transparency=1 rider.CanCollide=false rider.CFrame=m.DriveSeat.CFrame*CFrame.new(0,1,0)
		rider.CustomPhysicalProperties=PhysicalProperties.new(2,0,0) rider.Parent=m
		local weld=Instance.new("WeldConstraint") weld.Part0=m.Chassis weld.Part1=rider weld.Parent=rider
		connection=Run.PreSimulation:Connect(function(dt) v:step(dt) end)
		local root=m.Chassis
		for _,trial in ipairs({{55,-1},{55,1},{90,-1},{90,1}}) do
			local entrySpeed,direction=trial[1],trial[2]
			m:PivotTo(CFrame.new(1200,6,-300)) root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
			local start=os.clock() repeat v:setInput({throttle=0,steer=0,brake=1,handbrake=false}) task.wait(.05) until os.clock()-start&gt;2
			root.AssemblyLinearVelocity=root.CFrame.LookVector*entrySpeed
			local forward=root.CFrame.LookVector local maxRoll,maxSpeed,samples=0,0,0 start=os.clock()
			repeat
				v:setInput({throttle=.35,steer=.65*direction,brake=0,handbrake=false})
				Run.PostSimulation:Wait() samples+=1
				maxRoll=math.max(maxRoll,math.deg(math.abs(math.atan2(root.CFrame.RightVector.Y,root.CFrame.UpVector.Y))))
				maxSpeed=math.max(maxSpeed,root.AssemblyLinearVelocity.Magnitude)
			until os.clock()-start&gt;2.5
			local yaw=math.deg(math.acos(math.clamp(forward:Dot(root.CFrame.LookVector),-1,1)))
			table.insert(result.trials,{entrySpeed=entrySpeed,direction=direction,maxRollDegrees=maxRoll,maxSpeed=maxSpeed,yawDegrees=yaw,samples=samples,pass=maxRoll&lt;12 and yaw&gt;5 and root.CFrame.UpVector.Y&gt;.9})
		end
		result.pass=true for _,trial in ipairs(result.trials) do if not trial.pass then result.pass=false end end
	end,debug.traceback)
	if connection then connection:Disconnect() end if v then v:destroy() end m:Destroy() floor:Destroy()
	if not ok then result.pass=false result.error=tostring(err) end
	return result
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF66">
        <Properties>
          <string name="Name">RunUnitTest</string>
          <ProtectedString name="Source">--!strict
-- Minimal synchronous built-in harness. Unit cases must not yield or access services with side effects.
return function(filter: string?): any
	local totals={run=0,passed=0,failed=0,cases={}}
	local expect={}
	function expect.equal(a,b) assert(a==b,"expected "..tostring(b)..", got "..tostring(a)) end
	function expect.truthy(v) assert(v,"expected truthy") end
	function expect.falsy(v) assert(not v,"expected falsy") end
	function expect.near(a,b,t) assert(a==a and math.abs(a-b)&lt;=(t or 1e-6),"expected "..tostring(b)..", got "..tostring(a)) end
	function expect.throws(fn) local ok=pcall(fn) assert(not ok,"expected error") end
	local context={expect=expect}
	function context.test(name,fn)
		totals.run+=1 local ok,err=pcall(fn)
		table.insert(totals.cases,{name=name,pass=ok,error=if ok then nil else tostring(err)})
		if ok then totals.passed+=1 else totals.failed+=1 warn("[AXZF FAIL] "..name..": "..tostring(err)) end
	end
	for _,m in ipairs(script.Parent:GetChildren()) do
		if m:IsA("ModuleScript") and string.sub(m.Name,-5)=="_Test" and (not filter or string.find(m.Name,filter,1,true)) then
			local ok,err=pcall(function() require(m)(context) end)
			if not ok then context.test(m.Name.." load",function() error(err) end) end
		end
	end
	print(string.format("[AXZF UNIT] %d run / %d passed / %d failed",totals.run,totals.passed,totals.failed))
	return totals
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF67">
        <Properties>
          <string name="Name">Stability_Test</string>
          <ProtectedString name="Source">--!strict
return function(t)
	local S=require(game.ReplicatedStorage.AXZF.Shared.Stability) local e=t.expect
	t.test("antiroll preserves total axle load",function() local l,r=S.axle(100,100,.2,100,.5,400) e.near(l+r,200) e.truthy(l&gt;100 and r&lt;100) end)
	t.test("antiroll cannot pull wheel into ground",function() local l,r=S.axle(100,5,100,100,2,400) e.near(l,105) e.near(r,0) end)
	t.test("antiroll cannot exceed load cap",function() local l,r=S.axle(390,200,100,100,2,400) e.near(l,400) e.near(r,190) end)
	t.test("negative transfer also stays bounded",function() local l,r=S.axle(5,390,-100,100,2,400) e.near(l,0) e.near(r,395) end)
	t.test("disabled antiroll preserves loads",function() local l,r=S.axle(60,100,4,100,0,400) e.near(l,60) e.near(r,100) end)
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF68">
        <Properties>
          <string name="Name">Suspension_Test</string>
          <ProtectedString name="Source">--!strict
return function(t)
	local S=require(game.ReplicatedStorage.AXZF.Shared.Suspension) local e=t.expect
	-- Implicit integration must retain the physical static equilibrium.
	t.test("implicit spring supports its static weight",function()
		local w=2*math.pi*3.5
		local result=S.solve({{compression=196.2/(w*w),velocity=0,gravity=-196.2,mobility={.1}}},10,196.2,3.5,.85,4,1/60)
		e.near(result[1],1962,1e-5)
	end)
	-- No contact means no normal force, including while airborne.
	t.test("no contacts produces no suspension forces",function() e.equal(#S.solve({},10,196.2,3.5,.85,4,1/60),0) end)
	-- A tire cannot pull the ground toward the chassis.
	t.test("implicit solver never creates tensile load",function()
		local r=S.solve({{compression=-5,velocity=10,gravity=-196.2,mobility={.1}}},10,196.2,3.5,.85,4,1/60)
		e.equal(r[1],0)
	end)
	-- Permuting contact order must preserve the coupled solution.
	t.test("contact ordering does not change settled loads",function()
		local a={compression=.2,velocity=.1,gravity=-196.2,mobility={.1,.02}}
		local b={compression=.4,velocity=-.2,gravity=-196.2,mobility={.02,.1}}
		local x=S.solve({a,b},10,196.2,3.5,.85,4,1/60)
		local y=S.solve({{compression=.4,velocity=-.2,gravity=-196.2,mobility={.1,.02}},{compression=.2,velocity=.1,gravity=-196.2,mobility={.02,.1}}},10,196.2,3.5,.85,4,1/60)
		e.near(x[1],y[2],1e-4) e.near(x[2],y[1],1e-4)
	end)
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF69">
        <Properties>
          <string name="Name">Tune_Test</string>
          <ProtectedString name="Source">--!strict
return function(t)
	local T=require(game.ReplicatedStorage.AXZF.Shared.Tune) local e=t.expect
	-- Versioned configuration rejects typos instead of silently using defaults.
	t.test("default tune resolves",function() e.equal(T.resolve(nil).SchemaVersion,1) end)
	t.test("custom keyboard binding resolves",function() e.equal(T.resolve({Controls={Handbrake="F"}}).Controls.Handbrake,"F") end)
	t.test("park has a separate default key",function() e.equal(T.resolve(nil).Controls.Park,"P") e.equal(T.resolve(nil).Controls.Handbrake,"Space") end)
	t.test("park braking bounded",function() e.throws(function() T.resolve({ParkBrakeAcceleration=0}) end) end)
	t.test("roll influence bounded",function() e.throws(function() T.resolve({RollInfluence=2}) end) end)
	t.test("park flags require booleans",function() e.throws(function() T.resolve({ParkOnSpawn=1}) end) end)
	t.test("duplicate keyboard bindings rejected",function() e.throws(function() T.resolve({Controls={Brake="W"}}) end) end)
	t.test("unknown keyboard key rejected",function() e.throws(function() T.resolve({Controls={Brake="UnknownKey"}}) end) end)
	t.test("control maps cannot mutate after resolution",function() e.throws(function() T.resolve(nil).Controls.Brake="P" end) end)
	t.test("recovery requires boolean",function() e.throws(function() T.resolve({AutoRecover=1}) end) end)
	t.test("power must be bounded",function() e.throws(function() T.resolve({Power=10}) end) end)
	t.test("unknown field rejected",function() e.throws(function() T.resolve({Gripp=2}) end) end)
	t.test("unknown schema rejected",function() e.throws(function() T.resolve({SchemaVersion=2}) end) end)
	t.test("NaN grip rejected",function() e.throws(function() T.resolve({Grip=0/0}) end) end)
	t.test("negative radius rejected",function() e.throws(function() T.resolve({Radius=-1}) end) end)
	t.test("zero travel rejected",function() e.throws(function() T.resolve({RestLength=0}) end) end)
	t.test("invalid drive rejected",function() e.throws(function() T.resolve({Drive="4x4"}) end) end)
	t.test("RPM hysteresis required",function() e.throws(function() T.resolve({ShiftDownRPM=6500}) end) end)
	t.test("descending ratios required",function() e.throws(function() T.resolve({Gears={1,2}}) end) end)
	t.test("empty ratios rejected",function() e.throws(function() T.resolve({Gears={}}) end) end)
	t.test("curve abscissas strictly increase",function() e.throws(function() T.resolve({TorqueCurve={{1,2},{1,3}}}) end) end)
	t.test("curve requires finite torque",function() e.throws(function() T.resolve({TorqueCurve={{1,2},{2,math.huge}}}) end) end)
	t.test("resolved tune immutable",function() e.throws(function() T.resolve(nil).Grip=0 end) end)
	t.test("caller changes cannot mutate resolved gear ratios",function() local g={3,2,1} local v=T.resolve({Gears=g}) g[1]=9 e.equal(v.Gears[1],3) end)
	t.test("caller changes cannot mutate curve",function() local c={{800,10},{7000,20}} local v=T.resolve({TorqueCurve=c}) c[1][2]=99 e.equal(v.TorqueCurve[1][2],10) end)
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF70">
        <Properties>
          <string name="Name">WheelMotion_Test</string>
          <ProtectedString name="Source">--!strict
return function(t)
	local M=require(game.ReplicatedStorage.AXZF.Shared.WheelMotion) local e=t.expect
	t.test("forward roll has correct negative X direction",function() e.near(M.angularVelocity(10,2),-5) end)
	t.test("reverse roll changes direction",function() e.near(M.angularVelocity(-10,2),5) end)
	t.test("double wheel radius halves angular speed",function() e.near(M.angularVelocity(20,2),M.angularVelocity(20,1)/2) end)
	t.test("stationary engine idle does not rotate wheels",function() e.near(M.advance(1,0,1,.5),1) end)
	t.test("locked handbrake wheel holds its phase",function() e.near(M.advance(1,30,1,.5,true),1) end)
	t.test("one circumference gives one complete revolution",function() e.near(M.advance(0,4*math.pi,2,1),0) end)
	t.test("phase integration is frame rate independent",function() local p=0 for _=1,60 do p=M.advance(p,12,1.5,1/60) end e.near(p,M.advance(0,12,1.5,1),1e-6) end)
	t.test("wheel rpm uses road speed rather than crankshaft rpm",function() e.near(M.rpm(2*math.pi*1.5,1.5),60) end)
	t.test("hitch does not use physics dt cap",function() e.near(M.advance(0,-4,2,.1),.2) end)
	t.test("inner and outer wheel speeds can differ",function() e.truthy(M.rpm(20,1)&gt;M.rpm(15,1)) end)
end
</ProtectedString>
        </Properties>
      </Item>

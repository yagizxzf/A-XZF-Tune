        <Item class="ModuleScript" referent="AXZF30">
          <Properties>
            <string name="Name">AssetIds</string>
            <ProtectedString name="Source">-- UI asset ids. Generated by roblox-ui-maker/scripts/assets.py from rbx/out/uploaded.json.
-- Do not edit by hand: upload through ledger.py, then re-run assets.py.
-- icons: your icon pack (icons/&lt;slug&gt;.png, 256px). art: plates/panels rendered from the HTML.
return {
	stud = "",
	icons = {
		["chevron_left"] = "rbxassetid://139643458010755",
		["chevron_right"] = "rbxassetid://109414773760073",
		["circle_parking"] = "rbxassetid://137215235121162",
		["circle_stop"] = "rbxassetid://98793648428351",
		["gauge"] = "rbxassetid://72438558949106",
		["hand"] = "rbxassetid://90085653799977",
		["log_out"] = "rbxassetid://127056024989943",
		["panel_left_close"] = "rbxassetid://93497424527544",
		["rotate_ccw"] = "rbxassetid://78691306546761",
	},
	art = {
		["a3df5ad79d6"] = "rbxassetid://123584403619529",
		["a47922417c7"] = "rbxassetid://87490249709669",
		["a4cb4869c0b"] = "rbxassetid://100668449590705",
		["a72875eebef"] = "rbxassetid://123399833903709",
		["a83c4cefba7"] = "rbxassetid://100668449590705",
		["a930620bbf2"] = "rbxassetid://118096181524058",
	},
}
</ProtectedString>
          </Properties>

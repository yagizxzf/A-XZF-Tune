      <Item class="ModuleScript" referent="AXZF16">
        <Properties>
          <string name="Name">Doctor</string>
          <ProtectedString name="Source">--!strict
local Doctor={}
local ids={"FL","FR","RL","RR"}
function Doctor.hub(wheel: Instance?): BasePart?
	if wheel and wheel:IsA("BasePart") then return wheel end
	if wheel and wheel:IsA("Model") then return wheel.PrimaryPart end
	return nil
end
function Doctor.inspect(model: any): any
	local errors, warnings={},{}
	local function fail(code,message) table.insert(errors,{code=code,message=message}) end
	if typeof(model)~="Instance" or not model:IsA("Model") then
		fail("MODEL","Expected a Model") return {ok=false,errors=errors,warnings=warnings}
	end
	local root=model:FindFirstChild("Chassis")
	local seat=model:FindFirstChild("DriveSeat")
	local wheels=model:FindFirstChild("Wheels")
	local body=model:FindFirstChild("Body")
	if not root or not root:IsA("BasePart") then fail("ROOT","Add a Chassis BasePart facing local -Z") end
	if not seat or not seat:IsA("VehicleSeat") then fail("SEAT","Add DriveSeat (VehicleSeat)") end
	if not body then fail("BODY","Add Body folder/model containing your separate panels") end
	if not wheels then fail("WHEELS","Add Wheels containing FL/FR/RL/RR") end
	local hubs={}
	for _,id in ipairs(ids) do
		local mount=root and root:FindFirstChild(id)
		if not mount or not mount:IsA("Attachment") then fail("MOUNT_"..id,"Chassis needs Attachment "..id) end
		local hub=Doctor.hub(wheels and wheels:FindFirstChild(id))
		if not hub then fail("HUB_"..id,"Wheel "..id.." must be BasePart or Model with PrimaryPart")
		elseif hubs[hub] then fail("DUPLICATE_HUB","Each wheel needs its own hub") else hubs[hub]=true end
	end
	local count=0
	for _,v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart") then count+=1 end
		if v:IsA("LuaSourceContainer") and not (v:IsA("ModuleScript") and v.Name=="Tune" and v.Parent==model) then fail("SCRIPT","Remove previous chassis code: "..v:GetFullName()) end
		if v:IsA("Constraint") or v:IsA("WeldConstraint") or v:IsA("JointInstance") or v:IsA("BodyMover") then fail("MECHANICS","Remove previous joints/constraints: "..v.Name) end
	end
	if root and root:IsA("BasePart") then
		local fl,fr,rl,rr=root:FindFirstChild("FL"),root:FindFirstChild("FR"),root:FindFirstChild("RL"),root:FindFirstChild("RR")
		if fl and fr and rl and rr and fl:IsA("Attachment") and fr:IsA("Attachment") and rl:IsA("Attachment") and rr:IsA("Attachment") then
			if fl.Position.X&gt;=fr.Position.X or rl.Position.X&gt;=rr.Position.X or fl.Position.Z&gt;=rl.Position.Z or fr.Position.Z&gt;=rr.Position.Z then fail("LAYOUT","Front = -Z, left = -X; check wheel labels/orientation") end
			if (fl.Position-fr.Position).Magnitude&lt;0.5 or (fl.Position-rl.Position).Magnitude&lt;0.5 then fail("SPACING","Wheel spacing must exceed 0.5 studs") end
		end
	end
	if count&gt;200 then table.insert(warnings,{code="PART_COUNT",message="Over 200 parts; measure replication/render cost"}) end
	return {ok=#errors==0,errors=errors,warnings=warnings,parts=count}
end
return Doctor
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF17">
        <Properties>
          <string name="Name">Fleet</string>
          <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local CollectionService=game:GetService("CollectionService")
local Guard=require(game:GetService("ReplicatedStorage").AXZF.Shared.InputGuard)
local Vehicle=require(script.Parent.Vehicle)
local Fleet={}
Fleet.__index=Fleet
function Fleet.start(options: any): any
	assert(RunService:IsServer(),"Fleet runs on server")
	options=options or {}
	local tag=options.tag or "AXZFVehicle"
	local remoteName=options.remoteName or "Control"
	local packageRoot=game:GetService("ReplicatedStorage").AXZF
	assert(not packageRoot:FindFirstChild(remoteName),"Fleet already started")
	-- Prepare presentation for both Bootstrap and applications that start Fleet directly.
	local ui=packageRoot:FindFirstChild("UI")
	if remoteName=="Control" and ui and not packageRoot:FindFirstChild("CockpitTemplate") then
		require(ui.Builder).build()
		local template=game:GetService("StarterGui").AXZFCockpit
		template.Name="CockpitTemplate" template.Enabled=false template.Parent=packageRoot
	end
	local remote=Instance.new("RemoteEvent") remote.Name=remoteName remote.Parent=packageRoot
	local self=setmetatable({vehicles={},pending={},queued={},connections={},buckets={},remote=remote,stopped=false},Fleet)
	if remoteName=="Control" and packageRoot.Parent:FindFirstChild("VFX") then self.effects=require(script.Parent.VFXService).new() end
	local function connect(signal,fn) table.insert(self.connections,signal:Connect(fn)) end
	function self:remove(model)
		self.queued[model]=nil self.pending[model]=nil
		local entry=self.vehicles[model] if not entry then return end
		self.vehicles[model]=nil
		for _,c in ipairs(entry.connections) do c:Disconnect() end
		entry.vehicle:destroy()
	end
	function self:add(model)
		if self.stopped or self.vehicles[model] or self.pending[model] or not model:IsDescendantOf(workspace) then return end
		local token={} self.pending[model]=token
		local ok,vehicle=pcall(function()
			local config=model:FindFirstChild("Tune")
			local overrides=nil
			if config then assert(config:IsA("ModuleScript"),"Tune must be ModuleScript") overrides=require(config) end
			return Vehicle.new(model,overrides)
		end)
		local cancelled=self.pending[model]~=token
		if not cancelled then self.pending[model]=nil end
		if cancelled or self.stopped or not model:IsDescendantOf(workspace) then if ok then vehicle:destroy() end return end
		if not ok then model:SetAttribute("AXZFError",tostring(vehicle)) warn("[A-XZF-Tune] "..model.Name..": "..tostring(vehicle)) return end
		model:SetAttribute("AXZFError",nil)
		if self.effects then vehicle.onEffect=function(name,at,intensity) self.effects:send(name,at,intensity) end end
		for action,key in pairs(vehicle.tune.Controls) do model:SetAttribute("AXZF_Key"..action,key) end
		for _,key in ipairs({"SpeedUnit","SpeedScale","ShowControls","RedlineRPM","IdleRPM","VFX","VFXIntensity"}) do model:SetAttribute("AXZF_Config"..key,vehicle.tune[key]) end
		local entry={vehicle=vehicle,lastSequence=0,driver=nil,connections={}}
		self.vehicles[model]=entry
		local function occupantChanged()
			if entry.driver and not vehicle.rig.seat.Occupant and vehicle.tune.AutoParkOnExit then vehicle:setPark(true) end
			entry.lastSequence=0 entry.vehicle:clearInput()
			local humanoid=vehicle.rig.seat.Occupant
			entry.driver=if humanoid then Players:GetPlayerFromCharacter(humanoid.Parent) else nil
		end
		table.insert(entry.connections,vehicle.rig.seat:GetPropertyChangedSignal("Occupant"):Connect(occupantChanged))
		table.insert(entry.connections,model.AncestryChanged:Connect(function() if not model:IsDescendantOf(workspace) then self:remove(model) end end))
		occupantChanged()
	end
	connect(remote.OnServerEvent,function(player,model,packet)
		local now=os.clock() local bucket=self.buckets[player]
		if not bucket then bucket={tokens=45,time=now} self.buckets[player]=bucket end
		if not Guard.consume(bucket,now) then return end
		if typeof(model)~="Instance" then return end
		local entry=self.vehicles[model] if not entry or entry.driver~=player then return end
		local occupant=entry.vehicle.rig.seat.Occupant
		if not occupant or occupant.Health&lt;=0 or occupant.Parent~=player.Character then return end
		if not Guard.validate(packet,entry.lastSequence) then return end
		entry.lastSequence=packet.seq entry.vehicle:setInput(packet)
	end)
	connect(Players.PlayerRemoving,function(player)
		self.buckets[player]=nil
		for _,entry in pairs(self.vehicles) do if entry.driver==player then entry.driver=nil entry.vehicle:clearInput() end end
	end)
	local function enqueue(model)
		if self.queued[model] or self.vehicles[model] then return end
		self.queued[model]=true
		task.defer(function()
			-- Parenting signals can fire before Roblox finishes rebuilding the assembly.
			RunService.Heartbeat:Wait()
			if self.queued[model] then self.queued[model]=nil self:add(model) end
		end)
	end
	connect(CollectionService:GetInstanceAddedSignal(tag),enqueue)
	connect(CollectionService:GetInstanceRemovedSignal(tag),function(model) self:remove(model) end)
	connect(workspace.DescendantAdded,function(v) if v:IsA("Model") and CollectionService:HasTag(v,tag) then enqueue(v) end end)
	connect(RunService.PreSimulation,function(dt)
		for model,entry in pairs(self.vehicles) do
			local ok,err=pcall(entry.vehicle.step,entry.vehicle,dt)
			if not ok then warn("[A-XZF-Tune] vehicle quarantined: "..tostring(err)) self:remove(model) model:SetAttribute("AXZFError",tostring(err)) end
		end
	end)
	for _,model in ipairs(CollectionService:GetTagged(tag)) do self:add(model) end
	return self
end
function Fleet:get(model: Model): any
	local entry=self.vehicles[model] return if entry then entry.vehicle else nil
end
function Fleet:stop()
	if self.stopped then return end self.stopped=true
	table.clear(self.queued) table.clear(self.pending)
	for _,c in ipairs(self.connections) do c:Disconnect() end
	local models={} for model in pairs(self.vehicles) do table.insert(models,model) end
	for _,model in ipairs(models) do self:remove(model) end
	self.remote:Destroy() table.clear(self.buckets)
	if self.effects then self.effects:destroy() end
end
return Fleet
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF18">
        <Properties>
          <string name="Name">Migration</string>
          <ProtectedString name="Source">--!strict
-- Editor-only geometry migration. Never requires legacy Tune/plugins/scripts.
local Doctor=require(script.Parent.Doctor)
local Migration={}
local ids={"FL","FR","RL","RR"}
local function findSource(wrapper)
	local candidates={}
	local all={wrapper} for _,v in ipairs(wrapper:GetDescendants()) do table.insert(all,v) end
	for _,v in ipairs(all) do
		if v:IsA("Model") and v:FindFirstChild("DriveSeat") and v:FindFirstChild("Wheels") and v:FindFirstChild("A-Chassis Tune") then table.insert(candidates,v) end
	end
	assert(#candidates==1,"Select exactly one A-Chassis vehicle (DriveSeat + Wheels + A-Chassis Tune)")
	return candidates[1]
end
local function geometry(instance,report)
	local copy=instance:Clone()
	for _,v in ipairs(copy:GetDescendants()) do
		if not (v:IsA("BasePart") or v:IsA("Model") or v:IsA("Folder") or v:IsA("DataModelMesh") or v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance")) then v:Destroy() report.stripped+=1 end
	end
	for _,v in ipairs(copy:GetDescendants()) do if v:IsA("BasePart") then v.Anchored=true end end
	if copy:IsA("BasePart") then copy.Anchored=true end
	return copy
end
function Migration.inspect(wrapper: Model): any
	assert(not game:GetService("RunService"):IsRunning(),"Migrate only in Edit mode")
	local source=findSource(wrapper)
	local scripts=0 local parts=0
	for _,v in ipairs(source:GetDescendants()) do if v:IsA("LuaSourceContainer") then scripts+=1 end if v:IsA("BasePart") then parts+=1 end end
	for _,id in ipairs(ids) do assert(Doctor.hub(source.Wheels:FindFirstChild(id)),"Unsupported wheel "..id..": choose a PrimaryPart before migration") end
	return {source=source,sourcePath=source:GetFullName(),legacyScripts=scripts,sourceParts=parts}
end
function Migration.convert(wrapper: Model, options: any): (Model, any)
	options=options or {}
	local report=Migration.inspect(wrapper) local source=report.source report.source=nil report.stripped=0
	local model=Instance.new("Model") model.Name=options.name or source.Name.."_AXZF"
	local ok,err=pcall(function()
		local wheels=Instance.new("Folder") wheels.Name="Wheels" wheels.Parent=model
		local centers={} local center=Vector3.zero local radius=0
		for _,id in ipairs(ids) do
			local oldWheel=source.Wheels[id] local oldHub=Doctor.hub(oldWheel) :: BasePart
			local hub=oldHub:Clone()
			-- Keep the wheel's render mesh and documented art Parts only. No arms/suspension.
			for _,child in ipairs(hub:GetChildren()) do
				if not child:IsA("DataModelMesh") and child.Name~="Parts" then child:Destroy() end
			end
			local safe=geometry(hub,report) hub:Destroy() hub=safe
			local wheel=Instance.new("Model") wheel.Name=id wheel.Parent=wheels hub.Name="Hub" hub.Parent=wheel wheel.PrimaryPart=hub
			centers[id]=hub.Position center+=hub.Position/4
			radius+=math.max(oldHub.Size.X,oldHub.Size.Y,oldHub.Size.Z)/8
		end
		radius=options.radius or radius
		local forward=((centers.FL+centers.FR)-(centers.RL+centers.RR))/2
		forward=Vector3.new(forward.X,0,forward.Z) assert(forward.Magnitude&gt;.5,"Wheelbase is too short")
		local frame=CFrame.lookAt(center+Vector3.new(0,.7,0),center+Vector3.new(0,.7,0)+forward.Unit)
		local localFL=frame:PointToObjectSpace(centers.FL) local localFR=frame:PointToObjectSpace(centers.FR)
		local localRL=frame:PointToObjectSpace(centers.RL)
		assert(localFL.X&lt;localFR.X,"Legacy wheel labels are mirrored; correct FL/FR first")
		local track=math.abs(localFR.X-localFL.X) local wheelbase=math.abs(localRL.Z-localFL.Z)
		local root=Instance.new("Part") root.Name="Chassis" root.Size=Vector3.new(track*.85,.7,wheelbase*.9)
		root.CFrame=frame root.Anchored=true root.Transparency=1 root.CustomPhysicalProperties=PhysicalProperties.new(1.2,.3,0,100,100) root.Parent=model model.PrimaryPart=root
		local body=Instance.new("Folder") body.Name="Body" body.Parent=model
		for _,group in ipairs({"Body","Misc"}) do
			local sourceGroup=source:FindFirstChild(group)
			if sourceGroup then local copy=geometry(sourceGroup,report) copy.Name="Visual"..group copy.Parent=body end
		end
		local seat=Instance.new("VehicleSeat") seat.Name="DriveSeat" seat.Size=source.DriveSeat.Size seat.CFrame=source.DriveSeat.CFrame
		seat.Anchored=true seat.HeadsUpDisplay=false seat.Parent=model
		local rest=options.restLength or 1.6
		for _,id in ipairs(ids) do
			local mount=Instance.new("Attachment") mount.Name=id mount.Position=frame:PointToObjectSpace(centers[id])+Vector3.new(0,rest,0) mount.Parent=root
		end
		local config=game.ServerStorage.AXZFExamples.VehicleTune:Clone() config.Name="Tune"
		local text=config.Source
		local values={Radius=radius,RestLength=rest,Drive=options.drive or "RWD"}
		for key,value in pairs(values) do
			local literal=if type(value)=="string" then string.format("%q",value) else tostring(value)
			text=string.gsub(text,"(\n%s*"..key.."%s*=%s*)[^,\n]+,",function(prefix) return prefix..literal.."," end,1)
		end
		config.Source=text config.Parent=model
		report.radius=radius report.track=track report.wheelbase=wheelbase report.doctor=Doctor.inspect(model)
		assert(report.doctor.ok,game:GetService("HttpService"):JSONEncode(report.doctor.errors))
		report.parts=report.doctor.parts report.legacyScriptsRemaining=0
		for _,v in ipairs(model:GetDescendants()) do
			if v:IsA("LuaSourceContainer") and v~=config then report.legacyScriptsRemaining+=1 end
		end
		assert(report.legacyScriptsRemaining==0,"Unexpected executable content after migration")
		model:SetAttribute("AXZF_MigratedFrom",report.sourcePath)
		model:SetAttribute("SourceAsset",options.assetId or "user-supplied")
		if options.at then model:PivotTo(options.at) end
	end)
	if not ok then model:Destroy() error(err,2) end
	return model,report
end
-- One Command Bar call on a selected model; original remains in its storage location.
function Migration.fromSelection(options: any): (Model,any)
	assert(not game:GetService("RunService"):IsRunning(),"Migrate only in Edit mode")
	local selected=game:GetService("Selection"):Get()
	assert(#selected==1 and selected[1]:IsA("Model"),"Select one vehicle Model in Explorer")
	local model,report=Migration.convert(selected[1],options)
	model.Parent=workspace
	game:GetService("CollectionService"):AddTag(model,"AXZFVehicle")
	game:GetService("Selection"):Set({model})
	return model,report
end
return Migration
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF19">
        <Properties>
          <string name="Name">Recovery</string>
          <ProtectedString name="Source">--!strict
local Recovery={}
Recovery.__index=Recovery
function Recovery.new(rig: any,tune: any): any
	return setmetatable({rig=rig,tune=tune,inverted=0,cooldown=0,count=0},Recovery)
end
function Recovery:step(dt: number): boolean
	local root=self.rig.root local t=self.tune
	self.cooldown=math.max(0,self.cooldown-dt)
	if not t.AutoRecover or self.cooldown&gt;0 or root.CFrame.UpVector.Y&gt;0.2 or root.AssemblyLinearVelocity.Magnitude&gt;t.RecoverMaxSpeed then
		if self.rig.model:GetAttribute("AXZF_recovery")=="Waiting for space" then self.rig.model:SetAttribute("AXZF_recovery",nil) end
		self.inverted=0 return false
	end
	local params=RaycastParams.new() params.FilterType=Enum.RaycastFilterType.Exclude
	local excluded={self.rig.model}
	if self.rig.seat.Occupant then table.insert(excluded,self.rig.seat.Occupant.Parent) end
	params.FilterDescendantsInstances=excluded params.RespectCanCollide=true
	local ground=workspace:Raycast(root.Position,Vector3.new(0,-12,0),params)
	if not ground or ground.Normal.Y&lt;0.7 or math.abs(root.AssemblyLinearVelocity.Y)&gt;3 then self.inverted=0 return false end
	self.inverted+=dt
	if self.inverted&lt;t.RecoverDelay then return false end
	local oldRoot=root.CFrame
	local box,size=self.rig.model:GetBoundingBox()
	local offset=oldRoot:ToObjectSpace(box)
	local forward=Vector3.new(oldRoot.LookVector.X,0,oldRoot.LookVector.Z)
	if forward.Magnitude&lt;0.1 then forward=Vector3.new(0,0,-1) end
	local orientation=CFrame.lookAt(Vector3.zero,forward.Unit)
	local transformed=orientation*offset
	local verticalExtent=(math.abs(transformed.RightVector.Y)*size.X+math.abs(transformed.UpVector.Y)*size.Y+math.abs(transformed.LookVector.Y)*size.Z)/2
	local height=verticalExtent-transformed.Position.Y+0.35
	local target=CFrame.new(ground.Position+Vector3.new(0,height,0))*orientation
	local overlap=OverlapParams.new() overlap.FilterType=Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances=excluded overlap.RespectCanCollide=true
	if #workspace:GetPartBoundsInBox(target*offset,size+Vector3.new(.1,.1,.1),overlap)&gt;0 then
		self.rig.model:SetAttribute("AXZF_recovery","Waiting for space") return false
	end
	self.rig.model:PivotTo(target*oldRoot:Inverse()*self.rig.model:GetPivot())
	root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
	self.count+=1 self.cooldown=5 self.inverted=0
	self.rig.model:SetAttribute("AXZF_recoveryCount",self.count)
	self.rig.model:SetAttribute("AXZF_recovery","Recovered")
	return true
end
return Recovery
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF20">
        <Properties>
          <string name="Name">Rig</string>
          <ProtectedString name="Source">--!strict
local Doctor=require(script.Parent.Doctor)
local Rig={}
function Rig.bind(model: Model): any
	assert(not model:GetAttribute("AXZFBound"),"Vehicle already bound")
	local report=Doctor.inspect(model)
	assert(report.ok,"Rig rejected: "..game:GetService("HttpService"):JSONEncode(report.errors))
	local root=model.Chassis :: BasePart
	local self={model=model,root=root,seat=model.DriveSeat,wheels={},created={},snapshots={},destroyed=false}
	local ownership=nil
	local seatHud=self.seat.HeadsUpDisplay
	if game:GetService("RunService"):IsRunning() and root:CanSetNetworkOwnership() then ownership={automatic=root:GetNetworkOwnershipAuto(),owner=root:GetNetworkOwner()} end
	local function own(instance) table.insert(self.created,instance) return instance end
	local function weld(a,b)
		local w=own(Instance.new("WeldConstraint")) w.Name="AXZF_Weld" w.Part0=a w.Part1=b w.Parent=a
	end
	function self:destroy()
		if self.destroyed then return end self.destroyed=true
		if self.seat.Occupant then self.seat.Occupant.Sit=false end
		local seatWeld=self.seat:FindFirstChild("SeatWeld") if seatWeld then seatWeld:Destroy() end
		for i=#self.created,1,-1 do self.created[i]:Destroy() end
		for p,s in pairs(self.snapshots) do
			if p.Parent then for key,value in pairs(s) do p[key]=value end end
		end
		model:SetAttribute("AXZFBound",nil)
		if self.seat.Parent then self.seat.HeadsUpDisplay=seatHud end
		if ownership and root.Parent and root:CanSetNetworkOwnership() then
			if ownership.automatic then root:SetNetworkOwnershipAuto() else root:SetNetworkOwner(ownership.owner) end
		end
	end
	local ok,err=pcall(function()
		for _,p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				self.snapshots[p]={Anchored=p.Anchored,Massless=p.Massless,CanCollide=p.CanCollide,CanQuery=p.CanQuery,RootPriority=p.RootPriority,CFrame=p.CFrame}
				p.Anchored=true p.Massless=p~=root p.CanCollide=p==root p.CanQuery=p==root
			end
		end
		root.RootPriority=127
		self.seat.HeadsUpDisplay=false
		local forceAttachment=own(Instance.new("Attachment")) forceAttachment.Name="AXZF_Force" forceAttachment.Parent=root
		local force=own(Instance.new("VectorForce")) force.Name="AXZF_ContactForce" force.Attachment0=forceAttachment
		force.ApplyAtCenterOfMass=true force.RelativeTo=Enum.ActuatorRelativeTo.World force.Parent=root self.force=force
		local torque=own(Instance.new("Torque")) torque.Name="AXZF_ContactTorque" torque.Attachment0=forceAttachment
		torque.RelativeTo=Enum.ActuatorRelativeTo.World torque.Parent=root self.torque=torque
		for _,p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and p~=root and not p:IsDescendantOf(model.Wheels) then weld(root,p) end
		end
		for _,id in ipairs({"FL","FR","RL","RR"}) do
			local wheel=model.Wheels[id] local hub=Doctor.hub(wheel) :: BasePart
			if wheel:IsA("Model") then for _,p in ipairs(wheel:GetDescendants()) do if p:IsA("BasePart") and p~=hub then weld(hub,p) end end end
			local mount=root[id] :: Attachment
			local motor=own(Instance.new("Motor6D")) motor.Name="AXZF_"..id motor.Part0=root motor.Part1=hub
			motor.C0=root.CFrame:ToObjectSpace(hub.CFrame) motor.Parent=root
			local rotation=hub.CFrame.Rotation:ToObjectSpace(root.CFrame.Rotation):Inverse()
			table.insert(self.wheels,{id=id,mount=mount,motor=motor,rotation=rotation,spin=0,load=0,length=0})
		end
		for p in pairs(self.snapshots) do p.Anchored=false end
		if game:GetService("RunService"):IsRunning() then
			local can,reason=root:CanSetNetworkOwnership() assert(can,reason)
			root:SetNetworkOwner(nil)
		end
		model:SetAttribute("AXZFBound",true)
	end)
	if not ok then self:destroy() error(err,2) end
	return self
end
return Rig
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF21">
        <Properties>
          <string name="Name">TuneEditor</string>
          <ProtectedString name="Source">--!strict
-- Edit-only documented Tune creation/upgrade. Never evaluates an existing ModuleScript.
local Tune=require(game.ReplicatedStorage.AXZF.Shared.Tune)
local Editor={}
local function literal(value): string
	if type(value)=="string" then return string.format("%q",value) end
	if type(value)=="table" then
		local entries={} for _,v in ipairs(value) do table.insert(entries,literal(v)) end
		return "{"..table.concat(entries,",").."}"
	end
	return tostring(value)
end
function Editor.install(model: Model,overrides: any): ModuleScript
	assert(not game:GetService("RunService"):IsRunning(),"Stop Play before editing Tune")
	assert(model:IsA("Model"),"Expected vehicle Model")
	local existing=model:FindFirstChild("Tune")
	assert(not existing or overrides~=nil,"Pass current AXZF overrides explicitly to preserve existing Tune values")
	local resolved=Tune.resolve(overrides)
	local editor=game:GetService("ScriptEditorService")
	local text=editor:GetEditorSource(game.ServerStorage.AXZFExamples.VehicleTune)
	for key,value in pairs(resolved) do
		if key~="Controls" then
			local count
			text,count=string.gsub(text,"(\n\t"..key.." = )([^\n]+)",function(prefix,old)
				return prefix..literal(value)..","..(string.match(old," %-%-.*$") or "")
			end,1)
			assert(count==1,"Template missing "..key)
		end
	end
	local controls={} for key,value in pairs(resolved.Controls) do table.insert(controls,"\t\t"..key.." = "..literal(value)..",") end table.sort(controls)
	text=string.gsub(text,"\n\tControls = {.-\n\t},","\n\tControls = {\n"..table.concat(controls,"\n").."\n\t},",1)
	local config=existing or Instance.new("ModuleScript")
	assert(config:IsA("ModuleScript"),"Tune path collision") config.Name="Tune" config.Parent=model
	editor:UpdateSourceAsync(config,function() return text end)
	return config
end
return Editor
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF22">
        <Properties>
          <string name="Name">VFXService</string>
          <ProtectedString name="Source">--!strict
-- Server decides grounded slip; clients render. Never handles client requests.
local Players=game:GetService("Players")
local VFXService={}
VFXService.__index=VFXService
function VFXService.new(): any
	local folder=game.ReplicatedStorage.VFX
	local build=require(folder.Build)
	local recipes=game:GetService("HttpService"):JSONDecode(require(folder.VehicleRecipes))
	for name,steps in pairs(recipes) do
		local previous=folder:FindFirstChild(name) if previous then previous:Destroy() end
		local _,report=build.run("game.ReplicatedStorage.VFX."..name,steps)
		assert(string.find(report,"0 errors",1,true),report)
		folder[name]:SetAttribute("EffectDuration",1.2)
	end
	local remote=Instance.new("UnreliableRemoteEvent") remote.Name="Effects" remote.Parent=game.ReplicatedStorage.AXZF
	return setmetatable({remote=remote,sent=0},VFXService)
end
function VFXService:send(name: string,at: CFrame,intensity: number)
	for _,player in ipairs(Players:GetPlayers()) do
		local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (root.Position-at.Position).Magnitude&lt;180 then self.remote:FireClient(player,name,at,math.clamp(intensity,.1,2)) self.sent+=1 end
	end
end
function VFXService:destroy() self.remote:Destroy() end
return VFXService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF23">
        <Properties>
          <string name="Name">Vehicle</string>
          <ProtectedString name="Source">--!strict
local Shared=game:GetService("ReplicatedStorage").AXZF.Shared
local Math=require(Shared.Math)
local Tune=require(Shared.Tune)
local Powertrain=require(Shared.Powertrain)
local Rig=require(script.Parent.Rig)
local Suspension=require(Shared.Suspension)
local Parking=require(Shared.Parking)
local Stability=require(Shared.Stability)
local Recovery=require(script.Parent.Recovery)
local Vehicle={}
Vehicle.__index=Vehicle
local neutral=table.freeze({throttle=0,steer=0,brake=1,handbrake=false})
function Vehicle.new(model: Model, overrides: any): any
	local tune=Tune.resolve(overrides)
	assert(tune.RestLength&gt;workspace.Gravity/(2*math.pi*tune.FrequencyHz)^2+0.1,"Suspension travel shorter than static sag; increase FrequencyHz or RestLength")
	local rig=Rig.bind(model)
	local params=RaycastParams.new() params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances={model} params.RespectCanCollide=true
	local self=setmetatable({rig=rig,tune=tune,powertrain=Powertrain.new(tune),input=neutral,inputAge=0,steer=0,telemetryAge=0,idleTime=0,destroyed=false,sleeping=false,lastStepMs=0},Vehicle)
	self.recovery=Recovery.new(rig,tune)
	self.parkRequested=tune.ParkOnSpawn
	rig.model:SetAttribute("AXZF_parkRequested",self.parkRequested)
	self.originalPhysics=rig.root.CustomPhysicalProperties
	if tune.Mass&gt;0 then
		local volume=rig.root.Size.X*rig.root.Size.Y*rig.root.Size.Z
		if tune.Mass/volume&lt;.01 or tune.Mass/volume&gt;100 then rig:destroy() error("Mass exceeds the density range for this Chassis size") end
		rig.root.CustomPhysicalProperties=PhysicalProperties.new(tune.Mass/volume,.3,0,100,100)
	end
	self.params=params
	self.wheelbase=math.abs(rig.root.FL.Position.Z-rig.root.RL.Position.Z)
	self.track=math.abs(rig.root.FL.Position.X-rig.root.FR.Position.X)
	for _,wheel in ipairs(rig.wheels) do
		wheel.motor:SetAttribute("AXZF_Radius",tune.Radius)
		wheel.motor:SetAttribute("AXZF_RollAxis",wheel.rotation:VectorToObjectSpace(Vector3.xAxis))
		wheel.motor:SetAttribute("AXZF_ForwardAxis",wheel.rotation:VectorToObjectSpace(Vector3.new(0,0,-1)))
		wheel.motor:SetAttribute("AXZF_Rear",wheel.id=="RL" or wheel.id=="RR")
		game:GetService("CollectionService"):AddTag(wheel.motor,"AXZFWheelVisual")
	end
	return self
end
-- Server integration / NPC seam; callers must supply a validated intent table.
function Vehicle:setInput(packet: any)
	if packet.park~=nil then self:setPark(packet.park) end
	self.input={throttle=packet.throttle,steer=packet.steer,brake=packet.brake,handbrake=packet.handbrake}
	self.inputAge=0 self.idleTime=0 self.sleeping=false
end
function Vehicle:setPark(requested: boolean)
	assert(type(requested)=="boolean","park must be boolean")
	self.parkRequested=requested
	self.rig.model:SetAttribute("AXZF_parkRequested",requested)
end
function Vehicle:clearInput()
	self.input=neutral self.inputAge=0 self.idleTime=0 self.sleeping=false
end
function Vehicle:getTelemetry(): any
	local speed=self.rig.root.AssemblyLinearVelocity.Magnitude
	return {speed=speed,rpm=self.powertrain.rpm,gear=if self.powertrain.direction&lt;0 then -1 else self.powertrain.gear,sleeping=self.sleeping,stepMs=self.lastStepMs,handbrake=self.handbrakeActive==true,parkRequested=self.parkRequested,parkState=Parking.state(self.parkRequested,speed,self.tune.ParkEngageSpeed)}
end
function Vehicle:step(rawDt: number)
	if self.destroyed or not self.rig.model:IsDescendantOf(workspace) then return end
	local started=os.clock()
	local dt=math.clamp(rawDt,0,1/30) if dt==0 then return end
	self.inputAge+=rawDt
	local input=if self.inputAge&gt;self.tune.InputTimeout then neutral else self.input
	self.handbrakeActive=input.handbrake
	local rig,t=self.rig,self.tune
	local root=rig.root local cf=root.CFrame local velocity=root.AssemblyLinearVelocity
	if self.recovery:step(rawDt) then self:clearInput() return end
	if not rig.seat.Occupant and input==neutral and velocity.Magnitude&lt;0.15 and root.AssemblyAngularVelocity.Magnitude&lt;0.1 then self.idleTime+=dt else self.idleTime=0 end
	-- Keep spring support active: skipping all rays would remove gravity support.
	-- Sleep only reduces telemetry/visual work; physics contact solving stays correct.
	self.sleeping=self.idleTime&gt;t.SleepAfter
	local up=cf.UpVector local speed=velocity:Dot(cf.LookVector)
	local force,reverseBrake=self.powertrain:step(speed,if self.parkRequested then 0 else input.throttle,dt)
	if self.parkRequested then force=0 end
	force*=t.Power
	if speed*math.sign(force)&gt;t.MaxSpeed then force=0 end
	local fade=math.max(t.MinSteerFraction,1-math.abs(speed)/t.SteerFadeSpeed)
	self.steer=Math.approach(self.steer,input.steer*math.rad(t.SteerDegrees)*fade,t.SteerResponse,dt)
	local left,right=Math.ackermann(self.steer,self.wheelbase,self.track)
	local assemblyMass=root.AssemblyMass local mass=assemblyMass/4
	local center=root.AssemblyCenterOfMass local angular=root.AssemblyAngularVelocity
	local contacts={}
	self.effectAge=(self.effectAge or 0)+rawDt
	local emitEffects=self.onEffect and t.VFX and t.VFXIntensity&gt;0 and self.effectAge&gt;1/6
	if emitEffects then self.effectAge=0 end
	-- Gather all contacts from one velocity snapshot before applying any impulse.
	for _,wheel in ipairs(rig.wheels) do
		local origin=wheel.mount.WorldPosition
		local hit=workspace:Raycast(origin,-up*(t.RestLength+t.Radius),self.params)
		wheel.length=t.RestLength wheel.load=0
		if hit and hit.Normal:Dot(up)&gt;0.25 then
			local length=math.clamp(hit.Distance-t.Radius,0,t.RestLength)
			local normal=hit.Normal
			local groundVelocity=if hit.Instance:IsA("BasePart") then hit.Instance:GetVelocityAtPosition(hit.Position) else Vector3.zero
			local arm=hit.Position-center
			local pointVelocity=velocity+angular:Cross(arm)-groundVelocity
			wheel.length=length
			table.insert(contacts,{wheel=wheel,hit=hit,normal=normal,arm=arm,pointVelocity=pointVelocity,compression=t.RestLength-length,velocity=pointVelocity:Dot(normal),gravity=-workspace.Gravity*normal.Y,mobility={},angularResponse=root:TorqueToAngularAcceleration(arm:Cross(normal))})
		end
	end
	for _,a in ipairs(contacts) do
		for j,b in ipairs(contacts) do a.mobility[j]=a.normal:Dot(b.normal)/assemblyMass+a.normal:Dot(b.angularResponse:Cross(a.arm)) end
	end
	local loads=Suspension.solve(contacts,mass,workspace.Gravity,t.FrequencyHz,t.DampingRatio,t.MaxLoad,dt)
	local byId={} for i,c in ipairs(contacts) do byId[c.wheel.id]=i end
	for _,axle in ipairs({{"FL","FR"},{"RL","RR"}}) do
		local l,r=byId[axle[1]],byId[axle[2]]
		if l and r then loads[l],loads[r]=Stability.axle(loads[l],loads[r],contacts[l].compression-contacts[r].compression,mass*(2*math.pi*t.FrequencyHz)^2,t.AntiRoll,mass*workspace.Gravity*t.MaxLoad) end
	end
	local linearImpulse,angularImpulse=Vector3.zero,Vector3.zero
	for i,contact in ipairs(contacts) do
		local wheel=contact.wheel local hit=contact.hit local normal=contact.normal local pointVelocity=contact.pointVelocity
		local load=loads[i] wheel.load=load
		local angle=if wheel.id=="FL" then left elseif wheel.id=="FR" then right else 0
			local forward=(cf*CFrame.Angles(0,-angle,0)).LookVector
			forward=forward-normal*forward:Dot(normal)
			if forward.Magnitude&gt;0.001 then
				forward=forward.Unit local side=forward:Cross(normal).Unit
				local longitudinalSpeed=pointVelocity:Dot(forward)
				local front=wheel.id=="FL" or wheel.id=="FR"
				local driven=t.Drive=="AWD" or (t.Drive=="FWD" and front) or (t.Drive=="RWD" and not front)
				local brake=math.max(input.brake,reverseBrake)*t.BrakeAcceleration
				if self.parkRequested then brake=math.max(brake,t.ParkBrakeAcceleration) end
				if input.handbrake and not front then brake=math.max(brake,t.HandbrakeAcceleration) end
				local longitudinal=(if driven then force/(if t.Drive=="AWD" then 4 else 2) else 0)+Math.braking(longitudinalSpeed,brake*mass,mass,dt)
				longitudinal+=Math.braking(longitudinalSpeed,load*t.RollingResistance,mass,dt)
				local lateral=-pointVelocity:Dot(side)*mass*t.LateralResponse
				-- Static parking traction also balances downhill gravity. Velocity-only
				-- brakes otherwise need continual creep to produce their holding force.
				if self.parkRequested and pointVelocity.Magnitude&lt;t.ParkEngageSpeed then
					longitudinal=math.clamp(longitudinal+forward.Y*mass*workspace.Gravity,-brake*mass,brake*mass)
					lateral+=side.Y*mass*workspace.Gravity
				end
				local surface=hit.Instance:GetAttribute("Grip")
				local grip=if Math.finite(surface) then math.clamp(surface,0.05,3) else 1
				local longForce,sideForce=Math.friction(longitudinal,lateral,load*t.Grip*grip)
				if emitEffects and not front and math.abs(speed)&gt;7 and load&gt;mass*workspace.Gravity*.1 then
					local material=hit.Material
					local dusty=material==Enum.Material.Sand or material==Enum.Material.Grass or material==Enum.Material.Ground or material==Enum.Material.Mud
					local slip=math.abs(pointVelocity:Dot(side))
					if dusty or input.handbrake or slip&gt;6 then
						local at=CFrame.lookAt(hit.Position+normal*.15,hit.Position+normal*.15+forward,normal)
						self.onEffect(if dusty then "AXZFSurfaceDust" else "AXZFTyreSmoke",at,math.clamp((slip+math.abs(speed)*.12)/12,.2,1)*t.VFXIntensity)
					end
				end
				local support=normal*load*dt local tyre=(forward*longForce+side*sideForce)*dt
				-- Keep yaw leverage, reduce the tyre's vertical roll/pitch lever arm.
				local tyreArm=contact.arm-up*(contact.arm:Dot(up)*(1-t.RollInfluence))
				linearImpulse+=support+tyre
				angularImpulse+=contact.arm:Cross(support)+tyreArm:Cross(tyre)
			end
	end
	-- Persistent world-space actuators let the engine apply support at its own
	-- substeps. Per-frame impulse bursts caused visible gravity/velocity jitter.
	rig.force.Force=linearImpulse/dt-velocity*velocity.Magnitude*t.Drag
	rig.torque.Torque=angularImpulse/dt
	if #contacts&gt;=2 and t.RollDamping&gt;0 then
		local axis=cf.LookVector local inverseInertia=root:TorqueToAngularAcceleration(axis):Dot(axis)
		if inverseInertia&gt;1e-8 then
			local acceleration=math.clamp(-angular:Dot(axis)*t.RollDamping,-50,50)
			rig.torque.Torque+=axis*(acceleration/inverseInertia)
		end
	end
	for _,wheel in ipairs(rig.wheels) do
		if not self.sleeping then
			local angle=if wheel.id=="FL" then left elseif wheel.id=="FR" then right else 0
			-- Server owns suspension/steering. Client Transform owns rolling spin.
			wheel.motor.C0=CFrame.new(wheel.mount.Position-Vector3.new(0,wheel.length,0))*CFrame.Angles(0,-angle,0)*wheel.rotation
		end
	end
	self.telemetryAge+=rawDt
	if self.telemetryAge&gt;=1/t.TelemetryHz then
		self.telemetryAge=0
		local state=self:getTelemetry()
		for key,value in pairs(state) do rig.model:SetAttribute("AXZF_"..key,value) end
	end
	self.lastStepMs=(os.clock()-started)*1000
end
function Vehicle:destroy()
	if self.destroyed then return end self.destroyed=true self.rig:destroy()
	if self.rig.root.Parent then self.rig.root.CustomPhysicalProperties=self.originalPhysics end
	for _,key in ipairs({"speed","rpm","gear","sleeping","stepMs","handbrake","parkRequested","parkState","recovery","recoveryCount"}) do self.rig.model:SetAttribute("AXZF_"..key,nil) end
end
return Vehicle
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="AXZF44">
      <Properties>
        <string name="Name">Demo</string>
        <ProtectedString name="Source">--!strict
local storage=game:GetService("ServerStorage")
local rs=game:GetService("ReplicatedStorage")
local tags=game:GetService("CollectionService")
local examples=storage:WaitForChild("AXZFExamples")
if not workspace:FindFirstChildOfClass("SpawnLocation") then
	local spawn=Instance.new("SpawnLocation") spawn.Name="AXZFSpawn" spawn.Anchored=true
	spawn.Size=Vector3.new(5,0.5,5) spawn.CFrame=CFrame.new(0,1,45) spawn.Parent=workspace
end
if not workspace:FindFirstChild("AXZF_TestTrack") then require(examples.TestTrack).create().Parent=workspace end
if not workspace:FindFirstChild("AXZF_Prototype") then
	local car=require(examples.PrototypeCar).create(CFrame.new(-12,5,35))
	car.Parent=workspace tags:AddTag(car,"AXZFVehicle")
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="AXZF59">
      <Properties>
        <string name="Name">Multiplayer</string>
        <ProtectedString name="Source">--!strict
-- Only runs under the explicit StudioTestService test invocation below.
local RunService=game:GetService("RunService")
if not RunService:IsStudio() then return end
local testService=game:GetService("StudioTestService")
local args=testService:GetTestArgs()
if type(args)~="table" or args.name~="AXZF" then return end
local packageRoot=game.ReplicatedStorage:WaitForChild("AXZF")
local remote=Instance.new("RemoteEvent") remote.Name="__Prototype_AXZF_Multiplayer" remote.Parent=packageRoot
packageRoot:SetAttribute("__MultiplayerTest",true)
local players=game:GetService("Players")
local tags=game:GetService("CollectionService")
local cars={} local replies={}
local connection=remote.OnServerEvent:Connect(function(player,id) replies[player]=id end)
local report={}
task.delay(45,function() testService:EndTest({pass=false,error="multiplayer watchdog timeout"}) end)
local ok,err=xpcall(function()
	local start=os.clock()
	while #players:GetPlayers()&lt;2 and os.clock()-start&lt;15 do task.wait(.1) end
	local list=players:GetPlayers() assert(#list==2,"Expected exactly two real test clients")
	packageRoot:WaitForChild("Control",10)
	local factory=require(game.ServerStorage.AXZFExamples.PrototypeCar)
	for i,player in ipairs(list) do
		local character=player.Character or player.CharacterAdded:Wait()
		local humanoid=character:WaitForChild("Humanoid")
		local m=factory.create(CFrame.new(if i==1 then -20 else 20,5,20),"__Prototype_AXZF_MP"..i)
		m.Parent=workspace tags:AddTag(m,"AXZFVehicle") table.insert(cars,m)
		task.wait(.2) m.DriveSeat:Sit(humanoid)
	end
	task.wait(2)
	report.twoOccupants=cars[1].DriveSeat.Occupant~=nil and cars[2].DriveSeat.Occupant~=nil
	report.serverOwnership=cars[1].Chassis:GetNetworkOwner()==nil and cars[2].Chassis:GetNetworkOwner()==nil
	local function request(player,id,target,kind,seq)
		replies[player]=nil remote:FireClient(player,id,target,kind,seq)
		local now=os.clock() while replies[player]~=id and os.clock()-now&lt;5 do task.wait(.05) end
		assert(replies[player]==id,"Client did not complete "..id)
	end
	local z=cars[2].Chassis.Position.Z
	request(list[1],"cross-owner",cars[2],"valid",100)
	report.otherDriverRejected=math.abs(cars[2].Chassis.Position.Z-z)&lt;1
	z=cars[1].Chassis.Position.Z
	request(list[1],"malformed",cars[1],"invalid",200)
	report.malformedRejected=math.abs(cars[1].Chassis.Position.Z-z)&lt;1
	request(list[1],"valid",cars[1],"valid",300)
	report.ownDriverMoves=cars[1].Chassis.AssemblyLinearVelocity.Magnitude&gt;10
	z=cars[1].Chassis.Position.Z
	request(list[1],"replay",cars[1],"valid",1)
	task.wait(2) report.replayStops=cars[1].Chassis.AssemblyLinearVelocity.Magnitude&lt;3
	list[1].Character.Humanoid.Sit=false task.wait(.3)
	report.exitClearsSeat=cars[1].DriveSeat.Occupant==nil
	report.pass=true
	for _,key in ipairs({"twoOccupants","serverOwnership","otherDriverRejected","malformedRejected","ownDriverMoves","replayStops","exitClearsSeat"}) do if not report[key] then report.pass=false end end
end,debug.traceback)
connection:Disconnect() remote:Destroy() for _,m in ipairs(cars) do m:Destroy() end
if not ok then report.error=tostring(err) report.pass=false end
testService:EndTest(report)
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="AXZF24">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="AXZF25">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="AXZF26">
        <Properties>
          <string name="Name">Driver</string>
          <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local CAS=game:GetService("ContextActionService")
local UIS=game:GetService("UserInputService")
local RunService=game:GetService("RunService")
local Tags=game:GetService("CollectionService")
local player=Players.LocalPlayer
local packageRoot=game.ReplicatedStorage:WaitForChild("AXZF")
local remote=packageRoot:WaitForChild("Control") :: RemoteEvent
local active: Model?=nil
local state={Forward=0,Reverse=0,Left=0,Right=0,Brake=0}
local park=false local handbrake=false local stick=0 local sequence=0 local elapsed=0
local characterConnections={} local lifetime={}
local nativeTouch: ScreenGui?=nil local nativeEnabled=true
local function hideNativeTouch()
	if not nativeTouch then
		local native=player.PlayerGui:FindFirstChild("TouchGui")
		if native and native:IsA("ScreenGui") then nativeTouch=native nativeEnabled=native.Enabled end
	end
	if nativeTouch then nativeTouch.Enabled=false end
end
local cockpit=nil
local defaults={Forward="W",Reverse="S",Left="A",Right="D",Brake="B",Handbrake="Space",Park="P",Exit="E",HideControls="H"}
local gamepad={Forward=Enum.KeyCode.ButtonR2,Reverse=Enum.KeyCode.ButtonL2,Brake=Enum.KeyCode.ButtonB,Handbrake=Enum.KeyCode.ButtonA,Park=Enum.KeyCode.ButtonX,Exit=Enum.KeyCode.ButtonY}
local function connect(signal,fn) table.insert(lifetime,signal:Connect(fn)) end
local function clear() for key in pairs(state) do state[key]=0 end stick=0 end
local function action(name,down,amount)
	if not active then return end
	if name=="Handbrake" then if down then handbrake=not handbrake end
	elseif name=="Park" then if down then park=not park end
	elseif name=="Exit" then if down then local h=player.Character and player.Character:FindFirstChildOfClass("Humanoid") if h then h.Sit=false end end
	elseif name=="HideControls" then if down and cockpit then cockpit:toggleHelp() end
	elseif state[name]~=nil then state[name]=if down then amount or 1 else 0 end
end
local ui=packageRoot:WaitForChild("UI",15)
if not ui then warn("[A-XZF-Tune] GUI package missing: install ReplicatedStorage.AXZF.UI") return end
local cockpitModule=ui:WaitForChild("Cockpit",15)
if not cockpitModule then warn("[A-XZF-Tune] GUI package incomplete: Cockpit module missing") return end
cockpit=require(cockpitModule).new(player,action)
local function send()
	if not active then return end sequence+=1
	if UIS:GetFocusedTextBox() then clear() state.Brake=1 end
	remote:FireServer(active,{seq=sequence,throttle=state.Forward-state.Reverse,steer=math.clamp(state.Right-state.Left+stick,-1,1),brake=state.Brake,handbrake=handbrake,park=park})
end
local function unbind()
	for id in pairs(defaults) do CAS:UnbindAction("AXZF_"..id) end
	CAS:UnbindAction("AXZF_stick") clear() park=false handbrake=false
	if nativeTouch then nativeTouch.Enabled=nativeEnabled nativeTouch=nil end
end
local function setVehicle(model: Model?)
	if active==model then return end
	if active then clear() state.Brake=1 handbrake=false send() end
	unbind() active=model sequence=0 cockpit:setVehicle(model)
	if not model then return end
	park=model:GetAttribute("AXZF_parkRequested")==true
	hideNativeTouch()
	for id,fallback in pairs(defaults) do
		local key=model:GetAttribute("AXZF_Key"..id) or fallback
		local keys={Enum.KeyCode[key]} if gamepad[id] then table.insert(keys,gamepad[id]) end
		CAS:BindActionAtPriority("AXZF_"..id,function(_,phase,input)
			if UIS:GetFocusedTextBox() then clear() return Enum.ContextActionResult.Pass end
			local began=phase==Enum.UserInputState.Begin
			local ended=phase==Enum.UserInputState.End or phase==Enum.UserInputState.Cancel
			if id=="Handbrake" or id=="Park" or id=="Exit" or id=="HideControls" then if began then action(id,true) end
			elseif ended then action(id,false)
			elseif began or phase==Enum.UserInputState.Change then
				local analog=input.KeyCode==Enum.KeyCode.ButtonR2 or input.KeyCode==Enum.KeyCode.ButtonL2
				action(id,true,if analog then math.clamp(input.Position.Z,0,1) else 1)
			end
			return Enum.ContextActionResult.Sink
		end,false,3000,table.unpack(keys))
	end
	CAS:BindActionAtPriority("AXZF_stick",function(_,phase,input)
		stick=if phase==Enum.UserInputState.Cancel or phase==Enum.UserInputState.End then 0 else (if math.abs(input.Position.X)&gt;.12 then input.Position.X else 0)
		return Enum.ContextActionResult.Sink
	end,false,3000,Enum.KeyCode.Thumbstick1)
end
local function hook(character)
	for _,c in ipairs(characterConnections) do c:Disconnect() end table.clear(characterConnections) setVehicle(nil)
	local humanoid=character:WaitForChild("Humanoid")
	local function refresh()
		local seat=humanoid.SeatPart local model=seat and seat.Parent
		setVehicle(if seat and seat.Name=="DriveSeat" and model and model:IsA("Model") and Tags:HasTag(model,"AXZFVehicle") then model else nil)
	end
	table.insert(characterConnections,humanoid.Seated:Connect(refresh))
	table.insert(characterConnections,humanoid.Died:Connect(function() setVehicle(nil) end)) refresh()
end
connect(player.CharacterAdded,hook) if player.Character then task.spawn(hook,player.Character) end
connect(UIS.WindowFocusReleased,function() clear() state.Brake=1 send() end)
connect(UIS.WindowFocused,clear)
connect(UIS.TextBoxFocused,function() clear() state.Brake=1 send() end)
connect(UIS.TextBoxFocusReleased,clear)
connect(RunService.Heartbeat,function(dt)
	elapsed+=dt if elapsed&lt;1/20 then return end elapsed=0
	if active and not active:IsDescendantOf(workspace) then setVehicle(nil) end
	if active then hideNativeTouch() end
	send() cockpit:update()
end)
script.Destroying:Connect(function()
	setVehicle(nil) for _,c in ipairs(characterConnections) do c:Disconnect() end for _,c in ipairs(lifetime) do c:Disconnect() end cockpit:destroy()
end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="AXZF27">
        <Properties>
          <string name="Name">VehicleEffects</string>
          <ProtectedString name="Source">--!strict
local RunService=game:GetService("RunService")
local folder=game.ReplicatedStorage:WaitForChild("VFX")
local Emit=require(folder:WaitForChild("Emit"))
local remote=game.ReplicatedStorage:WaitForChild("AXZF"):WaitForChild("Effects")
local allowed={AXZFTyreSmoke=true,AXZFSurfaceDust=true}
local preload=task.spawn(function()
	local templates={}
	for name in pairs(allowed) do local t=folder:WaitForChild(name,10) if t then table.insert(templates,t) end end
	if #templates&gt;0 then pcall(function() game:GetService("ContentProvider"):PreloadAsync(templates) end) end
end)
local handles={} local tokens=30 local elapsed=0
local event=remote.OnClientEvent:Connect(function(name,at,intensity)
	if not allowed[name] or typeof(at)~="CFrame" or type(intensity)~="number" then return end
	if tokens&lt;1 or (workspace.CurrentCamera.CFrame.Position-at.Position).Magnitude&gt;180 then return end
	local template=folder:FindFirstChild(name) if not template then return end tokens-=1
	local copy=template:Clone()
	for _,p in ipairs(copy:GetDescendants()) do
		if p:IsA("ParticleEmitter") then p:SetAttribute("EmitCount",math.max(1,math.floor((p:GetAttribute("EmitCount") or 1)*math.clamp(intensity,.1,2)))) end
	end
	local handle=Emit.play(copy,at) copy:Destroy() table.insert(handles,handle)
end)
local step=RunService.Heartbeat:Connect(function(dt)
	tokens=math.min(30,tokens+dt*30) elapsed+=dt
	if elapsed&lt;.5 then return end elapsed=0
	for i=#handles,1,-1 do if handles[i].finished then table.remove(handles,i) end end
end)
script.Destroying:Connect(function() event:Disconnect() step:Disconnect() pcall(task.cancel,preload) for _,h in ipairs(handles) do h:stop() end end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="AXZF28">
        <Properties>
          <string name="Name">WheelVisuals</string>
          <ProtectedString name="Source">--!strict
-- Cosmetic only; no forces, ownership changes or client-to-server state.
local Run=game:GetService("RunService")
local Tags=game:GetService("CollectionService")
local packageRoot=game.ReplicatedStorage:WaitForChild("AXZF")
local Motion=require(packageRoot:WaitForChild("Shared"):WaitForChild("WheelMotion"))
local wheels={}
local function add(motor)
	if motor:IsA("Motor6D") then wheels[motor]={phase=0} end
end
local function remove(motor)
	wheels[motor]=nil
	if motor.Parent then motor.Transform=CFrame.identity end
end
local added=Tags:GetInstanceAddedSignal("AXZFWheelVisual"):Connect(add)
local removed=Tags:GetInstanceRemovedSignal("AXZFWheelVisual"):Connect(remove)
for _,motor in ipairs(Tags:GetTagged("AXZFWheelVisual")) do add(motor) end
local update=Run.PreSimulation:Connect(function(dt)
	local camera=workspace.CurrentCamera
	if not camera then return end
	for motor,state in pairs(wheels) do
		local root,hub=motor.Part0,motor.Part1
		local radius=motor:GetAttribute("AXZF_Radius")
		local axis=motor:GetAttribute("AXZF_RollAxis") local forward=motor:GetAttribute("AXZF_ForwardAxis")
		if root and hub and root:IsDescendantOf(workspace) and typeof(radius)=="number" and radius&gt;0 and typeof(axis)=="Vector3" and typeof(forward)=="Vector3" then
			if (root.Position-camera.CFrame.Position).Magnitude&gt;250 then continue end
			local frame=root.CFrame*motor.C0
			local direction=frame:VectorToWorldSpace(forward)
			local speed=root:GetVelocityAtPosition(hub.Position):Dot(direction)
			local model=root.Parent
			local rear=motor:GetAttribute("AXZF_Rear")==true
			local locked=(rear and model:GetAttribute("AXZF_handbrake")==true) or model:GetAttribute("AXZF_parkState")=="Parked"
			state.phase=Motion.advance(state.phase,speed,radius,dt,locked)
			motor.Transform=CFrame.fromAxisAngle(axis,state.phase)
		end
	end
end)
script.Destroying:Connect(function()
	update:Disconnect() added:Disconnect() removed:Disconnect()
	for motor in pairs(wheels) do remove(motor) end
end)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="AXZF58">
        <Properties>
          <string name="Name">Multiplayer</string>
          <ProtectedString name="Source">--!strict
if not game:GetService("RunService"):IsStudio() then return end
local packageRoot=game.ReplicatedStorage:WaitForChild("AXZF")
local remote=packageRoot:WaitForChild("__Prototype_AXZF_Multiplayer",8)
if not remote then return end
local normal=game.Players.LocalPlayer.PlayerScripts:WaitForChild("Driver",5)
if normal then normal.Enabled=false end
remote.OnClientEvent:Connect(function(id,model,kind,sequence)
	local control=packageRoot:WaitForChild("Control")
	for i=1,20 do
		control:FireServer(model,{seq=sequence+i,throttle=if kind=="invalid" then 2 else 1,steer=0,brake=0,handbrake=false}) task.wait(.05)
	end
	remote:FireServer(id)
end)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="AXZF41">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="AXZF42">
      <Properties>
        <string name="Name">AXZFExamples</string>
      </Properties>
      <Item class="ModuleScript" referent="AXZF43">
        <Properties>
          <string name="Name">CreatorCarAdapter</string>
          <ProtectedString name="Source">--!strict
-- Editor-only integration recipe for Creator Store asset 14215126016.
-- Third-party geometry is not relicensed or distributed with this MIT kit.
return function(quarantined: Model, at: CFrame?): Model
	assert(not game:GetService("RunService"):IsRunning(),"Adapt external art in Edit mode only")
	local source=quarantined:FindFirstChild("Car") or quarantined
	assert(source:FindFirstChild("Body") and source:FindFirstChild("Chassis"),"Expected reviewed Car asset hierarchy")
	local m=Instance.new("Model") m.Name="AXZF_ImportedCar"
	local ok,err=pcall(function()
		local body=source.Body:Clone()
		for _,v in ipairs(body:GetDescendants()) do
			-- Geometry-only allowlist. SurfaceAppearance/texture dependencies intentionally excluded:
			-- the inspected asset referenced inaccessible/mismatched texture-pack content.
			if not (v:IsA("BasePart") or v:IsA("Model") or v:IsA("Folder") or v:IsA("DataModelMesh")) then v:Destroy()
			elseif v:IsA("MeshPart") then v.TextureID=""
			elseif v:IsA("SpecialMesh") then v.TextureId="" end
		end
		for _,v in ipairs(body:GetChildren()) do v.Parent=m end body:Destroy()
		local wheels={} local center=Vector3.zero
		for _,id in ipairs({"FL","FR","RL","RR"}) do
			local wheel=m[id] wheel.PrimaryPart=wheel:FindFirstChild("tire")
			assert(wheel.PrimaryPart,"Missing tire hub "..id)
			wheels[id]=wheel center+=wheel.PrimaryPart.Position/4
		end
		local root=Instance.new("Part") root.Name="Root" root.Size=Vector3.new(5.8,.8,11.5)
		root.CFrame=CFrame.new(center+Vector3.new(0,.8,0))*source.Chassis.VehicleSeat.CFrame.Rotation
		root.Transparency=1 root.Anchored=true root.CustomPhysicalProperties=PhysicalProperties.new(1.2,.3,0,100,100) root.Parent=m
		local seat=Instance.new("VehicleSeat") seat.Size=Vector3.new(1,.25,1)
		seat.CFrame=source.Chassis.VehicleSeat.CFrame seat.Anchored=true seat.Parent=m
		local report=require(game.ServerScriptService.AXZFServer.Adapter).prepare(m,root,seat,wheels,1.6)
		assert(report.ok,game:GetService("HttpService"):JSONEncode(report.errors))
		m:SetAttribute("SourceAsset","14215126016") m:SetAttribute("SourceCreator","Roblox Resources")
		m:SetAttribute("Redistribution","Not included in MIT source; rights unverified")
		local config=game.ServerStorage.AXZFExamples.VehicleTune:Clone() config.Name="Tune"
		config.Source=config.Source:gsub("Radius = 1.25,","Radius = 1.5,"):gsub('Drive = "RWD",','Drive = "FWD",'):gsub("TorqueScale = 4,","TorqueScale = 5,")
		config.Parent=m
		m:PivotTo(at or CFrame.new(12,5,35))
	end)
	if not ok then m:Destroy() error(err,2) end
	return m
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF45">
        <Properties>
          <string name="Name">PrototypeCar</string>
          <ProtectedString name="Source">--!strict
-- Original, fully editable multi-part demonstration car. No external meshes.
local Car={}
local function part(name,size,cf,color,parent)
	local p=Instance.new("Part") p.Name=name p.Size=size p.CFrame=cf p.Color=color
	p.Anchored=true p.TopSurface=Enum.SurfaceType.Smooth p.BottomSurface=Enum.SurfaceType.Smooth p.Parent=parent return p
end
function Car.create(at: CFrame?, name: string?): Model
	local frame=at or CFrame.new(0,4,0)
	local m=Instance.new("Model") m.Name=name or "AXZF_Prototype"
	local tune=game.ServerStorage.AXZFExamples:FindFirstChild("VehicleTune")
	if tune then local config=tune:Clone() config.Name="Tune" config.Parent=m end
	local root=part("Chassis",Vector3.new(5.6,0.8,9.5),frame,Color3.fromRGB(27,31,36),m)
	root.CustomPhysicalProperties=PhysicalProperties.new(1.2,0.3,0,100,100)
	root.Transparency=0.5 m.PrimaryPart=root
	local body=Instance.new("Folder") body.Name="Body" body.Parent=m
	local paint=Color3.fromRGB(227,106,36)
	part("Floor",Vector3.new(5.8,0.35,10),frame*CFrame.new(0,0.5,0),paint,body)
	part("Hood",Vector3.new(5.5,0.8,3),frame*CFrame.new(0,1,-3.3),paint,body)
	part("Trunk",Vector3.new(5.5,0.6,2.3),frame*CFrame.new(0,1,3.7),paint,body)
	part("Roof",Vector3.new(5.2,0.25,3.8),frame*CFrame.new(0,3,0.5),paint,body)
	for _,x in ipairs({-2.5,2.5}) do
		part(if x&lt;0 then "DoorLeft" else "DoorRight",Vector3.new(0.25,1.2,4.7),frame*CFrame.new(x,1.1,0.3),paint,body)
		for _,z in ipairs({-1.3,2.3}) do part("Pillar",Vector3.new(0.2,1.8,0.2),frame*CFrame.new(x,2,z),paint,body) end
	end
	for _,x in ipairs({-1.8,1.8}) do
		local lamp=part("Headlamp",Vector3.new(1.1,0.4,0.12),frame*CFrame.new(x,1,-4.84),Color3.fromRGB(255,238,183),body) lamp.Material=Enum.Material.Neon
		part("TailLamp",Vector3.new(1.1,0.35,0.12),frame*CFrame.new(x,1,4.94),Color3.fromRGB(180,26,25),body)
	end
	local seat=Instance.new("VehicleSeat") seat.Name="DriveSeat" seat.Size=Vector3.new(2,0.4,2)
	seat.CFrame=frame*CFrame.new(-1.2,1.3,0.4) seat.Anchored=true seat.Parent=m
	local wheels=Instance.new("Folder") wheels.Name="Wheels" wheels.Parent=m
	for _,id in ipairs({"FL","FR","RL","RR"}) do
		local x=if string.sub(id,2,2)=="L" then -3.1 else 3.1
		local z=if string.sub(id,1,1)=="F" then -3.2 else 3.2
		local mount=Instance.new("Attachment") mount.Name=id mount.Position=Vector3.new(x,0.6,z) mount.Parent=root
		local wheel=Instance.new("Model") wheel.Name=id wheel.Parent=wheels
		local cf=frame*CFrame.new(x,-1,z)
		local tire=part("Tire",Vector3.new(0.8,2.5,2.5),cf,Color3.fromRGB(23,24,27),wheel)
		tire.Shape=Enum.PartType.Cylinder tire.Material=Enum.Material.Rubber wheel.PrimaryPart=tire
		local rim=part("Rim",Vector3.new(0.85,1.6,1.6),cf,Color3.fromRGB(177,186,193),wheel) rim.Shape=Enum.PartType.Cylinder rim.Material=Enum.Material.Metal
	end
	return m
end
return Car
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF46">
        <Properties>
          <string name="Name">TestTrack</string>
          <ProtectedString name="Source">--!strict
local Track={}
function Track.create(): Model
	local m=Instance.new("Model") m.Name="AXZF_TestTrack"
	local function p(name,size,cf,color,grip)
		local a=Instance.new("Part") a.Name=name a.Anchored=true a.Size=size a.CFrame=cf a.Color=color a.Material=Enum.Material.Asphalt
		if grip then a:SetAttribute("Grip",grip) end a.Parent=m return a
	end
	p("Straight",Vector3.new(100,1,800),CFrame.new(0,0,-280),Color3.fromRGB(51,55,60))
	for i=0,15 do p("LaneMark",Vector3.new(0.25,0.02,7),CFrame.new(0,0.51,50-i*40),Color3.fromRGB(233,225,195)) end
	p("LowGrip",Vector3.new(20,0.1,80),CFrame.new(32,0.56,-100),Color3.fromRGB(103,135,153),0.3)
	p("Ramp",Vector3.new(18,1,45),CFrame.new(-30,4,-100)*CFrame.Angles(math.rad(10),0,0),Color3.fromRGB(111,115,121))
	for i=1,8 do p("Bump",Vector3.new(12,0.3,0.6),CFrame.new(28,0.65,-220-i*5),Color3.fromRGB(190,156,55)) end
	return m
end
return Track
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF47">
        <Properties>
          <string name="Name">VehicleTune</string>
          <ProtectedString name="Source">--!strict
-- A-XZF-Tune | ARAÇ İÇİ AYAR REHBERİ (0.3)
-- Bu ModuleScript aracın doğrudan altında, adı Tune olacak şekilde kalır.
-- BAŞLANGIÇ: Play'i durdur &gt; tek değeri küçük adımlarla değiştir &gt; Play &gt; DriveSeat'e otur.
-- Yanlış değer/isim aracın AXZFError attribute'unda görünür; Output'u da kontrol edin.
-- Örnek: Power=1.2 %20 fazla motor kuvveti; MaxSpeed=120 daha düşük motor hız sınırı.
-- Örnek: Controls.Park="O" park tuşunu O yapar. Her işlem farklı tuş kullanmalı.
-- Birimler Roblox stud / saniye / kütledir; kg, metre veya gerçek beygir gücü değildir.
-- Power/TorqueScale HP değildir; oyun motor kuvvetine uygulanan çarpanlardır.
-- Geometri/mount/Wheels rehberi: docs/MODEL-INTEGRATION.md; ayrıntılar: docs/TUNING.md.
-- Desteklenen bütün alanlar aşağıda. Bilinmeyen A-Chassis alanları kabul edilmez.
return {
	SchemaVersion = 1, -- şema sürümü; değiştirmeyin

	-- 1 / MOTOR VE AKTARMA
	Drive = "RWD", -- FWD: ön / RWD: arka / AWD: dört teker çekiş
	Power = 1, -- 0.1..5; kuvvet çarpanı, 1.2 = %120
	TorqueScale = 4, -- 0.1..100; TorqueCurve kuvvet ölçeği; Power ile birlikte çarpılır
	MaxSpeed = 180, -- 5..600 stud/s; üstünde motor itişi kesilir; yokuş hızını kilitlemez
	Mass = 0, -- 0..5000; 0 mevcut Chassis kütlesi, &gt;0 kökün hedef Roblox kütlesi
	-- Yolcu ayrıca eklenir. Kütle / Chassis hacmi yoğunluğu 0.01..100 içinde olmalı.
	IdleRPM = 850, -- 100..5000; rölanti devri
	RedlineRPM = 7000, -- 1000..20000; devir üst sınırı ve HUD ölçeği
	ShiftDownRPM = 2100, -- 100..10000; vites küçültme eşiği
	ShiftUpRPM = 6100, -- 500..20000; vites büyütme eşiği
	-- Şart: IdleRPM &lt; ShiftDownRPM &lt; ShiftUpRPM &lt; RedlineRPM.
	ShiftTime = 0.3, -- 0.05..3 saniye; vites değişiminde çekişin %35'e düşme süresi
	FinalDrive = 3.7, -- 0.1..15; artırınca teker kuvveti/devir artar, vitesler kısalır
	ReverseRatio = 3.1, -- 0.1..10; geri vites oranı
	Gears = {3.2,2.1,1.5,1.12,0.88}, -- 1..10 pozitif oran; büyükten küçüğe
	TorqueCurve = {{850,95},{2500,150},{4500,175},{7000,110}}, -- {RPM,oyun torku}; 2..32 nokta
	-- RPM noktaları kesin artmalı; tork 0..100000; aralarında doğrusal geçiş.

	-- 2 / TEKER, SÜSPANSİYON VE VİRAJ DENGESİ
	-- Teker RPM = |yol hızı| / (2*pi*Radius) * 60; motor devri vites/final oranıyla farklıdır.
	-- Rölantide araç dururken tekerler durur; yalnızca görsel dönüş istemcide akıcıdır.
	Radius = 1.25, -- 0.1..10 stud; gerçek teker yarıçapına eşleştirin
	RestLength = 1.6, -- 0.1..10 stud; mount ile tam açık teker merkezi arası
	FrequencyHz = 3.5, -- 1..12; artarsa yay sertleşir ve statik çökme azalır
	DampingRatio = 0.85, -- 0.1..3; artarsa zıplama daha hızlı söner; aşırısı sertleştirir
	MaxLoad = 4, -- 1..10; teker başına statik ağırlığın azami katı
	-- RestLength &gt; Gravity/(2*pi*FrequencyHz)^2 + 0.1 olmalı; aksi durumda bind reddedilir.
	RollInfluence = 0.2, -- 0..1; lastik kuvvetinin dikey kolu; düşürmek yatmayı azaltır
	AntiRoll = 0.5, -- 0..2; aynı aksın yayları arası denge; artarsa yatış azalır
	RollDamping = 4, -- 0..20 /s; roll hızını söndürür; havada yönü kilitlemez
	-- Eski yatış: RollInfluence=1, AntiRoll=0, RollDamping=0.
	-- Önce Radius/mount/kütle doğru olsun. Fazla Grip ve yüksek yolcu merkezi devirme riskini artırır.

	-- 3 / LASTİK, FREN VE DİREKSİYON
	Grip = 1.2, -- 0.05..3; zemin Grip attribute'u ile çarpılan lastik tutuşu
	LateralResponse = 12, -- 0.1..40 /s; yan kaymayı düzeltme; artarsa daha keskin tutar
	BrakeAcceleration = 90, -- 1..500 stud/s^2; B / mobil fren dört tekeri frenler
	HandbrakeAcceleration = 110, -- 1..500; Space yalnızca arka tekerleri frenler
	RollingResistance = 0.015, -- 0..0.2; gazsız yuvarlanma direnci
	Drag = 0.025, -- 0..2; hızın karesiyle direnç; artırmak son hızı düşürür
	SteerDegrees = 32, -- 1..60 derece; düşük hız direksiyon açısı
	SteerResponse = 7, -- 0.1..30 /s; artarsa direksiyon daha çabuk döner
	SteerFadeSpeed = 100, -- 1..500 stud/s; hızla direksiyon azaltma ölçeği
	MinSteerFraction = 0.28, -- 0.05..1; yüksek hızda kalan açı oranı

	-- 4 / PARK VE KURTARMA
	ParkOnSpawn = false, -- true: araç ilk oluştuğunda park modunda başlar
	AutoParkOnExit = false, -- true: sürücü ayrılınca otomatik park isteği
	ParkBrakeAcceleration = 140, -- 1..500; P modunda dört teker fren kuvveti
	ParkEngageSpeed = 1.5, -- 0.1..3 stud/s; Stopping -&gt; Parked gösterge eşiği
	-- P: gaz kesilir, yavaşlayıp park eder. Tekrar P: sürüş serbest.
	-- Park isteği araçtan inince/zaman aşımında korunur. Araç Anchored olmaz; tutuş sınırı vardır.
	-- Space el freni bağımsızdır; HB durumu ayrıca görünür.
	AutoRecover = true, -- ters, yavaş, zemine yakın ve boş alan varsa düzelt
	RecoverDelay = 2, -- 0.5..15 saniye; devrik bekleme süresi
	RecoverMaxSpeed = 6, -- 0.1..15 stud/s; üstünde düzeltme bekler

	-- 5 / GÖSTERGE VE GÖRSEL EFEKTLER
	VFX = true, -- istemcide lastik dumanı / zemin tozu
	VFXIntensity = 1, -- 0..2; efekt yoğunluğu; 0 üretimi durdurur
	SpeedScale = 1, -- 0.01..10; görünen hız = stud/s * bu çarpan
	SpeedUnit = "STUD/S", -- 1..12 karakter; oyun ölçeğinize uygun etiket
	ShowControls = true, -- klavye yardımının ilk durumu; H ile gizlenebilir

	-- 6 / AĞ VE GÜNCELLEME
	InputTimeout = 0.35, -- 0.1..2 saniye; girdi kesilince gaz bırakılır ve fren uygulanır
	TelemetryHz = 10, -- 1..20 /s; HUD attribute sıklığı; fizik hızı değildir
	SleepAfter = 3, -- 0..30 saniye; boş/durgun araçta görsel işi azaltır; yay desteği sürer

	-- 7 / KLAVYE (Enum.KeyCode yerine string tuş adları)
	-- Harfler, Space, oklar, Left/RightShift, Left/RightControl, One..Five desteklenir.
	-- Her tuş benzersiz: Handbrake="P" isterseniz Park="O" gibi farklı tuş da verin.
	-- Mobil resimli düğmeler aynı işlemleri çağırır; klavye tuşlarından bağımsızdır.
	-- Gamepad: R2 gaz, L2 geri, B fren, A el freni, X park, Y çıkış, sol çubuk direksiyon.
	Controls = {
		Forward = "W", Reverse = "S", Left = "A", Right = "D",
		Brake = "B", Handbrake = "Space", Park = "P", Exit = "E", HideControls = "H",
	},
}
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="AXZF48">
      <Properties>
        <string name="Name">AXZFTests</string>
      </Properties>
      <Item class="ModuleScript" referent="AXZF49">
        <Properties>
          <string name="Name">DelayedTune</string>
          <ProtectedString name="Source">--!strict
-- Integration fixture for cancellation while a trusted configuration is loading.
assert(game:GetService("RunService"):IsStudio(),"Test fixture only")
task.wait(.2)
return {}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF50">
        <Properties>
          <string name="Name">DriveTest</string>
          <ProtectedString name="Source">--!strict
-- Integration harness intentionally kept outside runtime. It refuses live servers.
local RunService=game:GetService("RunService")
local Vehicle=require(game.ServerScriptService.AXZFServer.Vehicle)
return function(source: Model, overrides: any): any
	assert(RunService:IsStudio() and RunService:IsServer(),"Studio server tests only")
	local floor=Instance.new("Part") floor.Name="__AXZF_DriveFloor" floor.Anchored=true
	-- Stay below Roblox's per-part size limit, with a 2,000-stud braking lane.
	floor.Size=Vector3.new(200,1,2000) floor.CFrame=CFrame.new(1000,0,-900) floor.Parent=workspace
	local model=source:Clone() model.Name="__Prototype_AXZF_DriveTest"
	game:GetService("CollectionService"):RemoveTag(model,"AXZFVehicle")
	model.DriveSeat.Disabled=true
	model:PivotTo(CFrame.new(1000,5,20)) model.Parent=workspace
	local vehicle=nil local connection=nil local observations={}
	local ok,err=xpcall(function()
		vehicle=Vehicle.new(model,overrides)
		connection=RunService.PreSimulation:Connect(function(dt) vehicle:step(dt) end)
		local root=model.Chassis
		local function drive(seconds,throttle,steer,brake)
			local start=os.clock()
			repeat vehicle:setInput({throttle=throttle,steer=steer,brake=brake,handbrake=false}) task.wait(.05) until os.clock()-start&gt;=seconds
		end
		drive(3,0,0,1)
		observations.settled={height=root.Position.Y,upright=root.CFrame.UpVector.Y,verticalSpeed=root.AssemblyLinearVelocity.Y}
		drive(5,1,0,0)
		observations.accelerate={speed=root.AssemblyLinearVelocity.Magnitude,position=tostring(root.Position),upright=root.CFrame.UpVector.Y}
		drive(4,0,0,1)
		observations.brake={speed=root.AssemblyLinearVelocity.Magnitude}
		-- Fresh grounded pose avoids carrying acceleration-test position into steering trial.
		model:PivotTo(CFrame.new(1000,5,20)) root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
		drive(3,0,0,1) local forward=root.CFrame.LookVector
		drive(2,0.35,0.7,0)
		observations.steer={degrees=math.deg(math.acos(math.clamp(forward:Dot(root.CFrame.LookVector),-1,1))),upright=root.CFrame.UpVector.Y}
		vehicle:setInput({throttle=1,steer=0,brake=0,handbrake=false})
		task.wait(.5)
		observations.watchdog={age=vehicle.inputAge,expired=vehicle.inputAge&gt;vehicle.tune.InputTimeout}
		local before=#model:GetDescendants() vehicle:destroy() vehicle:destroy()
		local after=#model:GetDescendants()
		observations.cleanup={before=before,after=after,bound=model:GetAttribute("AXZFBound"),anchored=root.Anchored}
		local v2=Vehicle.new(model,overrides) v2:destroy() observations.rebind=true
		observations.pass=observations.settled.upright&gt;.9 and math.abs(observations.settled.verticalSpeed)&lt;5 and observations.accelerate.speed&gt;10 and observations.accelerate.upright&gt;.8 and observations.brake.speed&lt;3 and observations.steer.degrees&gt;5 and observations.steer.upright&gt;.8 and observations.watchdog.expired and observations.cleanup.anchored and observations.rebind
	end,debug.traceback)
	if connection then connection:Disconnect() end
	if vehicle then vehicle:destroy() end
	model:Destroy() floor:Destroy()
	if not ok then observations.error=tostring(err) observations.pass=false end
	return observations
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF51">
        <Properties>
          <string name="Name">FleetBenchmark</string>
          <ProtectedString name="Source">--!strict
-- Script solve time only. This is not an engine/GPU/MicroProfiler or network benchmark.
return function(count: number?): any
	assert(game:GetService("RunService"):IsStudio(),"Studio only")
	count=math.clamp(count or 12,1,40)
	local Car=require(game.ServerStorage.AXZFExamples.PrototypeCar)
	local Vehicle=require(game.ServerScriptService.AXZFServer.Vehicle)
	local cars,vehicles,samples={},{},{}
	local connection=nil
	local ok,err=xpcall(function()
		for i=1,count do
			local m=Car.create(CFrame.new(-30+((i-1)%4)*20,5,100-math.floor((i-1)/4)*20),"__Prototype_AXZF_Benchmark")
			m.DriveSeat.Disabled=true m.Parent=workspace table.insert(cars,m) table.insert(vehicles,Vehicle.new(m,nil))
		end
		connection=game:GetService("RunService").PreSimulation:Connect(function(dt)
			local now=os.clock()
			for _,v in ipairs(vehicles) do v:step(dt) end
			table.insert(samples,(os.clock()-now)*1000)
		end)
		task.wait(5)
	end,debug.traceback)
	if connection then connection:Disconnect() end
	for _,v in ipairs(vehicles) do v:destroy() end for _,m in ipairs(cars) do m:Destroy() end
	if not ok then return {pass=false,error=tostring(err)} end
	table.sort(samples) local total=0 for _,v in ipairs(samples) do total+=v end
	return {pass=true,vehicles=count,samples=#samples,meanMs=total/#samples,p95Ms=samples[math.ceil(#samples*.95)],maxMs=samples[#samples],raysPerStep=count*4,scope="script solve only; includes settled + initial drop",cleanup=true}
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF52">
        <Properties>
          <string name="Name">FleetTest</string>
          <ProtectedString name="Source">--!strict
return function(): any
	assert(game:GetService("RunService"):IsStudio(),"Studio only")
	local Fleet=require(game.ServerScriptService.AXZFServer.Fleet)
	local Car=require(game.ServerStorage.AXZFExamples.PrototypeCar)
	local tags=game:GetService("CollectionService")
	local fleet=Fleet.start({tag="__Prototype_AXZF_Fleet",remoteName="__Prototype_AXZF_Control"})
	local m=Car.create(CFrame.new(40,5,80)) m.DriveSeat.Disabled=true
	local report={} local ok,err=xpcall(function()
		tags:AddTag(m,"__Prototype_AXZF_Fleet") m.Parent=workspace task.wait(.1)
		report.preTaggedSpawn=fleet:get(m)~=nil
		fleet:add(m)
		local motors=0 for _,v in ipairs(m:GetDescendants()) do if v:IsA("Motor6D") then motors+=1 end end
		report.duplicateAddSafe=motors==4
		m.Parent=game.ServerStorage task.wait(.1) report.removalClean=fleet:get(m)==nil and not m:GetAttribute("AXZFBound")
		m.Parent=workspace task.wait(.1) report.returnRebind=fleet:get(m)~=nil
		tags:RemoveTag(m,"__Prototype_AXZF_Fleet") task.wait(.1) report.untagClean=fleet:get(m)==nil and m.Chassis.Anchored
		tags:AddTag(m,"__Prototype_AXZF_Fleet") task.wait(.1) report.retag=fleet:get(m)~=nil
		local config=m:FindFirstChild("Tune") if config then config:Destroy() end
		tags:RemoveTag(m,"__Prototype_AXZF_Fleet") task.wait(.05)
		config=game.ServerStorage.AXZFTests.DelayedTune:Clone() config.Name="Tune" config.Parent=m
		tags:AddTag(m,"__Prototype_AXZF_Fleet") task.wait(.05)
		tags:RemoveTag(m,"__Prototype_AXZF_Fleet") tags:AddTag(m,"__Prototype_AXZF_Fleet")
		task.wait(.4) report.pendingCancelRebind=fleet:get(m)~=nil and not m:GetAttribute("AXZFError")
		fleet:stop() fleet:stop() report.stopClean=not game.ReplicatedStorage.AXZF:FindFirstChild("__Prototype_AXZF_Control") and not m:GetAttribute("AXZFBound")
		report.pass=true for _,key in ipairs({"preTaggedSpawn","duplicateAddSafe","removalClean","returnRebind","untagClean","retag","pendingCancelRebind","stopClean"}) do if not report[key] then report.pass=false end end
	end,debug.traceback)
	fleet:stop() m:Destroy()
	if not ok then report.error=tostring(err) report.pass=false end
	return report
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF53">
        <Properties>
          <string name="Name">HandlingTest</string>
          <ProtectedString name="Source">--!strict
return function(): any
	assert(game:GetService("RunService"):IsStudio(),"Studio only")
	local Car=require(game.ServerStorage.AXZFExamples.PrototypeCar)
	local Vehicle=require(game.ServerScriptService.AXZFServer.Vehicle)
	local container=Instance.new("Folder") container.Name="__Prototype_AXZF_Handling" container.Parent=workspace
	local m=Car.create(CFrame.new(200,5,80)) m.DriveSeat.Disabled=true m.Parent=container
	local v=nil local connection=nil local result={}
	local ok,err=xpcall(function()
		v=Vehicle.new(m,nil)
		connection=game:GetService("RunService").PreSimulation:Connect(function(dt) v:step(dt) end)
		local root=m.Chassis
		local function command(seconds,throttle,brake,handbrake)
			local now=os.clock() repeat v:setInput({throttle=throttle,steer=0,brake=brake,handbrake=handbrake}) task.wait(.05) until os.clock()-now&gt;=seconds
		end
		task.wait(2)
		-- No ground within ray range: throttle must not accelerate in X/Z.
		m:PivotTo(CFrame.new(200,100,80)) root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
		command(.3,1,0,false)
		local horizontal=Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude
		result.airborne={horizontalSpeed=horizontal,pass=horizontal&lt;.1}
		-- Repeat on a dedicated flat contact surface; reset pose/velocity for each friction level.
		local ground=Instance.new("Part") ground.Name="GripPlate" ground.Anchored=true ground.Size=Vector3.new(60,1,400) ground.CFrame=CFrame.new(200,1,-40) ground.Parent=container
		local function gripTrial(grip)
			ground:SetAttribute("Grip",grip) m:PivotTo(CFrame.new(200,6,100)) root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
			command(2,0,1,false) command(1,1,0,false)
			return root.AssemblyLinearVelocity.Magnitude
		end
		local normal=gripTrial(1) local ice=gripTrial(.15)
		result.surfaceGrip={normalSpeed=normal,lowGripSpeed=ice,pass=ice&lt;normal*.6}
		ground:SetAttribute("Grip",1) command(3,0,0,true)
		result.handbrake={speed=root.AssemblyLinearVelocity.Magnitude,pass=root.AssemblyLinearVelocity.Magnitude&lt;3}
		m:PivotTo(CFrame.new(200,6,100)) root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
		command(2,0,1,false) command(1,-.5,0,false)
		result.reverse={signedSpeed=root.AssemblyLinearVelocity:Dot(root.CFrame.LookVector),pass=root.AssemblyLinearVelocity:Dot(root.CFrame.LookVector)&lt;-5}
		command(3,0,1,false)
		-- A moderate slope should remain finite/upright under gravity with brakes held.
		ground.CFrame=CFrame.new(200,1,-40)*CFrame.Angles(math.rad(8),0,0)
		m:PivotTo(CFrame.new(200,8,-40)*CFrame.Angles(math.rad(8),0,0)) root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
		command(3,0,1,false)
		result.slope={upright=root.CFrame.UpVector.Y,speed=root.AssemblyLinearVelocity.Magnitude,pass=root.CFrame.UpVector.Y&gt;.85 and root.AssemblyLinearVelocity.Magnitude&lt;5}
		result.pass=result.airborne.pass and result.surfaceGrip.pass and result.handbrake.pass and result.reverse.pass and result.slope.pass
	end,debug.traceback)
	if connection then connection:Disconnect() end if v then v:destroy() end container:Destroy()
	if not ok then result.pass=false result.error=tostring(err) end
	return result
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF54">
        <Properties>
          <string name="Name">InputGuard_Test</string>
          <ProtectedString name="Source">--!strict
return function(t)
	local G=require(game.ReplicatedStorage.AXZF.Shared.InputGuard) local e=t.expect
	local function p() return {seq=1,throttle=1,steer=-1,brake=0,handbrake=false} end
	-- Network payloads are finite, bounded, exact-shape intents with replay rejection.
	t.test("legal intent accepted",function() e.truthy(G.validate(p(),0)) end)
	t.test("replay rejected",function() e.falsy(G.validate(p(),1)) end)
	t.test("out of order rejected",function() e.falsy(G.validate(p(),2)) end)
	t.test("non-table rejected",function() e.falsy(G.validate("attack",0)) end)
	t.test("missing fields rejected",function() e.falsy(G.validate({seq=1},0)) end)
	t.test("extra authority fields rejected",function() local a=p() a.velocity=100 e.falsy(G.validate(a,0)) end)
	t.test("NaN input rejected",function() local a=p() a.throttle=0/0 e.falsy(G.validate(a,0)) end)
	t.test("infinite input rejected",function() local a=p() a.steer=math.huge e.falsy(G.validate(a,0)) end)
	t.test("negative brake rejected",function() local a=p() a.brake=-.1 e.falsy(G.validate(a,0)) end)
	t.test("overrange throttle rejected",function() local a=p() a.throttle=1.01 e.falsy(G.validate(a,0)) end)
	t.test("fractional sequence rejected",function() local a=p() a.seq=1.5 e.falsy(G.validate(a,0)) end)
	t.test("invalid boolean rejected",function() local a=p() a.handbrake=1 e.falsy(G.validate(a,0)) end)
	-- Token bucket uses injected time and caps stored burst credit.
	t.test("burst limited to 45 commands",function() local b={tokens=45,time=0} for _=1,45 do e.truthy(G.consume(b,0)) end e.falsy(G.consume(b,0)) end)
	t.test("bucket replenishes at 30 per second",function() local b={tokens=0,time=0} e.truthy(G.consume(b,1/30)) e.falsy(G.consume(b,1/30)) end)
	t.test("clock rollback grants no tokens",function() local b={tokens=0,time=5} e.falsy(G.consume(b,4)) end)
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF55">
        <Properties>
          <string name="Name">JitterTest</string>
          <ProtectedString name="Source">--!strict
-- PostSimulation measurements after warm-up. No pass is inferred from one frame.
return function(source: Model,overrides: any): any
	assert(game:GetService("RunService"):IsStudio(),"Studio only")
	local m=source:Clone() game:GetService("CollectionService"):RemoveTag(m,"AXZFVehicle")
	m.Name="__Prototype_AXZF_Jitter" m.DriveSeat.Disabled=true m:PivotTo(CFrame.new(0,5,80)) m.Parent=workspace
	local v=nil local connection=nil local result={}
	local ok,err=xpcall(function()
		v=require(game.ServerScriptService.AXZFServer.Vehicle).new(m,overrides)
		connection=game:GetService("RunService").PreSimulation:Connect(function(dt) v:step(dt) end)
		task.wait(3)
		local minY,maxY,sumV,sumW=math.huge,-math.huge,0,0
		for _=1,180 do
			game:GetService("RunService").PostSimulation:Wait()
			local root=m.Chassis minY=math.min(minY,root.Position.Y) maxY=math.max(maxY,root.Position.Y)
			sumV+=root.AssemblyLinearVelocity.Y^2 sumW+=root.AssemblyAngularVelocity.Magnitude^2
		end
		result={samples=180,heightRange=maxY-minY,rmsVy=math.sqrt(sumV/180),rmsAngular=math.sqrt(sumW/180)}
		result.pass=result.heightRange&lt;.02 and result.rmsVy&lt;.1 and result.rmsAngular&lt;.1
	end,debug.traceback)
	if connection then connection:Disconnect() end if v then v:destroy() end m:Destroy()
	if not ok then result.pass=false result.error=tostring(err) end
	return result
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF56">
        <Properties>
          <string name="Name">Math_Test</string>
          <ProtectedString name="Source">--!strict
return function(t)
	local M=require(game.ReplicatedStorage.AXZF.Shared.Math) local e=t.expect
	-- Non-finite numbers must never enter forces or network commands.
	t.test("finite rejects NaN",function() e.falsy(M.finite(0/0)) end)
	t.test("finite rejects infinity",function() e.falsy(M.finite(math.huge)) end)
	t.test("finite rejects string",function() e.falsy(M.finite("1")) end)
	t.test("finite accepts zero",function() e.truthy(M.finite(0)) end)
	-- Interpolation is bounded at both ends and linear between authored points.
	t.test("curve interpolates midpoint",function() e.near(M.curve({{0,0},{10,20}},5),10) end)
	t.test("curve clamps below range",function() e.equal(M.curve({{0,3},{10,20}},-100),3) end)
	t.test("curve clamps above range",function() e.equal(M.curve({{0,3},{10,20}},100),20) end)
	-- Combined demand cannot exceed the contact traction budget.
	t.test("friction circle caps diagonal force",function() local x,y=M.friction(3,4,2) e.near(math.sqrt(x*x+y*y),2) end)
	t.test("unloaded tire supplies zero force",function() local x,y=M.friction(3,4,0) e.equal(x+y,0) end)
	t.test("friction retains sublimit demand",function() local x,y=M.friction(3,4,10) e.equal(x,3) e.equal(y,4) end)
	-- Suspension force is unilateral and static equilibrium supports corner weight.
	t.test("spring equilibrium supports weight",function() local w=2*math.pi*3.5 e.near(M.spring(10,196.2,3.5,.85,196.2/(w*w),0,4),1962) end)
	t.test("extended spring never pulls downward",function() e.equal(M.spring(10,196.2,3.5,.85,-1,0,4),0) end)
	t.test("spring force respects load cap",function() e.near(M.spring(10,196.2,3.5,.85,100,-100,4),7848) end)
	-- Braking must oppose velocity without crossing through rest in one step.
	t.test("braking cannot reverse velocity",function() local f=M.braking(1,10000,10,.1) e.near(1+f*.1/10,0) end)
	t.test("braking reverses sign in reverse",function() e.truthy(M.braking(-1,100,10,.1)&gt;0) end)
	t.test("braking at rest is zero",function() e.equal(M.braking(0,100,10,.1),0) end)
	-- Steering geometry must tighten the inner wheel and mirror correctly.
	t.test("right inner wheel has greater angle",function() local l,r=M.ackermann(.3,6,5) e.truthy(r&gt;l and l&gt;0) end)
	t.test("Ackermann mirrors left and right",function() local l,r=M.ackermann(.3,6,5) local a,b=M.ackermann(-.3,6,5) e.near(a,-r) e.near(b,-l) end)
	t.test("straight wheels remain straight",function() local a,b=M.ackermann(0,6,5) e.equal(a+b,0) end)
	-- Exponential filtering is independent of frame subdivision.
	t.test("steering smoothing is dt consistent",function() e.near(M.approach(M.approach(0,1,7,.05),1,7,.05),M.approach(0,1,7,.1)) end)
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF57">
        <Properties>
          <string name="Name">MigrationTest</string>
          <ProtectedString name="Source">--!strict
-- Editor-only fixture: no Toolbox code is required or executed.
return function(): any
	assert(game.RunService:IsStudio() and not game.RunService:IsRunning(),"Edit-mode test only")
	local migration=require(game.ServerScriptService.AXZFServer.Migration)
	local m=require(game.ServerStorage.AXZFExamples.PrototypeCar).create()
	local previous=m:FindFirstChild("Tune") if previous then previous:Destroy() end
	local legacy=Instance.new("ModuleScript") legacy.Name="A-Chassis Tune" legacy.Parent=m
	local foreign=Instance.new("Script") foreign.Name="LegacyPlugin" foreign.Disabled=true foreign.Parent=m.Body
	local constraint=Instance.new("WeldConstraint") constraint.Parent=m.Chassis
	local count=#m:GetDescendants() local converted=nil local report={}
	local ok,err=xpcall(function()
		converted=migration.convert(m)
		report.sourcePreserved=#m:GetDescendants()==count and foreign.Parent==m.Body and constraint.Parent==m.Chassis
		local scripts=0 for _,v in ipairs(converted:GetDescendants()) do if v:IsA("LuaSourceContainer") then scripts+=1 end end
		report.onlyAuthoredTune=scripts==1 and converted.Tune:IsA("ModuleScript")
		report.validRig=require(game.ServerScriptService.AXZFServer.Doctor).inspect(converted).ok
		m.Wheels.FL:Destroy() report.missingWheelRejected=not pcall(migration.convert,m)
		local wrapper=Instance.new("Model") m.Parent=wrapper local clone=m:Clone() clone.Parent=wrapper
		report.ambiguousSelectionRejected=not pcall(migration.convert,wrapper)
		m.Parent=nil wrapper:Destroy()
		report.pass=report.sourcePreserved and report.onlyAuthoredTune and report.validRig and report.missingWheelRejected and report.ambiguousSelectionRejected
	end,debug.traceback)
	if converted then converted:Destroy() end m:Destroy()
	if not ok then report.pass=false report.error=tostring(err) end
	return report
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF60">
        <Properties>
          <string name="Name">ParkingTest</string>
          <ProtectedString name="Source">--!strict
return function(source: Model,overrides: any): any
	local Run=game:GetService("RunService") assert(Run:IsStudio() and Run:IsServer(),"Studio server only")
	local m=source:Clone() game:GetService("CollectionService"):RemoveTag(m,"AXZFVehicle") m.Name="__AXZF_ParkingTest" m.DriveSeat.Disabled=true
	m:PivotTo(CFrame.new(1100,6,50)) m.Parent=workspace
	local floor=Instance.new("Part") floor.Name="__AXZF_ParkFloor" floor.Anchored=true floor.Size=Vector3.new(100,1,500) floor.Position=Vector3.new(1100,0,0) floor.Parent=workspace
	local v=nil local connection=nil local result={}
	local ok,err=xpcall(function()
		v=require(game.ServerScriptService.AXZFServer.Vehicle).new(m,overrides)
		connection=Run.PreSimulation:Connect(function(dt) v:step(dt) end)
		local root=m.Chassis
		local function command(seconds,park,throttle)
			local start=os.clock() repeat v:setInput({throttle=throttle,steer=0,brake=0,handbrake=false,park=park}) task.wait(.05) until os.clock()-start&gt;=seconds
		end
		task.wait(2) root.AssemblyLinearVelocity=root.CFrame.LookVector*45
		v:setPark(true) v:step(1/60) result.moving=v:getTelemetry().parkState
		command(2,true,1) result.parkSpeed=root.AssemblyLinearVelocity.Magnitude result.state=v:getTelemetry().parkState
		v:clearInput() task.wait(.5) result.retained=v.parkRequested
		result.handbrake=v:getTelemetry().handbrake result.anchored=root.Anchored
		command(1,false,1) result.releasedSpeed=root.AssemblyLinearVelocity.Magnitude
		floor.CFrame=CFrame.new(1100,0,0)*CFrame.Angles(math.rad(8),0,0)
		m:PivotTo(CFrame.new(1100,6,0)*CFrame.Angles(math.rad(8),0,0)) root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
		command(3,true,1) result.slopeSpeed=root.AssemblyLinearVelocity.Magnitude
		result.pass=result.moving=="Stopping" and result.parkSpeed&lt;1.5 and result.state=="Parked" and result.retained and not result.handbrake and not result.anchored and result.releasedSpeed&gt;5 and result.slopeSpeed&lt;.1
	end,debug.traceback)
	if connection then connection:Disconnect() end if v then v:destroy() end m:Destroy() floor:Destroy()
	if not ok then result.pass=false result.error=tostring(err) end return result
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF61">
        <Properties>
          <string name="Name">Parking_Test</string>
          <ProtectedString name="Source">--!strict
return function(t)
	local P=require(game.ReplicatedStorage.AXZF.Shared.Parking) local e=t.expect
	local G=require(game.ReplicatedStorage.AXZF.Shared.InputGuard)
	t.test("parking brakes while moving",function() e.equal(P.state(true,40,1.5),"Stopping") end)
	t.test("parking engages at low speed",function() e.equal(P.state(true,.2,1.5),"Parked") end)
	t.test("parking releases at any speed",function() e.equal(P.state(false,40,1.5),"Drive") end)
	t.test("parking rebrakes after external push",function() e.equal(P.state(true,4,1.5),"Stopping") end)
	t.test("optional park packet preserves old clients",function() e.truthy(G.validate({seq=1,throttle=0,steer=0,brake=0,handbrake=false},0)) end)
	t.test("park packet must be boolean",function() e.falsy(G.validate({seq=1,throttle=0,steer=0,brake=0,handbrake=false,park=1},0)) end)
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF62">
        <Properties>
          <string name="Name">Powertrain_Test</string>
          <ProtectedString name="Source">--!strict
return function(t)
	local Shared=game.ReplicatedStorage.AXZF.Shared local P=require(Shared.Powertrain) local T=require(Shared.Tune) local e=t.expect
	-- Forward/reverse requests must brake before reversing a moving vehicle.
	t.test("forward throttle produces forward force",function() local p=P.new(T.resolve(nil)) local f=p:step(0,1,.02) e.truthy(f&gt;0) end)
	t.test("reverse from rest produces reverse force",function() local p=P.new(T.resolve(nil)) local f=p:step(0,-1,.02) e.truthy(f&lt;0) end)
	t.test("reverse at forward speed brakes first",function() local p=P.new(T.resolve(nil)) local f,b=p:step(30,-1,.02) e.equal(f,0) e.equal(b,1) end)
	t.test("zero throttle supplies zero drive force",function() local p=P.new(T.resolve(nil)) local f=p:step(30,0,.02) e.equal(f,0) end)
	t.test("rev limiter cuts positive force",function() local p=P.new(T.resolve(nil)) p.gear=5 local f=p:step(1000,1,.02) e.equal(f,0) end)
	t.test("automatic gearbox upshifts at high RPM",function() local p=P.new(T.resolve(nil)) p:step(80,1,.02) e.equal(p.gear,2) end)
	t.test("automatic gearbox downshifts at low RPM",function() local p=P.new(T.resolve(nil)) p.gear=3 p:step(1,1,.02) e.equal(p.gear,2) end)
	t.test("shift cooldown prevents gear hunting",function() local p=P.new(T.resolve(nil)) p:step(80,1,.02) p:step(80,1,.02) e.equal(p.gear,2) end)
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="AXZF63">
        <Properties>
          <string name="Name">RecoveryTest</string>
          <ProtectedString name="Source">--!strict
return function(): any
	assert(game:GetService("RunService"):IsStudio(),"Studio only")
	local floor=Instance.new("Part") floor.Name="__AXZF_RecoveryFloor" floor.Anchored=true
	floor.Size=Vector3.new(50,1,50) floor.CFrame=CFrame.new(150,0,30) floor.Parent=workspace
	local m=require(game.ServerStorage.AXZFExamples.PrototypeCar).create(CFrame.new(150,5,30))
	m.Name="__Prototype_AXZF_Recovery"
	m.DriveSeat.Disabled=true m.Parent=workspace
	local v=nil local connection=nil local obstruction=nil local r={}
	local ok,err=xpcall(function()
		v=require(game.ServerScriptService.AXZFServer.Vehicle).new(m,{RecoverDelay=.5})
		connection=game:GetService("RunService").PreSimulation:Connect(function(dt) v:step(dt) end)
		task.wait(2) m:PivotTo(CFrame.new(150,4,30)*CFrame.Angles(0,0,math.pi)) m.Chassis.AssemblyLinearVelocity=Vector3.zero m.Chassis.AssemblyAngularVelocity=Vector3.zero
		task.wait(3) r.invertedRecovered=m.Chassis.CFrame.UpVector.Y&gt;.9 and v.recovery.count==1
		local count=v.recovery.count
		m:PivotTo(CFrame.new(150,40,30)*CFrame.Angles(0,0,math.pi)) m.Chassis.AssemblyLinearVelocity=Vector3.new(0,-10,0)
		task.wait(.25) r.airborneNotTeleported=v.recovery.count==count
		m:PivotTo(CFrame.new(150,5,30)) m.Chassis.AssemblyLinearVelocity=Vector3.zero m.Chassis.AssemblyAngularVelocity=Vector3.zero
		task.wait(2) r.uprightUntouched=v.recovery.count==count
		-- Wait out the real cooldown, then block the target upright volume.
		task.wait(5)
		obstruction=Instance.new("Part") obstruction.Name="__AXZF_RecoveryCeiling" obstruction.Anchored=true
		obstruction.Size=Vector3.new(30,1,30) obstruction.CFrame=CFrame.new(150,4.5,30) obstruction.Parent=workspace
		m:PivotTo(CFrame.new(150,1.3,30)*CFrame.Angles(0,0,math.pi)) m.Chassis.AssemblyLinearVelocity=Vector3.zero m.Chassis.AssemblyAngularVelocity=Vector3.zero
		task.wait(1.5) r.blockedSpaceWaits=v.recovery.count==count and m:GetAttribute("AXZF_recovery")=="Waiting for space"
		obstruction:Destroy() obstruction=nil
		task.wait(1.5) r.recoversWhenClear=v.recovery.count==count+1
		r.pass=r.invertedRecovered and r.airborneNotTeleported and r.uprightUntouched and r.blockedSpaceWaits and r.recoversWhenClear
	end,debug.traceback)
	if connection then connection:Disconnect() end if v then v:destroy() end if obstruction then obstruction:Destroy() end m:Destroy() floor:Destroy()
	if not ok then r.pass=false r.error=tostring(err) end
	return r
end
</ProtectedString>
        </Properties>

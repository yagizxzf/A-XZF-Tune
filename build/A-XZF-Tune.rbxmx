          <Item class="ModuleScript" referent="AXZF31">
            <Properties>
              <string name="Name">Data_Recovery</string>
              <ProtectedString name="Source">-- generated by roblox-ui-maker/scripts/gen.py from states.html (do not edit; edit the HTML and re-run)
return [==[{"c":"Frame","n":"Recovery","x":0,"y":0,"w":0,"h":0,"sw":1,"sh":1,"k":[{"c":"Frame","n":"Recovery","x":0.0,"y":120,"sx":0.5,"sy":0,"ax":0.5,"ay":0,"w":500,"h":68,"k":[{"c":"Frame","n":"RecoveryPanel","w":500,"h":68,"bg":[13,20,25],"bt":0.06,"corner":{"o":8},"stroke":{"t":1,"c":[58,75,85],"tr":0,"pos":"Inner","mode":"Border"},"k":[{"c":"Frame","n":"RecoveryText","w":460,"h":27,"k":[{"c":"TextLabel","txt":"AUTO RECOVERY \u00b7 CHECKING CLEARANCE","font":"Arial","wt":700,"xa":"L","n":"T_AutoRecoveryCheckingClea","w":428.56,"h":24.3,"ts":24.3,"tc":[255,188,99],"x":0,"y":-0.15}],"x":21,"y":23}],"x":0,"y":0}],"attrs":{"Anchor":"T"}}],"visible":false,"attrs":{"Dim":0}}]==]

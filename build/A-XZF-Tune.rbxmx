        <Item class="ModuleScript" referent="AXZF13">
          <Properties>
            <string name="Name">Doctor</string>
            <ProtectedString name="Source">--!strict
local Doctor={}
local ids={"FL","FR","RL","RR"}
function Doctor.hub(wheel: Instance?): BasePart?
	if wheel and wheel:IsA("BasePart") then return wheel end
	if wheel and wheel:IsA("Model") then return wheel.PrimaryPart end
	return nil
end
function Doctor.inspect(model: any): any
	local errors, warnings={},{}
	local function fail(code,message) table.insert(errors,{code=code,message=message}) end
	if typeof(model)~="Instance" or not model:IsA("Model") then
		fail("MODEL","Expected a Model") return {ok=false,errors=errors,warnings=warnings}
	end
	local root=model:FindFirstChild("Chassis")
	local seat=model:FindFirstChild("DriveSeat")
	local wheels=model:FindFirstChild("Wheels")
	local body=model:FindFirstChild("Body")
	if not root or not root:IsA("BasePart") then fail("ROOT","Add a Chassis BasePart facing local -Z") end
	if not seat or not seat:IsA("VehicleSeat") then fail("SEAT","Add DriveSeat (VehicleSeat)") end
	if not body then fail("BODY","Add Body folder/model containing your separate panels") end
	if not wheels then fail("WHEELS","Add Wheels containing FL/FR/RL/RR") end
	local hubs={}
	for _,id in ipairs(ids) do
		local mount=root and root:FindFirstChild(id)
		if not mount or not mount:IsA("Attachment") then fail("MOUNT_"..id,"Chassis needs Attachment "..id) end
		local hub=Doctor.hub(wheels and wheels:FindFirstChild(id))
		if not hub then fail("HUB_"..id,"Wheel "..id.." must be BasePart or Model with PrimaryPart")
		elseif hubs[hub] then fail("DUPLICATE_HUB","Each wheel needs its own hub") else hubs[hub]=true end
	end
	local count=0
	for _,v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart") then count+=1 end
		if v:IsA("LuaSourceContainer") and not (v:IsA("ModuleScript") and v.Name=="Tune" and v.Parent==model) then fail("SCRIPT","Remove previous chassis code: "..v:GetFullName()) end
		if v:IsA("Constraint") or v:IsA("WeldConstraint") or v:IsA("JointInstance") or v:IsA("BodyMover") then fail("MECHANICS","Remove previous joints/constraints: "..v.Name) end
	end
	if root and root:IsA("BasePart") then
		local fl,fr,rl,rr=root:FindFirstChild("FL"),root:FindFirstChild("FR"),root:FindFirstChild("RL"),root:FindFirstChild("RR")
		if fl and fr and rl and rr and fl:IsA("Attachment") and fr:IsA("Attachment") and rl:IsA("Attachment") and rr:IsA("Attachment") then
			if fl.Position.X&gt;=fr.Position.X or rl.Position.X&gt;=rr.Position.X or fl.Position.Z&gt;=rl.Position.Z or fr.Position.Z&gt;=rr.Position.Z then fail("LAYOUT","Front = -Z, left = -X; check wheel labels/orientation") end
			if (fl.Position-fr.Position).Magnitude&lt;0.5 or (fl.Position-rl.Position).Magnitude&lt;0.5 then fail("SPACING","Wheel spacing must exceed 0.5 studs") end
		end
	end
	if count&gt;200 then table.insert(warnings,{code="PART_COUNT",message="Over 200 parts; measure replication/render cost"}) end
	return {ok=#errors==0,errors=errors,warnings=warnings,parts=count}
end
return Doctor
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="AXZF14">
          <Properties>
            <string name="Name">Fleet</string>
            <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local CollectionService=game:GetService("CollectionService")
local Guard=require(game:GetService("ReplicatedStorage").AXZF.Shared.InputGuard)
local Vehicle=require(script.Parent.Vehicle)
local Fleet={}
Fleet.__index=Fleet
function Fleet.start(options: any): any
	assert(RunService:IsServer(),"Fleet runs on server")
	options=options or {}
	local tag=options.tag or "AXZFVehicle"
	local remoteName=options.remoteName or "Control"
	local packageRoot=game:GetService("ReplicatedStorage").AXZF
	assert(not packageRoot:FindFirstChild(remoteName),"Fleet already started")
	-- Prepare presentation for both Bootstrap and applications that start Fleet directly.
	local ui=packageRoot:FindFirstChild("UI")
	if remoteName=="Control" and ui and not packageRoot:FindFirstChild("CockpitTemplate") then
		require(ui.Builder).build()
		local template=game:GetService("StarterGui").AXZFCockpit
		template.Name="CockpitTemplate" template.Enabled=false template.Parent=packageRoot
	end
	local remote=Instance.new("RemoteEvent") remote.Name=remoteName remote.Parent=packageRoot
	local self=setmetatable({vehicles={},pending={},queued={},connections={},buckets={},remote=remote,stopped=false},Fleet)
	if remoteName=="Control" and packageRoot.Parent:FindFirstChild("VFX") then self.effects=require(script.Parent.VFXService).new() end
	local function connect(signal,fn) table.insert(self.connections,signal:Connect(fn)) end
	function self:remove(model)
		self.queued[model]=nil self.pending[model]=nil
		local entry=self.vehicles[model] if not entry then return end
		self.vehicles[model]=nil
		for _,c in ipairs(entry.connections) do c:Disconnect() end
		entry.vehicle:destroy()
	end
	function self:add(model)
		if self.stopped or self.vehicles[model] or self.pending[model] or not model:IsDescendantOf(workspace) then return end
		local token={} self.pending[model]=token
		local ok,vehicle=pcall(function()
			local config=model:FindFirstChild("Tune")
			local overrides=nil
			if config then assert(config:IsA("ModuleScript"),"Tune must be ModuleScript") overrides=require(config) end
			return Vehicle.new(model,overrides)
		end)
		local cancelled=self.pending[model]~=token
		if not cancelled then self.pending[model]=nil end
		if cancelled or self.stopped or not model:IsDescendantOf(workspace) then if ok then vehicle:destroy() end return end
		if not ok then model:SetAttribute("AXZFError",tostring(vehicle)) warn("[A-XZF-Tune] "..model.Name..": "..tostring(vehicle)) return end
		model:SetAttribute("AXZFError",nil)
		if self.effects then vehicle.onEffect=function(name,at,intensity) self.effects:send(name,at,intensity) end end
		for action,key in pairs(vehicle.tune.Controls) do model:SetAttribute("AXZF_Key"..action,key) end
		for _,key in ipairs({"SpeedUnit","SpeedScale","ShowControls","RedlineRPM","IdleRPM","VFX","VFXIntensity"}) do model:SetAttribute("AXZF_Config"..key,vehicle.tune[key]) end
		local entry={vehicle=vehicle,lastSequence=0,driver=nil,connections={}}
		self.vehicles[model]=entry
		local function occupantChanged()
			entry.lastSequence=0 entry.vehicle:clearInput()
			local humanoid=vehicle.rig.seat.Occupant
			entry.driver=if humanoid then Players:GetPlayerFromCharacter(humanoid.Parent) else nil
		end
		table.insert(entry.connections,vehicle.rig.seat:GetPropertyChangedSignal("Occupant"):Connect(occupantChanged))
		table.insert(entry.connections,model.AncestryChanged:Connect(function() if not model:IsDescendantOf(workspace) then self:remove(model) end end))
		occupantChanged()
	end
	connect(remote.OnServerEvent,function(player,model,packet)
		local now=os.clock() local bucket=self.buckets[player]
		if not bucket then bucket={tokens=45,time=now} self.buckets[player]=bucket end
		if not Guard.consume(bucket,now) then return end
		if typeof(model)~="Instance" then return end
		local entry=self.vehicles[model] if not entry or entry.driver~=player then return end
		local occupant=entry.vehicle.rig.seat.Occupant
		if not occupant or occupant.Health&lt;=0 or occupant.Parent~=player.Character then return end
		if not Guard.validate(packet,entry.lastSequence) then return end
		entry.lastSequence=packet.seq entry.vehicle:setInput(packet)
	end)
	connect(Players.PlayerRemoving,function(player)
		self.buckets[player]=nil
		for _,entry in pairs(self.vehicles) do if entry.driver==player then entry.driver=nil entry.vehicle:clearInput() end end
	end)
	local function enqueue(model)
		if self.queued[model] or self.vehicles[model] then return end
		self.queued[model]=true
		task.defer(function()
			-- Parenting signals can fire before Roblox finishes rebuilding the assembly.
			RunService.Heartbeat:Wait()
			if self.queued[model] then self.queued[model]=nil self:add(model) end
		end)
	end
	connect(CollectionService:GetInstanceAddedSignal(tag),enqueue)
	connect(CollectionService:GetInstanceRemovedSignal(tag),function(model) self:remove(model) end)
	connect(workspace.DescendantAdded,function(v) if v:IsA("Model") and CollectionService:HasTag(v,tag) then enqueue(v) end end)
	connect(RunService.PreSimulation,function(dt)
		for model,entry in pairs(self.vehicles) do
			local ok,err=pcall(entry.vehicle.step,entry.vehicle,dt)
			if not ok then warn("[A-XZF-Tune] vehicle quarantined: "..tostring(err)) self:remove(model) model:SetAttribute("AXZFError",tostring(err)) end
		end
	end)
	for _,model in ipairs(CollectionService:GetTagged(tag)) do self:add(model) end
	return self
end
function Fleet:get(model: Model): any
	local entry=self.vehicles[model] return if entry then entry.vehicle else nil
end
function Fleet:stop()
	if self.stopped then return end self.stopped=true
	table.clear(self.queued) table.clear(self.pending)
	for _,c in ipairs(self.connections) do c:Disconnect() end
	local models={} for model in pairs(self.vehicles) do table.insert(models,model) end
	for _,model in ipairs(models) do self:remove(model) end
	self.remote:Destroy() table.clear(self.buckets)
	if self.effects then self.effects:destroy() end
end
return Fleet
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="AXZF15">
          <Properties>
            <string name="Name">Migration</string>
            <ProtectedString name="Source">--!strict
-- Editor-only geometry migration. Never requires legacy Tune/plugins/scripts.
local Doctor=require(script.Parent.Doctor)
local Migration={}
local ids={"FL","FR","RL","RR"}
local function findSource(wrapper)
	local candidates={}
	local all={wrapper} for _,v in ipairs(wrapper:GetDescendants()) do table.insert(all,v) end
	for _,v in ipairs(all) do
		if v:IsA("Model") and v:FindFirstChild("DriveSeat") and v:FindFirstChild("Wheels") and v:FindFirstChild("A-Chassis Tune") then table.insert(candidates,v) end
	end
	assert(#candidates==1,"Select exactly one A-Chassis vehicle (DriveSeat + Wheels + A-Chassis Tune)")
	return candidates[1]
end
local function geometry(instance,report)
	local copy=instance:Clone()
	for _,v in ipairs(copy:GetDescendants()) do
		if not (v:IsA("BasePart") or v:IsA("Model") or v:IsA("Folder") or v:IsA("DataModelMesh") or v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance")) then v:Destroy() report.stripped+=1 end
	end
	for _,v in ipairs(copy:GetDescendants()) do if v:IsA("BasePart") then v.Anchored=true end end
	if copy:IsA("BasePart") then copy.Anchored=true end
	return copy
end
function Migration.inspect(wrapper: Model): any
	assert(not game:GetService("RunService"):IsRunning(),"Migrate only in Edit mode")
	local source=findSource(wrapper)
	local scripts=0 local parts=0
	for _,v in ipairs(source:GetDescendants()) do if v:IsA("LuaSourceContainer") then scripts+=1 end if v:IsA("BasePart") then parts+=1 end end
	for _,id in ipairs(ids) do assert(Doctor.hub(source.Wheels:FindFirstChild(id)),"Unsupported wheel "..id..": choose a PrimaryPart before migration") end
	return {source=source,sourcePath=source:GetFullName(),legacyScripts=scripts,sourceParts=parts}
end
function Migration.convert(wrapper: Model, options: any): (Model, any)
	options=options or {}
	local report=Migration.inspect(wrapper) local source=report.source report.source=nil report.stripped=0
	local model=Instance.new("Model") model.Name=options.name or source.Name.."_AXZF"
	local ok,err=pcall(function()
		local wheels=Instance.new("Folder") wheels.Name="Wheels" wheels.Parent=model
		local centers={} local center=Vector3.zero local radius=0
		for _,id in ipairs(ids) do
			local oldWheel=source.Wheels[id] local oldHub=Doctor.hub(oldWheel) :: BasePart
			local hub=oldHub:Clone()
			-- Keep the wheel's render mesh and documented art Parts only. No arms/suspension.
			for _,child in ipairs(hub:GetChildren()) do
				if not child:IsA("DataModelMesh") and child.Name~="Parts" then child:Destroy() end
			end
			local safe=geometry(hub,report) hub:Destroy() hub=safe
			local wheel=Instance.new("Model") wheel.Name=id wheel.Parent=wheels hub.Name="Hub" hub.Parent=wheel wheel.PrimaryPart=hub
			centers[id]=hub.Position center+=hub.Position/4
			radius+=math.max(oldHub.Size.X,oldHub.Size.Y,oldHub.Size.Z)/8
		end
		radius=options.radius or radius
		local forward=((centers.FL+centers.FR)-(centers.RL+centers.RR))/2
		forward=Vector3.new(forward.X,0,forward.Z) assert(forward.Magnitude&gt;.5,"Wheelbase is too short")
		local frame=CFrame.lookAt(center+Vector3.new(0,.7,0),center+Vector3.new(0,.7,0)+forward.Unit)
		local localFL=frame:PointToObjectSpace(centers.FL) local localFR=frame:PointToObjectSpace(centers.FR)
		local localRL=frame:PointToObjectSpace(centers.RL)
		assert(localFL.X&lt;localFR.X,"Legacy wheel labels are mirrored; correct FL/FR first")
		local track=math.abs(localFR.X-localFL.X) local wheelbase=math.abs(localRL.Z-localFL.Z)
		local root=Instance.new("Part") root.Name="Chassis" root.Size=Vector3.new(track*.85,.7,wheelbase*.9)
		root.CFrame=frame root.Anchored=true root.Transparency=1 root.CustomPhysicalProperties=PhysicalProperties.new(1.2,.3,0,100,100) root.Parent=model model.PrimaryPart=root
		local body=Instance.new("Folder") body.Name="Body" body.Parent=model
		for _,group in ipairs({"Body","Misc"}) do
			local sourceGroup=source:FindFirstChild(group)
			if sourceGroup then local copy=geometry(sourceGroup,report) copy.Name="Visual"..group copy.Parent=body end
		end
		local seat=Instance.new("VehicleSeat") seat.Name="DriveSeat" seat.Size=source.DriveSeat.Size seat.CFrame=source.DriveSeat.CFrame
		seat.Anchored=true seat.HeadsUpDisplay=false seat.Parent=model
		local rest=options.restLength or 1.6
		for _,id in ipairs(ids) do
			local mount=Instance.new("Attachment") mount.Name=id mount.Position=frame:PointToObjectSpace(centers[id])+Vector3.new(0,rest,0) mount.Parent=root
		end
		local config=game.ServerStorage.AXZFExamples.VehicleTune:Clone() config.Name="Tune"
		local text=config.Source
		local values={Radius=radius,RestLength=rest,Drive=options.drive or "RWD"}
		for key,value in pairs(values) do
			local literal=if type(value)=="string" then string.format("%q",value) else tostring(value)
			text=string.gsub(text,"(\n%s*"..key.."%s*=%s*)[^,\n]+,",function(prefix) return prefix..literal.."," end,1)
		end
		config.Source=text config.Parent=model
		report.radius=radius report.track=track report.wheelbase=wheelbase report.doctor=Doctor.inspect(model)
		assert(report.doctor.ok,game:GetService("HttpService"):JSONEncode(report.doctor.errors))
		report.parts=report.doctor.parts report.legacyScriptsRemaining=0
		for _,v in ipairs(model:GetDescendants()) do
			if v:IsA("LuaSourceContainer") and v~=config then report.legacyScriptsRemaining+=1 end
		end
		assert(report.legacyScriptsRemaining==0,"Unexpected executable content after migration")
		model:SetAttribute("AXZF_MigratedFrom",report.sourcePath)
		model:SetAttribute("SourceAsset",options.assetId or "user-supplied")
		if options.at then model:PivotTo(options.at) end
	end)
	if not ok then model:Destroy() error(err,2) end
	return model,report
end
-- One Command Bar call on a selected model; original remains in its storage location.
function Migration.fromSelection(options: any): (Model,any)
	assert(not game:GetService("RunService"):IsRunning(),"Migrate only in Edit mode")
	local selected=game:GetService("Selection"):Get()
	assert(#selected==1 and selected[1]:IsA("Model"),"Select one vehicle Model in Explorer")
	local model,report=Migration.convert(selected[1],options)
	model.Parent=workspace
	game:GetService("CollectionService"):AddTag(model,"AXZFVehicle")
	game:GetService("Selection"):Set({model})
	return model,report
end
return Migration
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="AXZF16">
          <Properties>
            <string name="Name">Recovery</string>
            <ProtectedString name="Source">--!strict
local Recovery={}
Recovery.__index=Recovery
function Recovery.new(rig: any,tune: any): any
	return setmetatable({rig=rig,tune=tune,inverted=0,cooldown=0,count=0},Recovery)
end
function Recovery:step(dt: number): boolean
	local root=self.rig.root local t=self.tune
	self.cooldown=math.max(0,self.cooldown-dt)
	if not t.AutoRecover or self.cooldown&gt;0 or root.CFrame.UpVector.Y&gt;0.2 or root.AssemblyLinearVelocity.Magnitude&gt;t.RecoverMaxSpeed then
		if self.rig.model:GetAttribute("AXZF_recovery")=="Waiting for space" then self.rig.model:SetAttribute("AXZF_recovery",nil) end
		self.inverted=0 return false
	end
	local params=RaycastParams.new() params.FilterType=Enum.RaycastFilterType.Exclude
	local excluded={self.rig.model}
	if self.rig.seat.Occupant then table.insert(excluded,self.rig.seat.Occupant.Parent) end
	params.FilterDescendantsInstances=excluded params.RespectCanCollide=true
	local ground=workspace:Raycast(root.Position,Vector3.new(0,-12,0),params)
	if not ground or ground.Normal.Y&lt;0.7 or math.abs(root.AssemblyLinearVelocity.Y)&gt;3 then self.inverted=0 return false end
	self.inverted+=dt
	if self.inverted&lt;t.RecoverDelay then return false end
	local oldRoot=root.CFrame
	local box,size=self.rig.model:GetBoundingBox()
	local offset=oldRoot:ToObjectSpace(box)
	local forward=Vector3.new(oldRoot.LookVector.X,0,oldRoot.LookVector.Z)
	if forward.Magnitude&lt;0.1 then forward=Vector3.new(0,0,-1) end
	local orientation=CFrame.lookAt(Vector3.zero,forward.Unit)
	local transformed=orientation*offset
	local verticalExtent=(math.abs(transformed.RightVector.Y)*size.X+math.abs(transformed.UpVector.Y)*size.Y+math.abs(transformed.LookVector.Y)*size.Z)/2
	local height=verticalExtent-transformed.Position.Y+0.35
	local target=CFrame.new(ground.Position+Vector3.new(0,height,0))*orientation
	local overlap=OverlapParams.new() overlap.FilterType=Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances=excluded overlap.RespectCanCollide=true
	if #workspace:GetPartBoundsInBox(target*offset,size+Vector3.new(.1,.1,.1),overlap)&gt;0 then
		self.rig.model:SetAttribute("AXZF_recovery","Waiting for space") return false
	end
	self.rig.model:PivotTo(target*oldRoot:Inverse()*self.rig.model:GetPivot())
	root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
	self.count+=1 self.cooldown=5 self.inverted=0
	self.rig.model:SetAttribute("AXZF_recoveryCount",self.count)
	self.rig.model:SetAttribute("AXZF_recovery","Recovered")
	return true
end
return Recovery
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="AXZF17">
          <Properties>
            <string name="Name">Rig</string>
            <ProtectedString name="Source">--!strict
local Doctor=require(script.Parent.Doctor)
local Rig={}
function Rig.bind(model: Model): any
	assert(not model:GetAttribute("AXZFBound"),"Vehicle already bound")
	local report=Doctor.inspect(model)
	assert(report.ok,"Rig rejected: "..game:GetService("HttpService"):JSONEncode(report.errors))
	local root=model.Chassis :: BasePart
	local self={model=model,root=root,seat=model.DriveSeat,wheels={},created={},snapshots={},destroyed=false}
	local ownership=nil
	local seatHud=self.seat.HeadsUpDisplay
	if game:GetService("RunService"):IsRunning() and root:CanSetNetworkOwnership() then ownership={automatic=root:GetNetworkOwnershipAuto(),owner=root:GetNetworkOwner()} end
	local function own(instance) table.insert(self.created,instance) return instance end
	local function weld(a,b)
		local w=own(Instance.new("WeldConstraint")) w.Name="AXZF_Weld" w.Part0=a w.Part1=b w.Parent=a
	end
	function self:destroy()
		if self.destroyed then return end self.destroyed=true
		if self.seat.Occupant then self.seat.Occupant.Sit=false end
		local seatWeld=self.seat:FindFirstChild("SeatWeld") if seatWeld then seatWeld:Destroy() end
		for i=#self.created,1,-1 do self.created[i]:Destroy() end
		for p,s in pairs(self.snapshots) do
			if p.Parent then for key,value in pairs(s) do p[key]=value end end
		end
		model:SetAttribute("AXZFBound",nil)
		if self.seat.Parent then self.seat.HeadsUpDisplay=seatHud end
		if ownership and root.Parent and root:CanSetNetworkOwnership() then
			if ownership.automatic then root:SetNetworkOwnershipAuto() else root:SetNetworkOwner(ownership.owner) end
		end
	end
	local ok,err=pcall(function()
		for _,p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				self.snapshots[p]={Anchored=p.Anchored,Massless=p.Massless,CanCollide=p.CanCollide,CanQuery=p.CanQuery,RootPriority=p.RootPriority,CFrame=p.CFrame}
				p.Anchored=true p.Massless=p~=root p.CanCollide=p==root p.CanQuery=p==root
			end
		end
		root.RootPriority=127
		self.seat.HeadsUpDisplay=false
		local forceAttachment=own(Instance.new("Attachment")) forceAttachment.Name="AXZF_Force" forceAttachment.Parent=root
		local force=own(Instance.new("VectorForce")) force.Name="AXZF_ContactForce" force.Attachment0=forceAttachment
		force.ApplyAtCenterOfMass=true force.RelativeTo=Enum.ActuatorRelativeTo.World force.Parent=root self.force=force
		local torque=own(Instance.new("Torque")) torque.Name="AXZF_ContactTorque" torque.Attachment0=forceAttachment
		torque.RelativeTo=Enum.ActuatorRelativeTo.World torque.Parent=root self.torque=torque
		for _,p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and p~=root and not p:IsDescendantOf(model.Wheels) then weld(root,p) end
		end
		for _,id in ipairs({"FL","FR","RL","RR"}) do
			local wheel=model.Wheels[id] local hub=Doctor.hub(wheel) :: BasePart
			if wheel:IsA("Model") then for _,p in ipairs(wheel:GetDescendants()) do if p:IsA("BasePart") and p~=hub then weld(hub,p) end end end
			local mount=root[id] :: Attachment
			local motor=own(Instance.new("Motor6D")) motor.Name="AXZF_"..id motor.Part0=root motor.Part1=hub
			motor.C0=root.CFrame:ToObjectSpace(hub.CFrame) motor.Parent=root
			local rotation=hub.CFrame.Rotation:ToObjectSpace(root.CFrame.Rotation):Inverse()
			table.insert(self.wheels,{id=id,mount=mount,motor=motor,rotation=rotation,spin=0,load=0,length=0})
		end
		for p in pairs(self.snapshots) do p.Anchored=false end
		if game:GetService("RunService"):IsRunning() then
			local can,reason=root:CanSetNetworkOwnership() assert(can,reason)
			root:SetNetworkOwner(nil)
		end
		model:SetAttribute("AXZFBound",true)
	end)
	if not ok then self:destroy() error(err,2) end
	return self
end
return Rig
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="AXZF18">
          <Properties>
            <string name="Name">VFXService</string>
            <ProtectedString name="Source">--!strict
-- Server decides grounded slip; clients render. Never handles client requests.
local Players=game:GetService("Players")
local VFXService={}
VFXService.__index=VFXService
function VFXService.new(): any
	local folder=game.ReplicatedStorage.VFX
	local build=require(folder.Build)
	local recipes=game:GetService("HttpService"):JSONDecode(require(folder.VehicleRecipes))
	for name,steps in pairs(recipes) do
		local previous=folder:FindFirstChild(name) if previous then previous:Destroy() end
		local _,report=build.run("game.ReplicatedStorage.VFX."..name,steps)
		assert(string.find(report,"0 errors",1,true),report)
		folder[name]:SetAttribute("EffectDuration",1.2)
	end
	local remote=Instance.new("UnreliableRemoteEvent") remote.Name="Effects" remote.Parent=game.ReplicatedStorage.AXZF
	return setmetatable({remote=remote,sent=0},VFXService)
end
function VFXService:send(name: string,at: CFrame,intensity: number)
	for _,player in ipairs(Players:GetPlayers()) do
		local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (root.Position-at.Position).Magnitude&lt;180 then self.remote:FireClient(player,name,at,math.clamp(intensity,.1,2)) self.sent+=1 end
	end
end
function VFXService:destroy() self.remote:Destroy() end
return VFXService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="AXZF19">
          <Properties>
            <string name="Name">Vehicle</string>
            <ProtectedString name="Source">--!strict
local Shared=game:GetService("ReplicatedStorage").AXZF.Shared
local Math=require(Shared.Math)
local Tune=require(Shared.Tune)
local Powertrain=require(Shared.Powertrain)
local Rig=require(script.Parent.Rig)
local Suspension=require(Shared.Suspension)
local Recovery=require(script.Parent.Recovery)
local Vehicle={}
Vehicle.__index=Vehicle
local neutral=table.freeze({throttle=0,steer=0,brake=1,handbrake=false})
function Vehicle.new(model: Model, overrides: any): any
	local tune=Tune.resolve(overrides)
	assert(tune.RestLength&gt;workspace.Gravity/(2*math.pi*tune.FrequencyHz)^2+0.1,"Suspension travel shorter than static sag; increase FrequencyHz or RestLength")
	local rig=Rig.bind(model)
	local params=RaycastParams.new() params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances={model} params.RespectCanCollide=true
	local self=setmetatable({rig=rig,tune=tune,powertrain=Powertrain.new(tune),input=neutral,inputAge=0,steer=0,telemetryAge=0,idleTime=0,destroyed=false,sleeping=false,lastStepMs=0},Vehicle)
	self.recovery=Recovery.new(rig,tune)
	self.originalPhysics=rig.root.CustomPhysicalProperties
	if tune.Mass&gt;0 then
		local volume=rig.root.Size.X*rig.root.Size.Y*rig.root.Size.Z
		if tune.Mass/volume&lt;.01 or tune.Mass/volume&gt;100 then rig:destroy() error("Mass exceeds the density range for this Chassis size") end
		rig.root.CustomPhysicalProperties=PhysicalProperties.new(tune.Mass/volume,.3,0,100,100)
	end
	self.params=params
	self.wheelbase=math.abs(rig.root.FL.Position.Z-rig.root.RL.Position.Z)
	self.track=math.abs(rig.root.FL.Position.X-rig.root.FR.Position.X)
	return self
end
-- Server integration / NPC seam; callers must supply a validated intent table.
function Vehicle:setInput(packet: any)
	self.input={throttle=packet.throttle,steer=packet.steer,brake=packet.brake,handbrake=packet.handbrake}
	self.inputAge=0 self.idleTime=0 self.sleeping=false
end
function Vehicle:clearInput()
	self.input=neutral self.inputAge=0 self.idleTime=0 self.sleeping=false
end
function Vehicle:getTelemetry(): any
	return {speed=self.rig.root.AssemblyLinearVelocity.Magnitude,rpm=self.powertrain.rpm,gear=if self.powertrain.direction&lt;0 then -1 else self.powertrain.gear,sleeping=self.sleeping,stepMs=self.lastStepMs,handbrake=self.input.handbrake}
end
function Vehicle:step(rawDt: number)
	if self.destroyed or not self.rig.model:IsDescendantOf(workspace) then return end
	local started=os.clock()
	local dt=math.clamp(rawDt,0,1/30) if dt==0 then return end
	self.inputAge+=rawDt
	local input=if self.inputAge&gt;self.tune.InputTimeout then neutral else self.input
	local rig,t=self.rig,self.tune
	local root=rig.root local cf=root.CFrame local velocity=root.AssemblyLinearVelocity
	if self.recovery:step(rawDt) then self:clearInput() return end
	if not rig.seat.Occupant and input==neutral and velocity.Magnitude&lt;0.15 and root.AssemblyAngularVelocity.Magnitude&lt;0.1 then self.idleTime+=dt else self.idleTime=0 end
	-- Keep spring support active: skipping all rays would remove gravity support.
	-- Sleep only reduces telemetry/visual work; physics contact solving stays correct.
	self.sleeping=self.idleTime&gt;t.SleepAfter
	local up=cf.UpVector local speed=velocity:Dot(cf.LookVector)
	local force,reverseBrake=self.powertrain:step(speed,input.throttle,dt)
	force*=t.Power
	if speed*math.sign(force)&gt;t.MaxSpeed then force=0 end
	local fade=math.max(t.MinSteerFraction,1-math.abs(speed)/t.SteerFadeSpeed)
	self.steer=Math.approach(self.steer,input.steer*math.rad(t.SteerDegrees)*fade,t.SteerResponse,dt)
	local left,right=Math.ackermann(self.steer,self.wheelbase,self.track)
	local assemblyMass=root.AssemblyMass local mass=assemblyMass/4
	local center=root.AssemblyCenterOfMass local angular=root.AssemblyAngularVelocity
	local contacts={}
	self.effectAge=(self.effectAge or 0)+rawDt
	local emitEffects=self.onEffect and t.VFX and t.VFXIntensity&gt;0 and self.effectAge&gt;1/6
	if emitEffects then self.effectAge=0 end
	-- Gather all contacts from one velocity snapshot before applying any impulse.
	for _,wheel in ipairs(rig.wheels) do
		local origin=wheel.mount.WorldPosition
		local hit=workspace:Raycast(origin,-up*(t.RestLength+t.Radius),self.params)
		wheel.length=t.RestLength wheel.load=0
		if hit and hit.Normal:Dot(up)&gt;0.25 then
			local length=math.clamp(hit.Distance-t.Radius,0,t.RestLength)
			local normal=hit.Normal
			local groundVelocity=if hit.Instance:IsA("BasePart") then hit.Instance:GetVelocityAtPosition(hit.Position) else Vector3.zero
			local arm=hit.Position-center
			local pointVelocity=velocity+angular:Cross(arm)-groundVelocity
			wheel.length=length
			table.insert(contacts,{wheel=wheel,hit=hit,normal=normal,arm=arm,pointVelocity=pointVelocity,compression=t.RestLength-length,velocity=pointVelocity:Dot(normal),gravity=-workspace.Gravity*normal.Y,mobility={},angularResponse=root:TorqueToAngularAcceleration(arm:Cross(normal))})
		end
	end
	for _,a in ipairs(contacts) do
		for j,b in ipairs(contacts) do a.mobility[j]=a.normal:Dot(b.normal)/assemblyMass+a.normal:Dot(b.angularResponse:Cross(a.arm)) end
	end
	local loads=Suspension.solve(contacts,mass,workspace.Gravity,t.FrequencyHz,t.DampingRatio,t.MaxLoad,dt)
	local linearImpulse,angularImpulse=Vector3.zero,Vector3.zero
	for i,contact in ipairs(contacts) do
		local wheel=contact.wheel local hit=contact.hit local normal=contact.normal local pointVelocity=contact.pointVelocity
		local load=loads[i] wheel.load=load
		local angle=if wheel.id=="FL" then left elseif wheel.id=="FR" then right else 0
			local forward=(cf*CFrame.Angles(0,-angle,0)).LookVector
			forward=forward-normal*forward:Dot(normal)
			if forward.Magnitude&gt;0.001 then
				forward=forward.Unit local side=forward:Cross(normal).Unit
				local longitudinalSpeed=pointVelocity:Dot(forward)
				local front=wheel.id=="FL" or wheel.id=="FR"
				local driven=t.Drive=="AWD" or (t.Drive=="FWD" and front) or (t.Drive=="RWD" and not front)
				local brake=math.max(input.brake,reverseBrake)*t.BrakeAcceleration
				if input.handbrake and not front then brake=math.max(brake,t.HandbrakeAcceleration) end
				local longitudinal=(if driven then force/(if t.Drive=="AWD" then 4 else 2) else 0)+Math.braking(longitudinalSpeed,brake*mass,mass,dt)
				longitudinal+=Math.braking(longitudinalSpeed,load*t.RollingResistance,mass,dt)
				local lateral=-pointVelocity:Dot(side)*mass*t.LateralResponse
				local surface=hit.Instance:GetAttribute("Grip")
				local grip=if Math.finite(surface) then math.clamp(surface,0.05,3) else 1
				local longForce,sideForce=Math.friction(longitudinal,lateral,load*t.Grip*grip)
				if emitEffects and not front and math.abs(speed)&gt;7 and load&gt;mass*workspace.Gravity*.1 then
					local material=hit.Material
					local dusty=material==Enum.Material.Sand or material==Enum.Material.Grass or material==Enum.Material.Ground or material==Enum.Material.Mud
					local slip=math.abs(pointVelocity:Dot(side))
					if dusty or input.handbrake or slip&gt;6 then
						local at=CFrame.lookAt(hit.Position+normal*.15,hit.Position+normal*.15+forward,normal)
						self.onEffect(if dusty then "AXZFSurfaceDust" else "AXZFTyreSmoke",at,math.clamp((slip+math.abs(speed)*.12)/12,.2,1)*t.VFXIntensity)
					end
				end
				local impulse=(normal*load+forward*longForce+side*sideForce)*dt
				linearImpulse+=impulse angularImpulse+=contact.arm:Cross(impulse)
			end
	end
	-- Persistent world-space actuators let the engine apply support at its own
	-- substeps. Per-frame impulse bursts caused visible gravity/velocity jitter.
	rig.force.Force=linearImpulse/dt-velocity*velocity.Magnitude*t.Drag
	rig.torque.Torque=angularImpulse/dt
	for _,wheel in ipairs(rig.wheels) do
		wheel.spin=(wheel.spin+speed/t.Radius*dt)%(2*math.pi)
		if not self.sleeping then
			local angle=if wheel.id=="FL" then left elseif wheel.id=="FR" then right else 0
			wheel.motor.C0=CFrame.new(wheel.mount.Position-Vector3.new(0,wheel.length,0))*CFrame.Angles(0,-angle,0)*CFrame.Angles(wheel.spin,0,0)*wheel.rotation
		end
	end
	self.telemetryAge+=rawDt
	if self.telemetryAge&gt;=1/t.TelemetryHz then
		self.telemetryAge=0
		local state=self:getTelemetry()
		for key,value in pairs(state) do rig.model:SetAttribute("AXZF_"..key,value) end
	end
	self.lastStepMs=(os.clock()-started)*1000
end
function Vehicle:destroy()
	if self.destroyed then return end self.destroyed=true self.rig:destroy()
	if self.rig.root.Parent then self.rig.root.CustomPhysicalProperties=self.originalPhysics end
	for _,key in ipairs({"speed","rpm","gear","sleeping","stepMs","handbrake","recovery","recoveryCount"}) do self.rig.model:SetAttribute("AXZF_"..key,nil) end
end
return Vehicle
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="AXZF20">
      <Properties>
        <string name="Name">StarterPlayer</string>
      </Properties>
      <Item class="Folder" referent="AXZF21">
        <Properties>
          <string name="Name">StarterPlayerScripts</string>
        </Properties>
        <Item class="LocalScript" referent="AXZF22">
          <Properties>
            <string name="Name">Driver</string>
            <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local CAS=game:GetService("ContextActionService")
local UIS=game:GetService("UserInputService")
local RunService=game:GetService("RunService")
local Tags=game:GetService("CollectionService")
local player=Players.LocalPlayer
local packageRoot=game.ReplicatedStorage:WaitForChild("AXZF")
local remote=packageRoot:WaitForChild("Control") :: RemoteEvent
local active: Model?=nil
local state={Forward=0,Reverse=0,Left=0,Right=0,Brake=0}
local park=false local stick=0 local sequence=0 local elapsed=0
local characterConnections={} local lifetime={}
local nativeTouch: ScreenGui?=nil local nativeEnabled=true
local function hideNativeTouch()
	if not nativeTouch then
		local native=player.PlayerGui:FindFirstChild("TouchGui")
		if native and native:IsA("ScreenGui") then nativeTouch=native nativeEnabled=native.Enabled end
	end
	if nativeTouch then nativeTouch.Enabled=false end
end
local cockpit=nil
local defaults={Forward="W",Reverse="S",Left="A",Right="D",Brake="B",Handbrake="Space",Exit="E",HideControls="H"}
local gamepad={Forward=Enum.KeyCode.ButtonR2,Reverse=Enum.KeyCode.ButtonL2,Brake=Enum.KeyCode.ButtonB,Handbrake=Enum.KeyCode.ButtonA,Exit=Enum.KeyCode.ButtonY}
local function connect(signal,fn) table.insert(lifetime,signal:Connect(fn)) end
local function clear() for key in pairs(state) do state[key]=0 end stick=0 end
local function action(name,down,amount)
	if not active then return end
	if name=="Handbrake" then if down then park=not park end
	elseif name=="Exit" then if down then local h=player.Character and player.Character:FindFirstChildOfClass("Humanoid") if h then h.Sit=false end end
	elseif name=="HideControls" then if down and cockpit then cockpit:toggleHelp() end
	elseif state[name]~=nil then state[name]=if down then amount or 1 else 0 end
end
local ui=packageRoot:WaitForChild("UI",15)
if not ui then warn("[A-XZF-Tune] GUI package missing: install ReplicatedStorage.AXZF.UI") return end
local cockpitModule=ui:WaitForChild("Cockpit",15)
if not cockpitModule then warn("[A-XZF-Tune] GUI package incomplete: Cockpit module missing") return end
cockpit=require(cockpitModule).new(player,action)
local function send()
	if not active then return end sequence+=1
	if UIS:GetFocusedTextBox() then clear() state.Brake=1 end
	remote:FireServer(active,{seq=sequence,throttle=state.Forward-state.Reverse,steer=math.clamp(state.Right-state.Left+stick,-1,1),brake=state.Brake,handbrake=park})
end
local function unbind()
	for id in pairs(defaults) do CAS:UnbindAction("AXZF_"..id) end
	CAS:UnbindAction("AXZF_stick") clear() park=false
	if nativeTouch then nativeTouch.Enabled=nativeEnabled nativeTouch=nil end
end
local function setVehicle(model: Model?)
	if active==model then return end
	if active then clear() state.Brake=1 park=false send() end
	unbind() active=model sequence=0 cockpit:setVehicle(model)
	if not model then return end
	hideNativeTouch()
	for id,fallback in pairs(defaults) do
		local key=model:GetAttribute("AXZF_Key"..id) or fallback
		local keys={Enum.KeyCode[key]} if gamepad[id] then table.insert(keys,gamepad[id]) end
		CAS:BindActionAtPriority("AXZF_"..id,function(_,phase,input)
			if UIS:GetFocusedTextBox() then clear() return Enum.ContextActionResult.Pass end
			local began=phase==Enum.UserInputState.Begin
			local ended=phase==Enum.UserInputState.End or phase==Enum.UserInputState.Cancel
			if id=="Handbrake" or id=="Exit" or id=="HideControls" then if began then action(id,true) end
			elseif ended then action(id,false)
			elseif began or phase==Enum.UserInputState.Change then
				local analog=input.KeyCode==Enum.KeyCode.ButtonR2 or input.KeyCode==Enum.KeyCode.ButtonL2
				action(id,true,if analog then math.clamp(input.Position.Z,0,1) else 1)
			end
			return Enum.ContextActionResult.Sink
		end,false,3000,table.unpack(keys))
	end
	CAS:BindActionAtPriority("AXZF_stick",function(_,phase,input)
		stick=if phase==Enum.UserInputState.Cancel or phase==Enum.UserInputState.End then 0 else (if math.abs(input.Position.X)&gt;.12 then input.Position.X else 0)
		return Enum.ContextActionResult.Sink
	end,false,3000,Enum.KeyCode.Thumbstick1)
end
local function hook(character)
	for _,c in ipairs(characterConnections) do c:Disconnect() end table.clear(characterConnections) setVehicle(nil)
	local humanoid=character:WaitForChild("Humanoid")
	local function refresh()
		local seat=humanoid.SeatPart local model=seat and seat.Parent
		setVehicle(if seat and seat.Name=="DriveSeat" and model and model:IsA("Model") and Tags:HasTag(model,"AXZFVehicle") then model else nil)
	end
	table.insert(characterConnections,humanoid.Seated:Connect(refresh))
	table.insert(characterConnections,humanoid.Died:Connect(function() setVehicle(nil) end)) refresh()
end
connect(player.CharacterAdded,hook) if player.Character then task.spawn(hook,player.Character) end
connect(UIS.WindowFocusReleased,function() clear() state.Brake=1 send() end)
connect(UIS.WindowFocused,clear)
connect(UIS.TextBoxFocused,function() clear() state.Brake=1 send() end)
connect(UIS.TextBoxFocusReleased,clear)
connect(RunService.Heartbeat,function(dt)
	elapsed+=dt if elapsed&lt;1/20 then return end elapsed=0
	if active and not active:IsDescendantOf(workspace) then setVehicle(nil) end
	if active then hideNativeTouch() end
	send() cockpit:update()
end)
script.Destroying:Connect(function()
	setVehicle(nil) for _,c in ipairs(characterConnections) do c:Disconnect() end for _,c in ipairs(lifetime) do c:Disconnect() end cockpit:destroy()
end)
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="AXZF23">
          <Properties>
            <string name="Name">VehicleEffects</string>
            <ProtectedString name="Source">--!strict
local RunService=game:GetService("RunService")
local folder=game.ReplicatedStorage:WaitForChild("VFX")
local Emit=require(folder:WaitForChild("Emit"))
local remote=game.ReplicatedStorage:WaitForChild("AXZF"):WaitForChild("Effects")
local allowed={AXZFTyreSmoke=true,AXZFSurfaceDust=true}
local preload=task.spawn(function()
	local templates={}
	for name in pairs(allowed) do local t=folder:WaitForChild(name,10) if t then table.insert(templates,t) end end
	if #templates&gt;0 then pcall(function() game:GetService("ContentProvider"):PreloadAsync(templates) end) end
end)
local handles={} local tokens=30 local elapsed=0
local event=remote.OnClientEvent:Connect(function(name,at,intensity)
	if not allowed[name] or typeof(at)~="CFrame" or type(intensity)~="number" then return end
	if tokens&lt;1 or (workspace.CurrentCamera.CFrame.Position-at.Position).Magnitude&gt;180 then return end
	local template=folder:FindFirstChild(name) if not template then return end tokens-=1
	local copy=template:Clone()
	for _,p in ipairs(copy:GetDescendants()) do
		if p:IsA("ParticleEmitter") then p:SetAttribute("EmitCount",math.max(1,math.floor((p:GetAttribute("EmitCount") or 1)*math.clamp(intensity,.1,2)))) end
	end
	local handle=Emit.play(copy,at) copy:Destroy() table.insert(handles,handle)
end)
local step=RunService.Heartbeat:Connect(function(dt)
	tokens=math.min(30,tokens+dt*30) elapsed+=dt
	if elapsed&lt;.5 then return end elapsed=0
	for i=#handles,1,-1 do if handles[i].finished then table.remove(handles,i) end end
end)
script.Destroying:Connect(function() event:Disconnect() step:Disconnect() pcall(task.cancel,preload) for _,h in ipairs(handles) do h:stop() end end)
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="AXZF36">
      <Properties>
        <string name="Name">ServerStorage</string>
      </Properties>
      <Item class="Folder" referent="AXZF37">
        <Properties>
          <string name="Name">AXZFExamples</string>
        </Properties>
        <Item class="ModuleScript" referent="AXZF38">
          <Properties>
            <string name="Name">VehicleTune</string>
            <ProtectedString name="Source">--!strict
-- A-XZF-Tune / kısa başlangıç rehberi
-- 1. Bu ModuleScript aracın içinde kalır; ayarları buradan değiştirin.
-- 2. Play'i durdurun, bir değeri değiştirin, tekrar Play ile deneyin.
-- 3. Yeni ayar hatalıysa aracın AXZFError attribute'u sebebi gösterir.
-- Birimler: stud, saniye ve Roblox kütlesi. Power bir çarpandır; gerçek HP değildir.
-- Gövde/tekerlek yerlerini değiştirirken docs/MODEL-INTEGRATION.md'yi okuyun.
return {
	SchemaVersion = 1,
	-- MOTOR / SÜRÜŞ: gücü önce küçük adımlarla artırın.
	Power = 1, -- 0.1..5; örn. 1.2 = varsayılan motor kuvvetinin %120'si
	MaxSpeed = 180, -- stud/s; bu hızdan sonra motor itişi kesilir, yokuş hızını zorla sınırlamaz
	Drive = "RWD", -- "FWD" önden, "RWD" arkadan, "AWD" dört tekerlekten
	Mass = 0, -- 0 = Chassis'in mevcut kütlesi; &gt;0 = Roblox kütlesi, kg değildir
	-- TEKER / SÜSPANSİYON: Radius gerçek teker yarıçapına uymalıdır.
	Radius = 1.25,
	RestLength = 1.6, -- spring top ile tam açık teker merkezi arası
	FrequencyHz = 3.5, -- sertlik; artırınca daha sert, azaltınca daha yumuşak
	DampingRatio = 0.85, -- sönümleme; aşırı değerler sürüşü sertleştirir
	Grip = 1.2, -- tutuş; 0.8 daha kaygan, 1.4 daha tutucu bir başlangıçtır
	BrakeAcceleration = 90,
	SteerDegrees = 32, -- düşük hızdaki direksiyon açısı
	-- KURTARMA: yalnızca ters dönmüş, yavaş ve zemine yakın araçta çalışır.
	AutoRecover = true,
	RecoverDelay = 2, -- saniye; boş yer yoksa bekler, diğer araçların içine taşımaz
	RecoverMaxSpeed = 6,
	-- GÖRÜNÜM / EFEKTLER
	VFX = true,
	VFXIntensity = 1, -- 0..2; client tarafındaki lastik dumanı/toz bütçesi
	SpeedScale = 1, -- gösterilen sayı = stud/s * SpeedScale; fiziksel hız değişmez
	SpeedUnit = "STUD/S", -- kendi oyun ölçeğiniz varsa etiketi ve çarpanı birlikte değiştirin
	ShowControls = true, -- H ile gizlenebilen klavye yardımının başlangıç durumu
	-- TUŞLAR: Enum.KeyCode yazmayın, aşağıdaki gibi tuşun adını string girin.
	-- Her işlem farklı bir tuş kullanmalı. Örn. Handbrake = "P" yapılabilir.
	-- Gamepad ve dokunmatik düğmeler klavye düzeninden bağımsız çalışır.
	Controls = {
		Forward = "W", Reverse = "S", Left = "A", Right = "D",
		Brake = "B", Handbrake = "Space", Exit = "E", HideControls = "H",
	},
}
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>
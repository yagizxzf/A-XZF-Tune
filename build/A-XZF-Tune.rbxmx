          <Item class="ModuleScript" referent="AXZF31">
            <Properties>
              <string name="Name">Builder</string>
              <ProtectedString name="Source">--!nocheck
-- Builder: turns the generated Data_&lt;Screen&gt; modules (scripts/gen.py, from the approved HTML) into a
-- real ScreenGui in StarterGui, plus a runtime templates folder in ReplicatedStorage.
-- Generic: copy unchanged into &lt;luau_out&gt;/Builder.luau. Everything game-specific comes from
-- Data_Manifest (gui name, design size, screen order) and AssetIds.
--
-- Run from Studio (robloxstudio execute_luau), after import_rbxm of the bundle into ServerStorage:
--   return require(game.ServerStorage.&lt;Gui&gt;Build.Builder).build()
--   -- then, with the gui temporarily Enabled = true so text measures:
--   return require(game.ServerStorage.&lt;Gui&gt;Build.Builder).fit()      -- run twice
--
-- Layout: every screen is a full-size Frame under Root. Root is the design size (e.g. 1920x1080)
-- with a UIScale "FitScale"; the runtime UI module resizes Root to viewport / scale, so groups
-- anchored to edges (anchor TL/T/TR/L/C/R/BL/B/BR in the HTML grp()) hug the real screen edges.
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Builder = {}

local WEIGHT = {
	[100] = Enum.FontWeight.Thin, [200] = Enum.FontWeight.ExtraLight, [300] = Enum.FontWeight.Light,
	[400] = Enum.FontWeight.Regular, [500] = Enum.FontWeight.Medium, [600] = Enum.FontWeight.SemiBold,
	[700] = Enum.FontWeight.Bold, [800] = Enum.FontWeight.ExtraBold, [900] = Enum.FontWeight.Heavy,
}

local function c3(t): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function decode(mod: Instance?)
	assert(mod, "missing Data module (did the bundle import?)")
	return HttpService:JSONDecode(require(mod :: ModuleScript))
end

local function asset(assets, key: string?): string
	if not key then return "" end
	local kind, name = string.match(key, "^(%w+):(.+)$")
	local id = kind == "icon" and assets.icons[name] or kind == "art" and assets.art[name] or nil
	if not id then
		warn("[Builder] no asset id for " .. key .. " (upload it: ledger.py, then assets.py, re-bundle)")
		return ""
	end
	return id
end

-- Conic cooldown wedge (dark from 12 o'clock clockwise to frac*360) from two clipped halves, each
-- holding a rotating half-plane. Public so the runtime can call Builder.cooldown-style updates.
function Builder.cooldown(frame: Frame, frac: number, color: Color3, transparency: number)
	for _, n in { "R", "L" } do
		local half = frame:FindFirstChild(n)
		if not half then
			half = Instance.new("Frame")
			half.Name = n
			half.BackgroundTransparency = 1
			half.ClipsDescendants = true
			half.Size = UDim2.fromScale(0.5, 1)
			half.Position = UDim2.fromScale(n == "R" and 0.5 or 0, 0)
			local rotor = Instance.new("Frame")
			rotor.Name = "Rotor"
			rotor.BackgroundTransparency = 1
			rotor.AnchorPoint = Vector2.new(0.5, 0.5)
			rotor.Position = UDim2.fromScale(n == "R" and 0 or 1, 0.5)
			rotor.Size = UDim2.fromScale(6, 3)
			local plane = Instance.new("Frame")
			plane.Name = "Plane"
			plane.BorderSizePixel = 0
			plane.Size = UDim2.fromScale(0.5, 1)
			plane.Position = UDim2.fromScale(n == "R" and 0 or 0.5, 0)
			plane.Parent = rotor
			rotor.Parent = half
			half.Parent = frame
		end
		local rotor = half:FindFirstChild("Rotor")
		local plane = rotor:FindFirstChild("Plane")
		plane.BackgroundColor3 = color
		plane.BackgroundTransparency = transparency
		local a = math.clamp(frac, 0, 1) * 360
		if n == "R" then
			half.Visible = a &gt; 0
			rotor.Rotation = math.min(a, 180)
		else
			half.Visible = a &gt; 180
			rotor.Rotation = math.max(a - 180, 0)
		end
	end
	frame:SetAttribute("Frac", frac)
end

local function make(d, parent: Instance, z: number, assets): Instance
	if d.c == "Folder" then
		local f = Instance.new("Folder")
		f.Name = d.n
		for i, child in d.k or {} do make(child, f, 1, assets) end
		f.Parent = parent
		return f
	end
	local inst = Instance.new(d.c)
	inst.Name = d.n or d.c
	inst.BorderSizePixel = 0
	inst.AnchorPoint = Vector2.new(d.ax or 0, d.ay or 0)
	if d.fill then
		inst.Position = UDim2.fromScale(0, 0)
		inst.Size = UDim2.fromScale(1, 1)
	else
		inst.Position = UDim2.new(d.sx or 0, d.x or 0, d.sy or 0, d.y or 0)
		inst.Size = UDim2.new(d.sw or 0, d.w or 0, d.sh or 0, d.h or 0)
	end
	inst.ZIndex = z
	inst.Rotation = d.rot or 0
	if d.visible == false then inst.Visible = false end
	if d.bg then
		inst.BackgroundColor3 = c3(d.bg)
		inst.BackgroundTransparency = d.bt or 0
	else
		inst.BackgroundTransparency = 1
	end
	if d.clip then inst.ClipsDescendants = true end
	if d.c == "TextButton" then
		inst.Text = ""
		inst.AutoButtonColor = false
	end
	if d.c == "ImageLabel" or d.c == "ImageButton" then
		inst.Image = asset(assets, d.img)
		inst.ScaleType = Enum.ScaleType[d.st or "Fit"]
		if d.tile then inst.TileSize = UDim2.fromOffset(d.tile[1], d.tile[2]) end
		if d.ic then inst.ImageColor3 = c3(d.ic) end
		if d.it then inst.ImageTransparency = d.it end
	end
	if d.c == "TextLabel" then
		inst.Text = d.txt
		inst.FontFace = Font.new("rbxasset://fonts/families/" .. (d.font or "Montserrat") .. ".json",
			WEIGHT[d.wt] or Enum.FontWeight.ExtraBold)
		inst.TextSize = math.min(100, d.ts)
		inst.TextColor3 = c3(d.tc)
		inst.TextXAlignment = d.xa == "R" and Enum.TextXAlignment.Right
			or d.xa == "C" and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
		inst.TextYAlignment = Enum.TextYAlignment.Center
		inst.TextWrapped = false
		inst.RichText = false
	end
	if d.corner then
		local u = Instance.new("UICorner")
		u.CornerRadius = d.corner.s and UDim.new(d.corner.s, 0) or UDim.new(0, d.corner.o)
		u.Parent = inst
	end
	if d.stroke then
		local s = Instance.new("UIStroke")
		s.Thickness = d.stroke.t
		s.Color = c3(d.stroke.c)
		s.Transparency = d.stroke.tr or 0
		s.LineJoinMode = Enum.LineJoinMode.Round
		if d.stroke.mode == "Border" then
			s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			s.BorderStrokePosition = Enum.BorderStrokePosition[d.stroke.pos or "Inner"]
		end
		s:SetAttribute("BaseThickness", s.Thickness)
		s.Parent = inst
	end
	if d.grad then
		local g = Instance.new("UIGradient")
		g.Rotation = d.grad.rot or 90
		local kps = {}
		for _, k in d.grad.c do
			table.insert(kps, ColorSequenceKeypoint.new(k[1], Color3.fromRGB(k[2], k[3], k[4])))
		end
		g.Color = ColorSequence.new(kps)
		if d.grad.tr then
			local nps = {}
			for _, k in d.grad.tr do table.insert(nps, NumberSequenceKeypoint.new(k[1], k[2])) end
			g.Transparency = NumberSequence.new(nps)
		end
		g.Parent = inst
	end
	if d.scale then -- TextSize &gt; 100 wrapper
		local s = Instance.new("UIScale")
		s.Name = "BigText"
		s.Scale = d.scale
		s.Parent = inst
	end
	if d.attrs then
		for k, v in d.attrs do inst:SetAttribute(k, v) end
	end
	inst.Parent = parent
	if d.cool then
		Builder.cooldown(inst, d.attrs.Frac, c3(d.cool.c), d.cool.tr)
	end
	for i, child in d.k or {} do make(child, inst, i, assets) end
	return inst
end

-- Second pass, after fonts load: nudge each label's TextSize so its rendered width matches the
-- HTML ink width (Chrome and Roblox advance widths differ by a few % on short strings/digits).
-- The gui must be Enabled while this runs or TextBounds reads 0. Run it twice.
function Builder.fit(scope: Instance?): string
	local man = decode(script.Parent:FindFirstChild("Data_Manifest"))
	local gui = scope or StarterGui:FindFirstChild(man.gui)
	assert(gui, "build first")
	local fixed, worst, n = 0, 0, 0
	for _, d in gui:GetDescendants() do
		if d:IsA("TextLabel") and d.Text ~= "" and not string.find(d.Name, "Shadow$") then
			local w = d:GetAttribute("FitW") or d.AbsoluteSize.X
			local tb = d.TextBounds.X
			if w &gt; 0 and tb &gt; 0 then
				n += 1
				local r = tb / w
				if math.abs(r - 1) &gt; 0.015 then
					local ts = math.clamp(d.TextSize / r, 1, 100)
					d.TextSize = ts
					local sh = d.Parent and d.Parent:FindFirstChild(d.Name .. "Shadow")
					if sh and sh:IsA("TextLabel") then sh.TextSize = ts end
					fixed += 1
				end
				worst = math.max(worst, math.abs(r - 1))
				d:SetAttribute("FitRatio", r)
			end
		end
	end
	return string.format("fit: %d/%d labels resized (worst was %.1f%%)%s", fixed, n, worst * 100,
		n == 0 and " -- 0 measured: is the gui Enabled?" or "")
end

function Builder.build(): string
	local folder = script.Parent
	local assets = require(folder:FindFirstChild("AssetIds"))
	local man = decode(folder:FindFirstChild("Data_Manifest"))
	local W, H = man.design[1], man.design[2]

	local old = StarterGui:FindFirstChild(man.gui)
	if old then old:Destroy() end
	local gui = Instance.new("ScreenGui")
	gui.Name = man.gui
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 5
	-- Disabled in StarterGui so the design-size HUD does not sit over the edit viewport; the
	-- Controller LocalScript enables its PlayerGui copy at runtime.
	gui.Enabled = false

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromOffset(W, H)
	root.BackgroundTransparency = 1
	root.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Name = "FitScale"
	scale.Parent = root

	-- scrim behind panels: the UI module fades it to each screen's Dim attribute. Active = true so a
	-- click on the scrim never reaches the world while a panel is open.
	local dim = Instance.new("Frame")
	dim.Name = "Dim"
	dim.AnchorPoint = Vector2.new(0.5, 0.5)
	dim.Position = UDim2.fromScale(0.5, 0.5)
	dim.Size = UDim2.new(1, 4000, 1, 4000)
	dim.BackgroundColor3 = Color3.fromRGB(0, 8, 12)
	dim.BackgroundTransparency = 1
	dim.BorderSizePixel = 0
	dim.Active = true
	dim.Visible = false
	dim.ZIndex = 1
	dim.Parent = root

	local count = 0
	for i, s in man.screens do
		local data = decode(folder:FindFirstChild("Data_" .. s.name))
		-- HUD-type screens sit under every panel; panels stack in manifest order above the scrim
		local z = if s.hud then 2 else i + 3
		local screen = make(data, root, z, assets)
		screen.Visible = s.visible == true
		screen:SetAttribute("Hud", s.hud == true)
		count += #screen:GetDescendants() + 1
	end

	-- ship the asset map + client scripts with the gui
	folder:FindFirstChild("AssetIds"):Clone().Parent = gui
	-- every shared runtime module in luau_out (UIKit, NumberFormat, Theme, UpdateInPlace, ...) ships inside the
	-- gui so LocalScripts can require it (clients cannot see ServerStorage). Builder/Data_* stay behind.
	for _, m in folder:GetChildren() do
		if m:IsA("ModuleScript") and m.Name ~= "Builder" and m.Name ~= "AssetIds" and not string.match(m.Name, "^Data_") then
			m:Clone().Parent = gui
		end
	end
	gui:SetAttribute("TemplatesFolder", man.templates)
	local client = folder:FindFirstChild("Client")
	if client then
		for _, s in client:GetChildren() do s:Clone().Parent = gui end
	end
	gui.Parent = StarterGui

	-- runtime templates (toasts, confirm, tutorial card, billboards ...): game code clones these and
	-- never builds UI with Instance.new.
	local ntemp = 0
	if man.templates then
		local oldT = ReplicatedStorage:FindFirstChild(man.templates)
		if oldT then oldT:Destroy() end
		local tf = make(decode(folder:FindFirstChild("Data_Templates")), ReplicatedStorage, 1, assets)
		folder:FindFirstChild("AssetIds"):Clone().Parent = tf
		ntemp = #tf:GetChildren() - 1
	end
	return string.format("built %s: %d screens, %d instances; %d templates. Now Enabled=true, fit() x2, Enabled=false.",
		man.gui, #man.screens, count, ntemp)
end

-- Update ONE screen in place (after re-exporting only that page): rebuilds StarterGui.&lt;Gui&gt;.Root.&lt;name&gt;
-- from Data_&lt;name&gt; at the same z, leaving every other screen and the scripts untouched.
--   return require(game.ServerStorage.&lt;Gui&gt;Build.Builder).buildScreen("Shop")
function Builder.buildScreen(name: string): string
	local folder = script.Parent
	local assets = require(folder:FindFirstChild("AssetIds"))
	local man = decode(folder:FindFirstChild("Data_Manifest"))
	local gui = StarterGui:FindFirstChild(man.gui)
	assert(gui, "build() first")
	local root = gui:FindFirstChild("Root")
	local z, entry = nil, nil
	for i, s in man.screens do
		if s.name == name then z, entry = if s.hud then 2 else i + 3, s end
	end
	assert(entry, "screen not in Data_Manifest: " .. name)
	local old = root:FindFirstChild(name)
	if old then old:Destroy() end
	local screen = make(decode(folder:FindFirstChild("Data_" .. name)), root, z, assets)
	screen.Visible = entry.visible == true
	screen:SetAttribute("Hud", entry.hud == true)
	return string.format("rebuilt %s (%d instances); run fit(scope) with the gui Enabled", name, #screen:GetDescendants() + 1)
end

return Builder
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="AXZF32">
            <Properties>
              <string name="Name">Cockpit</string>
              <ProtectedString name="Source">--!strict
-- The exported GUI owns the visuals. The controller binds device layout, input and telemetry.
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")

local BUTTON_MOTION = TweenInfo.new(.11, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local HELP_MOTION = TweenInfo.new(.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local INTRO_MOTION = TweenInfo.new(.235, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local WHITE = Color3.fromRGB(247, 247, 247)
local KEY_NAMES = {
	Space = "Boşluk", Backspace = "Sil", Return = "Enter",
	LeftShift = "Sol Shift", RightShift = "Sağ Shift",
	LeftControl = "Sol Ctrl", RightControl = "Sağ Ctrl",
	LeftAlt = "Sol Alt", RightAlt = "Sağ Alt",
	Up = "Yukarı", Down = "Aşağı", Left = "Sol", Right = "Sağ",
}

local Cockpit = {}
Cockpit.__index = Cockpit

local function label(parent: Instance, name: string): TextLabel
	local node = parent:FindFirstChild(name, true)
	assert(node and node:IsA("TextLabel"), "Gösterge etiketi eksik: " .. name)
	node.TextScaled = true
	return node
end

local function meter(group)
	local body = group.Cockpit
	local ticks = {}
	for i = 0, 14 do
		table.insert(ticks, body["RPM" .. i])
	end
	return {
		group = group, ticks = ticks,
		speed = label(body, "Speed"), unit = label(body, "Unit"),
		gear = label(body, "Gear"), rpm = label(body, "RPMValue"),
		park = label(body, "ParkStatus"), handbrake = label(body, "HandbrakeStatus"),
	}
end

local function appearance(button)
	local face = button[button.Name .. "Face"]
	local scale = Instance.new("UIScale")
	scale.Name = "PressScale"
	scale.Parent = face
	local art = button:FindFirstChild(button.Name .. "Art")
	return {
		face = face, scale = scale, stroke = face:FindFirstChildWhichIsA("UIStroke"),
		color = face.BackgroundColor3, transparency = face.BackgroundTransparency,
		image = art and art:FindFirstChildWhichIsA("ImageLabel"),
		fallback = button:FindFirstChild(button.Name .. "Icon"),
	}
end

local function setPressed(button, pressed: boolean)
	if button.image and button.fallback then
		button.fallback.Visible = not button.image.IsLoaded
	end
	if button.pressed == pressed then return end
	button.pressed = pressed
	local color = if pressed then WHITE else button.color
	local transparency = if pressed then .77 else button.transparency
	local scale = if pressed then .94 else 1
	if button.scaleTween then button.scaleTween:Cancel() end
	if button.faceTween then button.faceTween:Cancel() end
	button.stroke.Transparency = if pressed then 0 else .61
	if GuiService.ReducedMotionEnabled then
		button.scale.Scale = 1
		button.face.BackgroundColor3 = color
		button.face.BackgroundTransparency = transparency
	else
		button.scaleTween = TweenService:Create(button.scale, BUTTON_MOTION, {Scale = scale})
		button.faceTween = TweenService:Create(button.face, BUTTON_MOTION, {
			BackgroundColor3 = color, BackgroundTransparency = transparency,
		})
		button.scaleTween:Play()
		button.faceTween:Play()
	end
end

local function rpmText(rpm: number): string
	local digits = tostring(math.floor(rpm / 50) * 50)
	if #digits &gt; 3 then
		digits = string.sub(digits, 1, -4) .. "." .. string.sub(digits, -3)
	end
	return digits .. " dev/dk"
end

function Cockpit.new(player: Player, action: any): any
	local template = game.ReplicatedStorage.AXZF:WaitForChild("CockpitTemplate", 15)
	assert(template, "[A-XZF-Tune] Gösterge şablonu yok. UI paketini yükleyip aracı başlatın.")
	local gui = template:Clone()
	gui.Name = "AXZFCockpit"
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local root = gui.Root
	root.Dim.Visible = false
	root.AnchorPoint = Vector2.zero
	root.Position = UDim2.fromOffset(0, 0)
	root.ClipsDescendants = true
	local helpScale = Instance.new("UIScale")
	helpScale.Name = "DeviceScale"
	helpScale.Parent = root.HUD.Controls
	local self = setmetatable({
		gui = gui, root = root, help = false, vehicle = nil,
		desktopMeter = meter(root.HUD.Dashboard),
		mobileMeter = meter(root.Mobile.DashboardMobile),
		desktopHelp = appearance(root.HUD.Toggle.ShowControls),
		helpScale = helpScale, mobile = UIS.TouchEnabled,
		touch = {}, pressed = {}, connections = {},
	}, Cockpit)

	local function connect(signal, handler)
		table.insert(self.connections, signal:Connect(handler))
	end
	local function wire(name, id, toggle)
		local button = root.Mobile:FindFirstChild(name, true)
		if not button or not button:IsA("TextButton") then return end
		self.touch[id] = appearance(button)
		if toggle then
			connect(button.Activated, function() action(id, true) end)
		else
			connect(button.InputBegan, function(input)
				local kind = input.UserInputType
				if kind == Enum.UserInputType.Touch or kind == Enum.UserInputType.MouseButton1 then
					self.pressed[input] = id
					action(id, true)
				end
			end)
		end
	end
	wire("Throttle", "Forward", false)
	wire("Reverse", "Reverse", false)
	wire("Brake", "Brake", false)
	wire("SteerLeft", "Left", false)
	wire("SteerRight", "Right", false)
	wire("Handbrake", "Handbrake", true)
	wire("Park", "Park", true)
	wire("Exit", "Exit", true)
	wire("ToggleControls", "HideControls", true)
	local images = {}
	for _, button in pairs(self.touch) do
		if button.image then table.insert(images, button.image) end
	end
	self.preload = task.spawn(function()
		pcall(function() game:GetService("ContentProvider"):PreloadAsync(images) end)
	end)

	-- Release also applies when a finger leaves its original button before lifting.
	connect(UIS.InputEnded, function(input)
		local released = {}
		for held, id in pairs(self.pressed) do
			if held == input or (input.UserInputType == Enum.UserInputType.MouseButton1
				and held.UserInputType == input.UserInputType) then
				self.pressed[held] = nil
				released[id] = true
			end
		end
		for _, id in pairs(self.pressed) do released[id] = nil end
		for id in pairs(released) do action(id, false) end
	end)
	connect(UIS.WindowFocusReleased, function() table.clear(self.pressed) end)
	connect(root.HUD.Toggle.ShowControls.Activated, function() action("HideControls", true) end)
	return self
end

function Cockpit:showHelp(visible: boolean, animate: boolean)
	self.help = visible
	local group = self.root.HUD.Controls
	local panel = group.ControlPanel
	if self.helpTween then self.helpTween:Cancel() end
	if not animate or GuiService.ReducedMotionEnabled then
		group.Visible = visible
		panel.Position = UDim2.fromOffset(0, 0)
		return
	end
	local resting = UDim2.fromOffset(0, 0)
	local shifted = UDim2.fromOffset(0, 8)
	if visible and not group.Visible then
		panel.Position = shifted
		group.Visible = true
	end
	local tween = TweenService:Create(panel, HELP_MOTION, {Position = if visible then resting else shifted})
	self.helpTween = tween
	tween.Completed:Once(function(state)
		if state == Enum.PlaybackState.Completed and not self.help then group.Visible = false end
	end)
	tween:Play()
end

function Cockpit:toggleHelp()
	if self.vehicle then self:showHelp(not self.help, true) end
end

function Cockpit:setVehicle(model: Model?)
	table.clear(self.pressed)
	if self.introTween then self.introTween:Cancel() end
	self.vehicle = model
	self.gui.Enabled = model ~= nil
	self.layoutViewport = nil
	self:showHelp(model ~= nil and model:GetAttribute("AXZF_ConfigShowControls") == true, false)
	if not model then return end

	local function key(action: string): string
		local value = model:GetAttribute("AXZF_Key" .. action) or action
		return KEY_NAMES[value] or value
	end
	local rows = {
		key("Forward") .. " / " .. key("Reverse"), key("Left") .. " / " .. key("Right"),
		key("Brake"), key("Handbrake"), key("Park"), key("Exit"), key("HideControls"),
	}
	for i, value in ipairs(rows) do
		label(self.root.HUD.Controls, "Key" .. (i - 1)).Text = value
	end
	label(self.root.HUD.Toggle, "ShowControlsLabel").Text = key("HideControls") .. " · Tuşlar"
	self:update()

	if not GuiService.ReducedMotionEnabled then
		local group = (if self.mobile then self.mobileMeter else self.desktopMeter).group
		local target = group.Position
		group.Position = target + UDim2.fromOffset(0, 13)
		self.introTween = TweenService:Create(group, INTRO_MOTION, {Position = target})
		self.introTween:Play()
	end
end

function Cockpit:layout(recovering: boolean)
	local viewport = self.gui.AbsoluteSize
	local mobile = UIS.TouchEnabled
	if self.layoutViewport == viewport and self.mobile == mobile and self.layoutRecovery == recovering then return end
	if self.introTween then self.introTween:Cancel() end
	self.layoutViewport, self.mobile, self.layoutRecovery = viewport, mobile, recovering

	local scale = if mobile then math.clamp(math.min(viewport.X / 840, viewport.Y / 430), 1, 1.1)
		else math.clamp(math.min(viewport.X / 1380, viewport.Y / 800), .72, 1)
	local width, height = viewport.X / scale, viewport.Y / scale
	local root = self.root
	root.FitScale.Scale = scale
	root.Size = UDim2.fromOffset(width, height)
	root.HUD.Dashboard.Visible = not mobile
	root.HUD.Toggle.Visible = not mobile
	root.Mobile.Visible = mobile

	local controls = root.HUD.Controls
	local recovery = root.Recovery.Recovery
	local dashboard = (if mobile then self.mobileMeter else self.desktopMeter).group
	dashboard.AnchorPoint = Vector2.new(.5, .5)
	dashboard.Position = UDim2.fromScale(if mobile then .5 else 1, 1)
	if not mobile then
		self.helpScale.Scale = 1
		controls.AnchorPoint = Vector2.new(0, 1)
		controls.Position = UDim2.new(0, 12, 1, -69)
		recovery.AnchorPoint = Vector2.new(.5, 0)
		recovery.Position = UDim2.new(.5, 0, 0, 8)
		return
	end

	local steering = root.Mobile.TouchLeft
	local pedals = root.Mobile.TouchPedals
	local handbrake = root.Mobile.TouchHandbrake
	local dialWidth = dashboard.Size.X.Offset
	local sideWidth = math.max(steering.Size.X.Offset, pedals.Size.X.Offset)
	local lift = if width &lt; dialWidth + 2 * (sideWidth + 18) then dialWidth / 2 + 8 else 0
	steering.Position = UDim2.new(0, 12, 1, -12 - lift)
	pedals.Position = UDim2.new(1, -12, 1, -12 - lift)
	handbrake.Position = UDim2.new(1, -12, 1, -72 - lift)

	local helpTop = 59
	local utilityWidth = root.Mobile.TouchUtility.Size.X.Offset
	if width &gt;= utilityWidth + recovery.Size.X.Offset + 36 then
		recovery.AnchorPoint = Vector2.new(1, 0)
		recovery.Position = UDim2.new(1, -12, 0, 8)
	else
		recovery.AnchorPoint = Vector2.new(.5, 0)
		recovery.Position = UDim2.new(.5, 0, 0, helpTop)
		if recovering then helpTop += recovery.Size.Y.Offset + 6 end
	end
	if width &gt; height then
		local availableWidth = (width - dialWidth) / 2 - 18
		local availableHeight = height - steering.Size.Y.Offset - lift - helpTop - 18
		self.helpScale.Scale = math.clamp(math.min(availableWidth / controls.Size.X.Offset,
			availableHeight / controls.Size.Y.Offset), .55, 1)
		controls.AnchorPoint = Vector2.zero
		controls.Position = UDim2.fromOffset(12, helpTop)
	else
		self.helpScale.Scale = 1
		controls.AnchorPoint = Vector2.new(.5, 0)
		controls.Position = UDim2.new(.5, 0, 0, helpTop)
	end
end

function Cockpit:update()
	local model = self.vehicle
	if not model then return end
	local recovering = model:GetAttribute("AXZF_recovery") == "Waiting for space"
	self:layout(recovering)
	local current = if self.mobile then self.mobileMeter else self.desktopMeter
	local speed = (model:GetAttribute("AXZF_speed") or 0) * (model:GetAttribute("AXZF_ConfigSpeedScale") or 1)
	local rpm = model:GetAttribute("AXZF_rpm") or 0
	local redline = model:GetAttribute("AXZF_ConfigRedlineRPM") or 7000
	local gear = model:GetAttribute("AXZF_gear") or 1
	local parked = model:GetAttribute("AXZF_parkRequested") == true
	local handbrake = model:GetAttribute("AXZF_handbrake") == true
	local unit = model:GetAttribute("AXZF_ConfigSpeedUnit")
	current.speed.Text = tostring(math.floor(speed + .5))
	current.unit.Text = if unit == nil or unit == "STUD/S" then "stud/sn" else unit
	current.gear.Text = if parked then "P" elseif gear == -1 then "R" else tostring(gear)
	current.rpm.Text = rpmText(rpm)
	current.park.Text = if model:GetAttribute("AXZF_parkState") == "Stopping" then "Duruyor" else "Parkta"
	current.park.Visible = parked
	current.handbrake.Visible = handbrake
	self.root.Recovery.Visible = recovering

	if self.mobile then
		local held = {Park = parked, Handbrake = handbrake, HideControls = self.help}
		for _, id in pairs(self.pressed) do held[id] = true end
		for id, button in pairs(self.touch) do setPressed(button, held[id] == true) end
	else
		setPressed(self.desktopHelp, self.help)
	end
	local reduced = GuiService.ReducedMotionEnabled
	for i, tick in ipairs(current.ticks) do
		local opacity = if (i - 1) / (#current.ticks - 1) &lt;= rpm / redline then 0 else .74
		tick.BackgroundColor3 = WHITE
		tick.BackgroundTransparency = if reduced then opacity
			else tick.BackgroundTransparency + (opacity - tick.BackgroundTransparency) * .38
	end
end

function Cockpit:destroy()
	if self.preload and coroutine.status(self.preload) ~= "dead" then task.cancel(self.preload) end
	if self.introTween then self.introTween:Cancel() end
	if self.helpTween then self.helpTween:Cancel() end
	for _, connection in ipairs(self.connections) do connection:Disconnect() end
	self.gui:Destroy()
end

return Cockpit
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="AXZF33">

        <Item class="ModuleScript" referent="AXZF40">
          <Properties>
            <string name="Name">VehicleRecipes</string>
            <ProtectedString name="Source">-- Generated from vfx/vehicle/recipes.py; edit recipe source, then regenerate.
return [==[{
  "AXZFTyreSmoke": [
    {
      "op": "create",
      "className": "Attachment",
      "id": "contact",
      "name": "Contact",
      "parent": "$part"
    },
    {
      "op": "create",
      "className": "ParticleEmitter",
      "name": "SmokeBody",
      "parent": "$contact",
      "properties": {
        "Texture": "rbxassetid://123244819470159",
        "Enabled": false,
        "Rate": 0,
        "Lifetime": [
          0.5,
          0.8
        ],
        "Speed": [
          1.5,
          4
        ],
        "Drag": 5,
        "SpreadAngle": [
          65,
          65
        ],
        "EmissionDirection": "Top",
        "Acceleration": [
          0,
          2,
          0
        ],
        "Rotation": [
          0,
          360
        ],
        "RotSpeed": [
          -40,
          40
        ],
        "Color": [
          0.63,
          0.65,
          0.66
        ],
        "LightEmission": 0,
        "LightInfluence": 1,
        "Size": [
          {
            "time": 0,
            "value": 0.7
          },
          {
            "time": 0.3,
            "value": 2.2
          },
          {
            "time": 1,
            "value": 3.5
          }
        ],
        "Transparency": [
          {
            "time": 0,
            "value": 0.35
          },
          {
            "time": 0.4,
            "value": 0.6
          },
          {
            "time": 1,
            "value": 1
          }
        ]
      },
      "attributes": {
        "EmitCount": 4,
        "EmitDelay": 0
      }
    },
    {
      "op": "create",
      "className": "ParticleEmitter",
      "name": "SecondaryBillow",
      "parent": "$contact",
      "properties": {
        "Texture": "rbxassetid://123244819470159",

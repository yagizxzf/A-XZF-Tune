return [==[{"c":"Frame","n":"Recovery","x":0,"y":0,"w":0,"h":0,"sw":1,"sh":1,"k":[{"c":"Frame","n":"Recovery","x":0.0,"y":8,"sx":0.5,"sy":0,"ax":0.5,"ay":0,"w":226,"h":32,"k":[{"c":"Frame","n":"RecoveryPanel","w":226,"h":32,"bg":[8,10,12],"bt":0.26,"corner":{"o":9},"stroke":{"t":1,"c":[255,255,255],"tr":0.66,"pos":"Inner","mode":"Border"},"k":[{"c":"Frame","n":"RecoveryTextSlot","w":210,"h":32,"k":[{"c":"TextLabel","txt":"D\u00fczeltme i\u00e7in alan bekleniyor","font":"Arial","wt":700,"xa":"C","n":"RecoveryText","w":210,"h":13.37,"ts":13.37,"tc":[247,247,247],"x":0,"y":9.32,"attrs":{"FitW":210}}],"x":9,"y":1}],"x":0,"y":0}],"attrs":{"Anchor":"T"}}],"visible":false,"attrs":{"Dim":0}}]==]

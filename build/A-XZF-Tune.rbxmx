          <Item class="ModuleScript" referent="AXZF3">
            <Properties>
              <string name="Name">InputGuard</string>
              <ProtectedString name="Source">--!strict
local Math=require(script.Parent.Math)
local Guard={}
local fields={seq=true,throttle=true,steer=true,brake=true,handbrake=true}
function Guard.validate(packet: any, lastSequence: number): boolean
	if type(packet)~="table" then return false end
	for key in pairs(packet) do if not fields[key] then return false end end
	if not Math.finite(packet.seq) or packet.seq%1~=0 or packet.seq&lt;=lastSequence or packet.seq&gt;2^31-1 then return false end
	for _,key in ipairs({"throttle","steer","brake"}) do
		local v=packet[key]
		if not Math.finite(v) or v &gt; 1 or v &lt; (if key=="brake" then 0 else -1) then return false end
	end
	return type(packet.handbrake)=="boolean"
end
function Guard.consume(bucket: any, now: number): boolean
	bucket.tokens=math.min(45,bucket.tokens+math.max(0,now-bucket.time)*30)
	bucket.time=now
	if bucket.tokens&lt;1 then return false end
	bucket.tokens-=1
	return true
end
return table.freeze(Guard)
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="AXZF4">
            <Properties>
              <string name="Name">Math</string>
              <ProtectedString name="Source">--!strict
local M = {}
function M.finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end
function M.approach(current: number, target: number, rate: number, dt: number): number
	return target + (current - target) * math.exp(-rate * dt)
end
function M.curve(points: {{number}}, x: number): number
	if x &lt;= points[1][1] then return points[1][2] end
	for i = 2, #points do
		local a, b = points[i-1], points[i]
		if x &lt;= b[1] then return a[2] + (b[2]-a[2])*(x-a[1])/(b[1]-a[1]) end
	end
	return points[#points][2]
end
-- Returns longitudinal and lateral demand inside a friction circle.
function M.friction(longitudinal: number, lateral: number, capacity: number): (number, number)
	local magnitude = math.sqrt(longitudinal*longitudinal + lateral*lateral)
	local scale = if magnitude &gt; capacity and magnitude &gt; 0 then capacity/magnitude else 1
	return longitudinal*scale, lateral*scale
end
function M.spring(mass: number, gravity: number, frequency: number, damping: number, compression: number, velocity: number, maxLoad: number): number
	local omega = 2*math.pi*frequency
	return math.clamp(mass*omega*omega*compression - 2*damping*mass*omega*velocity, 0, mass*gravity*maxLoad)
end
function M.braking(speed: number, demand: number, mass: number, dt: number): number
	return -math.sign(speed)*math.min(demand, math.abs(speed)*mass/math.max(dt, 1e-4))
end
-- Positive command turns right; left is then the outer front wheel.
function M.ackermann(angle: number, wheelbase: number, track: number): (number, number)
	if math.abs(angle) &lt; 1e-5 then return 0, 0 end
	local radius = wheelbase/math.tan(math.abs(angle))
	local inner = math.atan(wheelbase/math.max(0.1, radius-track/2))
	local outer = math.atan(wheelbase/(radius+track/2))
	if angle &gt; 0 then return outer, inner end
	return -inner, -outer
end
return table.freeze(M)
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="AXZF5">
            <Properties>
              <string name="Name">Powertrain</string>
              <ProtectedString name="Source">--!strict
local Math=require(script.Parent.Math)
local Powertrain={}
Powertrain.__index=Powertrain
function Powertrain.new(tune: any): any
	return setmetatable({tune=tune,gear=1,rpm=tune.IdleRPM,cooldown=0,direction=1},Powertrain)
end
function Powertrain:step(speed: number, throttle: number, dt: number): (number, number)
	local t=self.tune
	self.cooldown=math.max(0,self.cooldown-dt)
	local direction=if throttle&lt;0 then -1 else 1
	if math.abs(throttle)&gt;0.01 and speed*direction &lt; -2 then return 0,math.abs(throttle) end
	if math.abs(throttle)&gt;0.01 and direction~=self.direction then self.direction=direction self.gear=1 end
	local ratio=if self.direction&lt;0 then t.ReverseRatio else t.Gears[self.gear]
	local wheelRPM=math.abs(speed)/t.Radius*60/(2*math.pi)
	self.rpm=math.clamp(wheelRPM*ratio*t.FinalDrive,t.IdleRPM,t.RedlineRPM)
	if self.direction&gt;0 and self.cooldown==0 then
		if self.rpm&gt;t.ShiftUpRPM and self.gear&lt;#t.Gears then self.gear+=1 self.cooldown=t.ShiftTime
		elseif self.rpm&lt;t.ShiftDownRPM and self.gear&gt;1 then self.gear-=1 self.cooldown=t.ShiftTime end
	end
	ratio=if self.direction&lt;0 then t.ReverseRatio else t.Gears[self.gear]
	self.rpm=math.clamp(wheelRPM*ratio*t.FinalDrive,t.IdleRPM,t.RedlineRPM)
	local cut=if self.rpm&gt;=t.RedlineRPM then 0 else 1
	local shift=if self.cooldown&gt;0 then 0.35 else 1
	return self.direction*math.abs(throttle)*Math.curve(t.TorqueCurve,self.rpm)*t.TorqueScale*ratio*t.FinalDrive/t.Radius*cut*shift,0
end
return Powertrain
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="AXZF6">

--!strict
-- Studio Client diagnostic; seat a driver in AXZF_Prototype first.
assert(game:GetService("RunService"):IsStudio() and game:GetService("RunService"):IsClient(),"Studio Client only")
local g=game.Players.LocalPlayer.PlayerGui.AXZFCockpit local r={enabled=g.Enabled,mobile=g.Root.Mobile.Visible,viewport=tostring(g.AbsoluteSize),buttons={},unloaded={},overlap={}} local rects={} for _,v in ipairs(g.Root.Mobile:GetDescendants()) do if v:IsA("TextButton") then local p,s=v.AbsolutePosition,v.AbsoluteSize table.insert(r.buttons,{name=v.Name,x=p.X,y=p.Y,w=s.X,h=s.Y}) rects[v.Name]={x=p.X,y=p.Y,w=s.X,h=s.Y} elseif v:IsA("ImageLabel") and not v.IsLoaded then table.insert(r.unloaded,{name=v.Name,image=v.Image}) end end local d=g.Root.Mobile.DashboardMobile local p,s=d.AbsolutePosition,d.AbsoluteSize rects.Dashboard={x=p.X,y=p.Y,w=s.X,h=s.Y} local panel=g.Root.HUD.Controls if panel.Visible then local p,s=panel.AbsolutePosition,panel.AbsoluteSize rects.Help={x=p.X,y=p.Y,w=s.X,h=s.Y} end for a,x in pairs(rects) do for b,y in pairs(rects) do if a<b and math.min(x.x+x.w,y.x+y.w)-math.max(x.x,y.x)>1 and math.min(x.y+x.h,y.y+y.h)-math.max(x.y,y.y)>1 then table.insert(r.overlap,a.."/"..b) end end end r.guiCount=0 for _,v in ipairs(g.Parent:GetChildren()) do if v.Name=="AXZFCockpit" then r.guiCount+=1 end end local gear=g.Root.Mobile.DashboardMobile:FindFirstChild("Gear",true) r.gear=gear:FindFirstChildWhichIsA("TextLabel",true).Text r.park=workspace.AXZF_Prototype:GetAttribute("AXZF_parkRequested") return game:GetService("HttpService"):JSONEncode(r)

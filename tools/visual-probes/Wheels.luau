--!strict
-- Studio Client diagnostic; seat a moving driver in AXZF_Prototype first.
assert(game:GetService("RunService"):IsStudio() and game:GetService("RunService"):IsClient(),"Studio Client only")
local R=game:GetService("RunService") local m=workspace.AXZF_Prototype local root=m.Chassis local motor=root.AXZF_FL local axis=motor:GetAttribute("AXZF_RollAxis") local radius=motor:GetAttribute("AXZF_Radius") local previous=motor.Transform local previousDt,expectedPrevious=nil,nil local r={samples=0,meanSpeed=0,meanOmega=0,maxOmegaError=0,maxJointError=0} for i=1,50 do local dt=R.PreSimulation:Wait() local current=motor.Transform local a,angle=previous:ToObjectSpace(current):ToAxisAngle() local forward=(root.CFrame*motor.C0):VectorToWorldSpace(motor:GetAttribute("AXZF_ForwardAxis")) local speed=root:GetVelocityAtPosition(motor.Part1.Position):Dot(forward) if previousDt then local observed=a:Dot(axis)*angle/previousDt r.samples+=1 r.meanSpeed+=speed r.meanOmega+=observed r.maxOmegaError=math.max(r.maxOmegaError,math.abs(observed-expectedPrevious)) end expectedPrevious=-speed/radius previousDt=dt previous=current R.PostSimulation:Wait() local target=root.CFrame*motor.C0*motor.Transform*motor.C1:Inverse() local _,errorAngle=target:ToObjectSpace(motor.Part1.CFrame):ToAxisAngle() r.maxJointError=math.max(r.maxJointError,errorAngle) end r.meanSpeed/=r.samples r.meanOmega/=r.samples r.gear=m:GetAttribute("AXZF_gear") r.engineRPM=m:GetAttribute("AXZF_rpm") r.wheelRPM=math.abs(r.meanOmega)*60/(2*math.pi) r.radius=radius r.pass=r.maxOmegaError<.1 and r.maxJointError<.01 and r.meanOmega*r.meanSpeed<0 return game:GetService("HttpService"):JSONEncode(r)
